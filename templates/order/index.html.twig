{% extends 'base_dashboard.html.twig' %}

{% block title %}Orders Management — VeraBelle Collection{% endblock %}
{% block page_title %}Orders{% endblock %}

{% block content %}
<style>
    :root {
        --blush:#F0C4C4; --sage:#A8BCA1; --sage-deep:#7A9972;
        --ink:#1A1F2E; --ink-soft:#4A5568; --cream:#FAF8F5;
        --cream-warm:#F4F0EA; --gold:#C9A96E; --white:#FFFFFF;
        --border:rgba(26,31,46,0.08); --shadow-sm:0 2px 12px rgba(26,31,46,0.06);
        --shadow-md:0 8px 32px rgba(26,31,46,0.10); --radius:16px; --radius-sm:10px;
    }
    * { font-family:'Figtree',sans-serif; box-sizing:border-box; }
    @keyframes fadeUp { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:translateY(0)} }

    /* Header */
    .page-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; flex-wrap:wrap; gap:12px; animation:fadeUp 0.4s ease both; }
    .page-eyebrow { font-size:10px; letter-spacing:0.2em; text-transform:uppercase; color:var(--gold); font-weight:600; margin-bottom:4px; }
    .page-title { font-family:'Nunito',sans-serif; font-size:26px; font-weight:800; color:var(--ink); line-height:1; }
    .page-sub { font-size:13px; color:var(--ink-soft); margin-top:2px; }
    .header-actions { display:flex; gap:10px; flex-wrap:wrap; }

    .btn-primary { display:inline-flex; align-items:center; gap:8px; padding:11px 22px; background:var(--ink); color:#fff; border-radius:40px; text-decoration:none; font-size:13.5px; font-weight:600; transition:all 0.22s; box-shadow:0 4px 16px rgba(26,31,46,0.18); }
    .btn-primary:hover { background:var(--ink-soft); transform:translateY(-2px); color:#fff; }
    .btn-primary-icon { width:22px; height:22px; background:linear-gradient(135deg,var(--blush),var(--sage)); border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .btn-secondary { display:inline-flex; align-items:center; gap:8px; padding:11px 20px; background:var(--cream); color:var(--ink-soft); border-radius:40px; text-decoration:none; font-size:13px; font-weight:600; transition:all 0.22s; border:1px solid var(--border); }
    .btn-secondary:hover { background:var(--cream-warm); color:var(--ink); transform:translateY(-2px); }

    /* Stats */
    .stats-strip { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-bottom:24px; animation:fadeUp 0.4s 0.08s ease both; }
    .strip-card { background:var(--white); border-radius:var(--radius-sm); padding:20px; border:1px solid var(--border); display:flex; align-items:center; gap:14px; transition:all 0.2s; position:relative; overflow:hidden; }
    .strip-card::after { content:''; position:absolute; bottom:0; left:0; right:0; height:3px; opacity:0; transition:opacity 0.2s; }
    .strip-card:hover { box-shadow:var(--shadow-sm); transform:translateY(-2px); }
    .strip-card:hover::after { opacity:1; }
    .sc-total::after  { background:linear-gradient(90deg,var(--blush),#e8a8a8); }
    .sc-pending::after { background:linear-gradient(90deg,#f39c12,#e67e22); }
    .sc-done::after   { background:linear-gradient(90deg,var(--sage),var(--sage-deep)); }
    .strip-icon { width:44px; height:44px; border-radius:12px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .si-blush { background:rgba(240,196,196,0.18); }
    .si-gold  { background:rgba(243,156,18,0.15); }
    .si-sage  { background:rgba(168,188,161,0.18); }
    .strip-val { font-family:'Nunito',sans-serif; font-size:26px; font-weight:800; color:var(--ink); line-height:1; }
    .strip-lbl { font-size:11.5px; color:var(--ink-soft); margin-top:2px; }

    /* Grid section */
    .orders-section { background:var(--white); border-radius:var(--radius); border:1px solid var(--border); padding:24px; animation:fadeUp 0.4s 0.16s ease both; }
    .section-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; padding-bottom:16px; border-bottom:1px solid var(--border); }
    .section-title { font-family:'Nunito',sans-serif; font-size:15px; font-weight:800; color:var(--ink); }
    .section-count { background:var(--cream); border-radius:12px; padding:4px 12px; font-size:12px; font-weight:700; color:var(--ink-soft); }

    .orders-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:18px; }

    /* Order card */
    .order-card { border:1px solid var(--border); border-radius:var(--radius-sm); background:var(--white); overflow:hidden; display:flex; flex-direction:column; transition:all 0.22s; }
    .order-card:hover { transform:translateY(-4px); box-shadow:var(--shadow-md); border-color:rgba(240,196,196,0.3); }
    .card-top-bar { height:4px; background:linear-gradient(90deg,var(--blush),var(--sage)); }

    .card-header { padding:16px 18px 12px; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:flex-start; gap:10px; }
    .order-id { font-family:'Nunito',sans-serif; font-size:12px; font-weight:700; color:var(--ink-soft); margin-bottom:3px; }
    .customer-name { font-weight:700; color:var(--ink); font-size:14px; }

    .status-badge { display:inline-flex; align-items:center; padding:4px 10px; border-radius:20px; font-size:11px; font-weight:700; text-transform:capitalize; white-space:nowrap; }
    .order-pending    { background:rgba(243,156,18,0.12); color:#d68910; border:1px solid rgba(243,156,18,0.25); }
    .order-completed  { background:rgba(122,153,114,0.12); color:var(--sage-deep); border:1px solid rgba(122,153,114,0.22); }
    .order-processing { background:rgba(139,168,212,0.12); color:#4a7ab5; border:1px solid rgba(139,168,212,0.22); }
    .order-cancelled  { background:rgba(231,76,60,0.08); color:#c0392b; border:1px solid rgba(231,76,60,0.18); }
    .order-new        { background:rgba(196,168,224,0.12); color:#7a4ab5; border:1px solid rgba(196,168,224,0.22); }
    .payment-paid     { background:rgba(122,153,114,0.12); color:var(--sage-deep); border:1px solid rgba(122,153,114,0.22); }
    .payment-pending  { background:rgba(243,156,18,0.12); color:#d68910; border:1px solid rgba(243,156,18,0.25); }
    .payment-failed   { background:rgba(231,76,60,0.08); color:#c0392b; border:1px solid rgba(231,76,60,0.18); }

    .card-body { padding:14px 18px; display:flex; flex-direction:column; gap:10px; flex:1; }
    .meta-row { display:flex; justify-content:space-between; align-items:center; font-size:12.5px; }
    .meta-label { color:var(--ink-soft); font-weight:500; }
    .meta-value { font-weight:600; color:var(--ink); }
    .amount-value { font-family:'Nunito',sans-serif; font-size:15px; font-weight:800; color:var(--sage-deep); }

    .card-actions { display:flex; gap:6px; padding:12px 18px 16px; border-top:1px solid var(--border); flex-wrap:wrap; }
    .btn-action { flex:1; min-width:60px; padding:8px 10px; border-radius:8px; font-size:12px; font-weight:600; cursor:pointer; transition:all 0.18s; text-decoration:none; display:inline-flex; align-items:center; justify-content:center; gap:4px; border:1px solid transparent; font-family:'Figtree',sans-serif; }
    .btn-view   { background:var(--cream); color:var(--ink-soft); border-color:var(--border); }
    .btn-view:hover   { background:var(--cream-warm); color:var(--ink); }
    .btn-edit   { background:rgba(168,188,161,0.14); color:var(--sage-deep); border-color:rgba(168,188,161,0.25); }
    .btn-edit:hover   { background:var(--sage); color:#fff; border-color:var(--sage); }
    .btn-delete { background:rgba(231,76,60,0.07); color:#c0392b; border-color:rgba(231,76,60,0.18); }
    .btn-delete:hover { background:#e74c3c; color:#fff; border-color:#e74c3c; }
    .btn-disabled { background:rgba(200,200,200,0.12); color:#bbb; border-color:rgba(200,200,200,0.2); cursor:not-allowed; opacity:0.6; pointer-events:none; }

    .empty-state { grid-column:1/-1; display:flex; flex-direction:column; align-items:center; padding:80px 20px; text-align:center; gap:10px; }
    .empty-icon-wrap { width:64px; height:64px; background:var(--cream-warm); border-radius:20px; display:flex; align-items:center; justify-content:center; margin-bottom:4px; }
    .empty-state h3 { font-family:'Nunito',sans-serif; font-size:17px; font-weight:800; color:var(--ink); }
    .empty-state p { font-size:13px; color:var(--ink-soft); }

    @media (max-width:900px) { .stats-strip { grid-template-columns:1fr; } }
    @media (max-width:600px) { .orders-grid { grid-template-columns:1fr; } .page-header { flex-direction:column; align-items:flex-start; } }
</style>

<!-- Header -->
<div class="page-header">
    <div>
        <div class="page-eyebrow">Store</div>
        <div class="page-title">Orders Management</div>
        <div class="page-sub">Track and manage all customer orders</div>
    </div>
    <div class="header-actions">
        <a href="{{ path('app_shop') }}" class="btn-secondary">
            <i data-lucide="shopping-bag" style="width:14px;height:14px;stroke:currentColor;stroke-width:2;"></i>
            Shop
        </a>
        <a href="{{ path('app_order_new') }}" class="btn-primary">
            <span class="btn-primary-icon"><i data-lucide="plus" style="width:13px;height:13px;stroke:white;stroke-width:2.5;"></i></span>
            New Order
        </a>
    </div>
</div>

<!-- Stats -->
<div class="stats-strip">
    <div class="strip-card sc-total">
        <div class="strip-icon si-blush"><i data-lucide="shopping-cart" style="width:20px;height:20px;stroke:#e8a8a8;stroke-width:1.75;"></i></div>
        <div><div class="strip-val">{{ stats.total }}</div><div class="strip-lbl">Total Orders</div></div>
    </div>
    <div class="strip-card sc-pending">
        <div class="strip-icon si-gold"><i data-lucide="clock" style="width:20px;height:20px;stroke:#d68910;stroke-width:1.75;"></i></div>
        <div><div class="strip-val">{{ stats.pending }}</div><div class="strip-lbl">Pending</div></div>
    </div>
    <div class="strip-card sc-done">
        <div class="strip-icon si-sage"><i data-lucide="check-circle" style="width:20px;height:20px;stroke:var(--sage-deep);stroke-width:1.75;"></i></div>
        <div><div class="strip-val">{{ stats.completed }}</div><div class="strip-lbl">Completed</div></div>
    </div>
</div>

<!-- Orders -->
<div class="orders-section">
    <div class="section-header">
        <span class="section-title">All Orders</span>
        <span class="section-count">{{ orders|length }} orders</span>
    </div>
    <div class="orders-grid">
        {% for order in orders %}
        {% set isAdmin = is_granted('ROLE_ADMIN') %}
        {% set isCreator = order.createdBy and app.user and order.createdBy.id == app.user.id %}
        {% set isCompleted = order.orderStatus|lower == 'completed' %}
        {% set isCancelled = order.orderStatus|lower == 'cancelled' %}
        {% set canEdit = (isAdmin or isCreator) and not isCompleted and not isCancelled %}
        {% set canDelete = (isAdmin or isCreator) and not isCompleted %}

        <div class="order-card">
            <div class="card-top-bar"></div>
            <div class="card-header">
                <div>
                    <div class="order-id">#{{ order.id }}</div>
                    <div class="customer-name">{{ order.customerName }}</div>
                </div>
                <span class="status-badge order-{{ order.orderStatus|lower }}">{{ order.orderStatus }}</span>
            </div>
            <div class="card-body">
                <div class="meta-row">
                    <span class="meta-label">Date</span>
                    <span class="meta-value" style="font-size:12px;">{{ order.orderDate|date('M d, Y · H:i') }}</span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Total</span>
                    <span class="amount-value">₱{{ order.totalAmount|number_format(2) }}</span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Payment</span>
                    <span class="status-badge payment-{{ order.paymentStatus|lower }}">{{ order.paymentStatus }}</span>
                </div>
                {% if order.paymentMethod %}
                <div class="meta-row">
                    <span class="meta-label">Method</span>
                    <span class="meta-value" style="font-size:12px;text-transform:capitalize;">{{ order.paymentMethod|replace({'_':' '}) }}</span>
                </div>
                {% endif %}
            </div>
            <div class="card-actions">
                <a href="{{ path('app_order_show', {'id': order.id}) }}" class="btn-action btn-view">
                    <i data-lucide="eye" style="width:12px;height:12px;stroke:currentColor;stroke-width:2;"></i> View
                </a>
                {% if canEdit %}
                    <a href="{{ path('app_order_edit', {'id': order.id}) }}" class="btn-action btn-edit">
                        <i data-lucide="pencil" style="width:12px;height:12px;stroke:currentColor;stroke-width:2;"></i> Edit
                    </a>
                {% else %}
                    <span class="btn-action btn-disabled">Edit</span>
                {% endif %}
                {% if canDelete %}
                    <form method="post" action="{{ path('app_order_delete', {'id': order.id}) }}" style="flex:1;" onsubmit="return confirm('Delete order #{{ order.id }}?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ order.id) }}">
                        <button type="submit" class="btn-action btn-delete" style="width:100%;">
                            <i data-lucide="trash-2" style="width:12px;height:12px;stroke:currentColor;stroke-width:2;"></i> Delete
                        </button>
                    </form>
                {% else %}
                    <span class="btn-action btn-disabled" style="flex:1;">Delete</span>
                {% endif %}
            </div>
        </div>
        {% else %}
        <div class="empty-state">
            <div class="empty-icon-wrap"><i data-lucide="shopping-cart" style="width:28px;height:28px;stroke:var(--ink-soft);stroke-width:1.5;"></i></div>
            <h3>No Orders Found</h3>
            <p>New orders will appear here once created.</p>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
