{% extends 'base_dashboard.html.twig' %}

{% block title %}Order #{{ order.id }} — VeraBelle Collection{% endblock %}
{% block page_title %}Order Details{% endblock %}

{% block content %}
<style>
    :root {
        --mauve:#C4A0A0; --deep-mauve:#9E6F6F; --sage:#8FAF8C; --deep-sage:#5C7A5A;
        --charcoal:#3A3232; --warm-gray:#7A6F6F; --ivory:#F9F4EE; --parchment:#EFE6D8;
        --gold:#C9A96E; --white:#FFFFFF;
        --border:rgba(58,50,50,0.08); --shadow-sm:0 2px 12px rgba(58,50,50,0.06);
        --shadow-md:0 8px 32px rgba(58,50,50,0.10); --r:16px; --r-sm:10px;
    }
    * { font-family:'Figtree',sans-serif; box-sizing:border-box; }

    .ow { max-width:1400px; margin:0 auto; }

    /* Hero */
    .order-hero {
        background:linear-gradient(135deg,#2A2020,var(--charcoal));
        border-radius:var(--r); padding:36px 44px; margin-bottom:24px;
        display:flex; align-items:center; justify-content:space-between;
        position:relative; overflow:hidden; border:1px solid rgba(196,160,160,0.1);
    }
    .order-hero::before { content:''; position:absolute; top:-60px; right:60px; width:260px; height:260px; background:radial-gradient(circle,rgba(196,160,160,0.12) 0%,transparent 65%); pointer-events:none; }
    .oh-left { position:relative; z-index:1; }
    .oh-eyebrow { font-size:10px; font-weight:700; letter-spacing:4px; text-transform:uppercase; color:var(--gold); margin-bottom:10px; display:flex; align-items:center; gap:8px; }
    .oh-eyebrow::before { content:''; display:block; width:20px; height:1px; background:var(--gold); }
    .oh-id { font-family:'Nunito',sans-serif; font-size:32px; font-weight:800; color:white; margin-bottom:8px; }
    .oh-id em { font-style:italic; color:var(--mauve); }
    .oh-date { font-size:13px; color:rgba(255,255,255,0.4); font-weight:300; }
    .oh-badges { display:flex; gap:8px; margin-top:14px; flex-wrap:wrap; }
    .oh-right { position:relative; z-index:1; text-align:right; }
    .oh-amount { font-family:'Nunito',sans-serif; font-size:44px; font-weight:800; color:white; line-height:1; }
    .oh-amount-lbl { font-size:10px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:rgba(255,255,255,0.3); margin-top:4px; }

    /* Status badges */
    .sbadge { display:inline-flex; align-items:center; gap:5px; padding:5px 12px; border-radius:20px; font-size:11px; font-weight:700; text-transform:capitalize; }
    .sbadge::before { content:''; width:5px; height:5px; border-radius:50%; background:currentColor; opacity:0.7; }
    .s-pending    { background:rgba(196,160,160,0.15); color:var(--deep-mauve); border:1px solid rgba(196,160,160,0.25); }
    .s-processing { background:rgba(143,175,140,0.12); color:var(--deep-sage); border:1px solid rgba(143,175,140,0.22); }
    .s-completed  { background:rgba(92,122,90,0.12); color:var(--deep-sage); border:1px solid rgba(92,122,90,0.22); }
    .s-cancelled  { background:rgba(180,80,80,0.08); color:#b05050; border:1px solid rgba(180,80,80,0.18); }
    .s-paid       { background:rgba(92,122,90,0.12); color:var(--deep-sage); border:1px solid rgba(92,122,90,0.22); }
    .s-failed     { background:rgba(180,80,80,0.08); color:#b05050; border:1px solid rgba(180,80,80,0.18); }
    .s-new        { background:rgba(196,160,160,0.12); color:var(--deep-mauve); border:1px solid rgba(196,160,160,0.22); }

    /* Grid */
    .detail-grid { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:20px; }

    /* Info panels */
    .ip { background:var(--white); border-radius:var(--r); border:1px solid var(--border); overflow:hidden; box-shadow:var(--shadow-sm); }
    .ip-head { padding:18px 24px 14px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:10px; }
    .ip-icon { width:34px; height:34px; border-radius:9px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .ip-title { font-family:'Nunito',sans-serif; font-size:15px; font-weight:800; color:var(--charcoal); }
    .ip-body { padding:20px 24px; display:flex; flex-direction:column; gap:13px; }
    .ip-row { display:flex; justify-content:space-between; align-items:flex-start; font-size:13px; gap:16px; }
    .ip-lbl { color:var(--warm-gray); font-weight:500; flex-shrink:0; }
    .ip-val { font-weight:600; color:var(--charcoal); text-align:right; }
    .ip-val.green { color:var(--deep-sage); }
    .ip-val.large { font-family:'Nunito',sans-serif; font-size:20px; font-weight:800; color:var(--deep-sage); }
    .ip-val.addr { font-size:12px; line-height:1.7; text-align:right; }

    /* Actions */
    .actions-row { display:flex; gap:12px; flex-wrap:wrap; }
    .btn-edit { display:inline-flex; align-items:center; gap:7px; padding:11px 24px; background:linear-gradient(135deg,var(--mauve),var(--deep-mauve)); color:white; border-radius:8px; font-size:12px; font-weight:700; letter-spacing:0.5px; text-transform:uppercase; text-decoration:none; transition:all 0.2s; }
    .btn-edit:hover { opacity:0.9; transform:translateY(-1px); }
    .btn-back { display:inline-flex; align-items:center; gap:7px; padding:11px 20px; background:var(--ivory); color:var(--warm-gray); border:1px solid var(--border); border-radius:8px; font-size:12px; font-weight:600; text-decoration:none; transition:all 0.2s; }
    .btn-back:hover { background:var(--parchment); color:var(--charcoal); }

    @media (max-width:900px) { .detail-grid { grid-template-columns:1fr; } .order-hero { flex-direction:column; gap:16px; padding:28px 24px; } .oh-right { text-align:left; } }
</style>

<div class="ow">
    <!-- Hero -->
    <div class="order-hero">
        <div class="oh-left">
            <div class="oh-eyebrow">Order Details</div>
            <div class="oh-id">Order <em>#{{ order.id }}</em></div>
            <div class="oh-date">{{ order.orderDate|date('F d, Y \a\t g:i A') }}</div>
            <div class="oh-badges">
                <span class="sbadge s-{{ order.orderStatus|lower }}">{{ order.orderStatus }}</span>
                <span class="sbadge s-{{ order.paymentStatus|lower }}">{{ order.paymentStatus }}</span>
                {% if order.paymentMethod %}
                    <span class="sbadge s-new">{{ order.paymentMethod|replace({'_':' '})|capitalize }}</span>
                {% endif %}
            </div>
        </div>
        <div class="oh-right">
            <div class="oh-amount">₱{{ order.totalAmount|number_format(2) }}</div>
            <div class="oh-amount-lbl">Total Amount</div>
        </div>
    </div>

    <!-- Info Grid -->
    <div class="detail-grid">
        <!-- Customer -->
        <div class="ip">
            <div class="ip-head">
                <div class="ip-icon" style="background:rgba(196,160,160,0.15);">
                    <i data-lucide="user" style="width:15px;height:15px;stroke:var(--deep-mauve);stroke-width:1.75;"></i>
                </div>
                <span class="ip-title">Customer Information</span>
            </div>
            <div class="ip-body">
                <div class="ip-row"><span class="ip-lbl">Name</span><span class="ip-val">{{ order.customerName }}</span></div>
                {% if order.customerEmail %}
                <div class="ip-row"><span class="ip-lbl">Email</span><span class="ip-val" style="font-size:12px;">{{ order.customerEmail }}</span></div>
                {% endif %}
                {% if order.customerPhone %}
                <div class="ip-row"><span class="ip-lbl">Phone</span><span class="ip-val">{{ order.customerPhone }}</span></div>
                {% endif %}
                {% if order.shippingAddress %}
                <div class="ip-row" style="align-items:flex-start;">
                    <span class="ip-lbl">Address</span>
                    <span class="ip-val addr">{{ order.shippingAddress }}</span>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Order Info -->
        <div class="ip">
            <div class="ip-head">
                <div class="ip-icon" style="background:rgba(143,175,140,0.15);">
                    <i data-lucide="shopping-cart" style="width:15px;height:15px;stroke:var(--deep-sage);stroke-width:1.75;"></i>
                </div>
                <span class="ip-title">Order Information</span>
            </div>
            <div class="ip-body">
                <div class="ip-row"><span class="ip-lbl">Order ID</span><span class="ip-val">#{{ order.id }}</span></div>
                <div class="ip-row"><span class="ip-lbl">Date</span><span class="ip-val">{{ order.orderDate|date('M d, Y · H:i') }}</span></div>
                <div class="ip-row"><span class="ip-lbl">Total</span><span class="ip-val large">₱{{ order.totalAmount|number_format(2) }}</span></div>
                <div class="ip-row">
                    <span class="ip-lbl">Order Status</span>
                    <span class="sbadge s-{{ order.orderStatus|lower }}">{{ order.orderStatus }}</span>
                </div>
                <div class="ip-row">
                    <span class="ip-lbl">Payment</span>
                    <span class="sbadge s-{{ order.paymentStatus|lower }}">{{ order.paymentStatus }}</span>
                </div>
                {% if order.paymentMethod %}
                <div class="ip-row"><span class="ip-lbl">Method</span><span class="ip-val">{{ order.paymentMethod|replace({'_':' '})|capitalize }}</span></div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="actions-row">
        <a href="{{ path('app_order_edit', {'id': order.id}) }}" class="btn-edit">
            <i data-lucide="pencil" style="width:13px;height:13px;stroke:white;stroke-width:2;"></i>
            Edit Order
        </a>
    </div>
</div>
{% endblock %}
