{% extends 'base_dashboard.html.twig' %}

{% block title %}View Stock Details - VeraBelle Collection{% endblock %}
{% block page_title %}Stock Details{% endblock %}

{% block content %}
<style>
    .details-container {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        padding: 40px;
        max-width: 700px;
        margin: 40px auto;
        position: relative;
    }

    .details-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid #f0f0f0;
        padding-bottom: 15px;
        margin-bottom: 25px;
    }

    .details-title {
        font-size: 26px;
        font-weight: 600;
        color: #2c3e50;
        position: relative;
        padding-left: 15px;
    }

    .details-title::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 5px;
        height: 28px;
        background: linear-gradient(180deg, #F4C2C2, #A8BCA1);
        border-radius: 3px;
    }

    .back-btn {
        text-decoration: none;
        background: linear-gradient(135deg, #F4C2C2, #A8BCA1);
        color: #fff;
        padding: 10px 18px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .back-btn:hover {
        opacity: 0.9;
        transform: translateY(-2px);
    }

    .details-section {
        margin-bottom: 20px;
    }

    .details-label {
        font-weight: 600;
        color: #34495e;
        margin-bottom: 6px;
        font-size: 15px;
    }

    .details-value {
        background: #fafafa;
        border-radius: 8px;
        padding: 12px 16px;
        color: #2c3e50;
        font-size: 15px;
        box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.05);
    }

    .type-badge {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 500;
    }

    .type-badge.stock-in {
        background: rgba(168, 188, 161, 0.15);
        color: #5a6d54;
        border: 1px solid rgba(168, 188, 161, 0.3);
    }

    .type-badge.stock-out {
        background: rgba(231, 76, 60, 0.1);
        color: #c0392b;
        border: 1px solid rgba(231, 76, 60, 0.2);
    }

    .type-badge.returned {
        background: rgba(244, 194, 194, 0.15);
        color: #c97878;
        border: 1px solid rgba(244, 194, 194, 0.3);
    }

    .action-buttons {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 30px;
    }

    .btn-action {
        padding: 10px 18px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        font-family: 'Poppins', sans-serif;
    }

    .btn-edit {
        background: rgba(244, 194, 194, 0.15);
        color: #c97878;
        border: 1px solid rgba(244, 194, 194, 0.3);
    }

    .btn-edit:hover {
        background: #F4C2C2;
        color: #fff;
        border-color: #F4C2C2;
    }

    .btn-delete {
        background: rgba(231, 76, 60, 0.1);
        color: #c0392b;
        border: 1px solid rgba(231, 76, 60, 0.2);
    }

    .btn-delete:hover {
        background: #c0392b;
        color: #fff;
        border-color: #c0392b;
    }

</style>

<div class="details-container">
    <div class="details-header">
        <div class="details-title">Stock Details</div>
        <a href="{{ path('app_stock_index') }}" class="back-btn">← Back to List</a>
    </div>

    <div class="details-section">
        <div class="details-label">Product</div>
        <div class="details-value">{{ stock.product.name }}</div>
    </div>

    <div class="details-section">
        <div class="details-label">Type</div>
        <div class="details-value">
            {% if stock.type == 'Added' %}
                <span class="type-badge stock-in">Stock In</span>
            {% elseif stock.type == 'Sold' %}
                <span class="type-badge stock-out">Stock Out</span>
            {% elseif stock.type == 'Returned' %}
                <span class="type-badge returned">Returned</span>
            {% endif %}
        </div>
    </div>

    <div class="details-section">
        <div class="details-label">Quantity</div>
        <div class="details-value">{{ stock.quantity }}</div>
    </div>

    <div class="details-section">
        <div class="details-label">Date</div>
        <div class="details-value">{{ stock.createdAt|date('F d, Y - h:i A') }}</div>
    </div>

    <div class="details-section">
        <div class="details-label">Remarks</div>
        <div class="details-value">{{ stock.remarks ?: 'No remarks provided.' }}</div>
    </div>

    <div class="action-buttons">
        <a href="{{ path('app_stock_edit', {'id': stock.id}) }}" class="btn-action btn-edit">Edit</a>
        <form method="post" action="{{ path('app_stock_delete', {'id': stock.id}) }}" 
              onsubmit="return confirm('Are you sure you want to delete this record?');" style="display:inline;">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ stock.id) }}">
            <button class="btn-action btn-delete">Delete</button>
        </form>
    </div>
</div>
{% endblock %}
