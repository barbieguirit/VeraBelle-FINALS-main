<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin Dashboard — VeraBelle Collection{% endblock %}</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,300;0,400;0,600;0,700;0,800;1,400;1,600&family=Figtree:wght@300;400;500;600;700&family=Pacifico&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    <style>
        :root {
            --blush:       #C4A0A0;
            --sage:        #8FAF8C;
            --sage-deep:   #5C7A5A;
            --ink:         #3A3232;
            --ink-mid:     #4A3A3A;
            --ink-soft:    #7A6F6F;
            --cream:       #F9F4EE;
            --cream-warm:  #EFE6D8;
            --gold:        #C9A96E;
            --white:       #FFFFFF;
            --border:      rgba(58,50,50,0.08);
            --border-warm: rgba(196,160,160,0.2);
            --shadow-sm:   0 2px 12px rgba(26,31,46,0.06);
            --shadow-md:   0 8px 32px rgba(26,31,46,0.10);
            --shadow-lg:   0 20px 60px rgba(26,31,46,0.14);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Figtree', sans-serif;
            background: var(--cream);
            color: var(--ink);
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ── SIDEBAR ─────────────────────────────────── */
        .sidebar {
            width: 260px;
            min-width: 260px;
            background: linear-gradient(180deg, #2A2020 0%, var(--ink) 100%);
            display: flex;
            flex-direction: column;
            padding: 0;
            position: fixed;
            height: 100vh;
            left: 0; top: 0;
            z-index: 100;
            overflow: hidden;
            border-right: 1px solid rgba(196,160,160,0.08);
        }

        .sidebar::before {
            content: '';
            position: absolute;
            top: -80px; right: -80px;
            width: 240px; height: 240px;
            background: radial-gradient(circle, rgba(240,196,196,0.12) 0%, transparent 70%);
            pointer-events: none;
        }

        .sidebar-top {
            padding: 36px 28px 28px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            position: relative;
        }

        .brand-mark {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
        }

        .brand-name {
            font-family: 'Pacifico', cursive;
            font-size: 24px;
            font-weight: 400;
            color: var(--white);
            letter-spacing: 0.01em;
            line-height: 1;
        }

        .brand-name .brand-accent {
            font-family: inherit;
            font-weight: inherit;
            color: var(--blush);
        }

        .brand-sub {
            font-size: 9px;
            letter-spacing: 0.28em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.35);
            font-weight: 500;
        }

        .nav {
            flex: 1;
            padding: 20px 0;
            overflow-y: auto;
        }

        .nav::-webkit-scrollbar { width: 0; }

        .nav-section-label {
            font-size: 9px;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.2);
            font-weight: 600;
            padding: 20px 28px 8px;
        }

        .nav a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 28px;
            color: rgba(255,255,255,0.5);
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 400;
            transition: all 0.2s ease;
            position: relative;
        }

        .nav a .nav-icon {
            width: 32px; height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            background: rgba(255,255,255,0.04);
            flex-shrink: 0;
            transition: all 0.2s;
        }

        .nav a .nav-icon i,
        .nav a .nav-icon svg {
            width: 15px; height: 15px;
            stroke: rgba(255,255,255,0.5);
            stroke-width: 1.75;
            transition: stroke 0.2s;
        }

        .nav a:hover .nav-icon svg,
        .nav a.active .nav-icon svg { stroke: white; }

        .nav a:hover {
            color: rgba(255,255,255,0.85);
        }

        .nav a:hover .nav-icon {
            background: rgba(255,255,255,0.08);
        }

        .nav a.active {
            color: #fff;
            background: rgba(196,160,160,0.08);
        }

        .nav a.active .nav-icon {
            background: linear-gradient(135deg, var(--blush), var(--sage));
            color: white;
        }

        .nav a.active::before {
            content: '';
            position: absolute;
            left: 0; top: 50%;
            transform: translateY(-50%);
            width: 3px; height: 20px;
            background: var(--blush);
            border-radius: 0 3px 3px 0;
        }

        .sidebar-footer {
            padding: 20px 28px;
            border-top: 1px solid rgba(255,255,255,0.06);
        }

        .logout-btn {
            display: flex;
            align-items: center;
            gap: 10px;
            color: rgba(255,255,255,0.35);
            font-size: 13px;
            text-decoration: none;
            transition: all 0.2s;
            padding: 10px 14px;
            border-radius: 8px;
        }

        .logout-btn:hover {
            color: rgba(255,255,255,0.8);
            background: rgba(196,160,160,0.1);
        }

        /* ── MAIN ──────────────────────────────────────── */
        .main {
            margin-left: 260px;
            flex: 1;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ── TOPBAR ──────────────────────────────────── */
        .topbar {
            height: 68px;
            background: var(--white);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
            position: sticky;
            top: 0;
            z-index: 50;
            box-shadow: 0 1px 0 var(--border), 0 4px 16px rgba(58,50,50,0.04);
        }

        .topbar-left h1 {
            font-family: 'Nunito', sans-serif;
            font-size: 20px;
            font-weight: 800;
            color: var(--ink);
            letter-spacing: 0.01em;
            position: relative;
            padding-left: 14px;
        }

        .topbar-left h1::before {
            content: '';
            position: absolute;
            left: 0; top: 50%;
            transform: translateY(-50%);
            width: 4px; height: 20px;
            background: linear-gradient(180deg, var(--blush), var(--sage));
            border-radius: 2px;
        }

        .topbar-left .breadcrumb {
            font-size: 11px;
            color: var(--ink-soft);
            letter-spacing: 0.05em;
            text-transform: uppercase;
            margin-top: 1px;
            padding-left: 14px;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .notif-btn {
            width: 36px; height: 36px;
            border-radius: 10px;
            background: var(--cream);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 15px;
            position: relative;
            transition: all 0.2s;
        }

        .notif-btn:hover { background: var(--cream-warm); }

        .notif-wrap { position: relative; }

        .notif-dropdown {
            display: none; position: absolute; top: calc(100% + 10px); right: 0;
            width: 300px; background: white; border-radius: 16px;
            border: 1px solid var(--border); box-shadow: var(--shadow-lg);
            z-index: 200; overflow: hidden;
        }
        .notif-dropdown.open { display: block; }
        .notif-header {
            display: flex; justify-content: space-between; align-items: center;
            padding: 16px 18px 12px; border-bottom: 1px solid var(--border);
            font-size: 13px; font-weight: 700; color: var(--ink);
        }
        .notif-list { max-height: 280px; overflow-y: auto; }
        .notif-item {
            display: flex; align-items: center; gap: 12px;
            padding: 12px 18px; transition: background 0.15s; cursor: default;
        }
        .notif-item:hover { background: var(--cream); }
        .notif-item.unread { background: rgba(240,196,196,0.06); }
        .notif-icon {
            width: 32px; height: 32px; border-radius: 8px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
        }
        .notif-text { font-size: 12.5px; color: var(--ink); font-weight: 500; }
        .notif-time { font-size: 11px; color: var(--ink-soft); margin-top: 2px; }
        .notif-footer {
            display: block; text-align: center; padding: 12px;
            font-size: 12px; font-weight: 600; color: var(--sage-deep);
            text-decoration: none; border-top: 1px solid var(--border);
            transition: background 0.15s;
        }
        .notif-footer:hover { background: var(--cream); }

        .notif-dot {
            position: absolute;
            top: 6px; right: 6px;
            width: 7px; height: 7px;
            background: var(--blush);
            border-radius: 50%;
            border: 1.5px solid white;
        }

        .user-pill {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 3px 8px 3px 5px;
            background: var(--cream);
            border: 1px solid var(--border);
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .user-pill:hover { background: var(--cream-warm); }

        .user-avatar {
            width: 24px;
            height: 24px;
            aspect-ratio: 1;
            background: linear-gradient(135deg, var(--blush), var(--sage));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            font-weight: 600;
            color: white;
            line-height: 1;
            flex-shrink: 0;
        }

        .user-name { font-size: 12px; font-weight: 500; color: var(--ink); }
        .user-role { font-size: 10px; color: var(--ink-soft); margin-top: -1px; }

        /* ── PAGE BODY ──────────────────────────────── */
        .page-body {
            padding: 36px 40px 60px;
            flex: 1;
        }

        /* ── HERO BANNER ───────────────────────────── */
        .hero-banner {
            background: var(--ink);
            border-radius: 20px;
            padding: 40px 48px;
            margin-bottom: 36px;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .hero-banner::before {
            content: '';
            position: absolute;
            top: -60px; right: 120px;
            width: 300px; height: 300px;
            background: radial-gradient(circle, rgba(240,196,196,0.15) 0%, transparent 65%);
            pointer-events: none;
        }

        .hero-banner::after {
            content: '';
            position: absolute;
            bottom: -80px; right: -40px;
            width: 320px; height: 320px;
            background: radial-gradient(circle, rgba(168,188,161,0.12) 0%, transparent 65%);
            pointer-events: none;
        }

        .hero-text { position: relative; z-index: 1; }

        .hero-greeting {
            font-size: 11px;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--gold);
            font-weight: 500;
            margin-bottom: 10px;
        }

        .hero-title {
            font-family: 'Nunito', sans-serif;
            font-size: 36px;
            font-weight: 700;
            color: white;
            line-height: 1.2;
            margin-bottom: 10px;
        }

        .hero-title em {
            font-style: italic;
            color: var(--blush);
        }

        .hero-subtitle {
            font-size: 13.5px;
            color: rgba(255,255,255,0.45);
            font-weight: 300;
        }

        .hero-date {
            position: relative;
            z-index: 1;
            text-align: right;
        }

        .hero-date .date-day {
            font-family: 'Nunito', sans-serif;
            font-size: 72px;
            font-weight: 800;
            color: rgba(255,255,255,0.10);
            line-height: 1;
        }

        .hero-date .date-full {
            font-size: 11px;
            color: rgba(255,255,255,0.3);
            letter-spacing: 0.15em;
            text-transform: uppercase;
        }

        /* ── STATS ROW ──────────────────────────────── */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 16px;
            margin-bottom: 36px;
        }

        .stat-card {
            background: var(--white);
            border-radius: 16px;
            padding: 22px 20px;
            border: 1px solid var(--border);
            position: relative;
            overflow: hidden;
            transition: all 0.25s ease;
        }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
            border-color: transparent;
        }

        .stat-card::after {
            content: '';
            position: absolute;
            bottom: 0; left: 0; right: 0;
            height: 3px;
            opacity: 0;
            transition: opacity 0.25s;
        }

        .stat-card:hover::after { opacity: 1; }

        .stat-card.c1::after { background: linear-gradient(90deg, var(--blush), #b88080); }
        .stat-card.c2::after { background: linear-gradient(90deg, var(--sage), var(--sage-deep)); }
        .stat-card.c3::after { background: linear-gradient(90deg, var(--gold), #b8924a); }
        .stat-card.c4::after { background: linear-gradient(90deg, var(--blush), var(--sage)); }
        .stat-card.c5::after { background: linear-gradient(90deg, var(--sage-deep), #3a5238); }
        .stat-card.c6::after { background: linear-gradient(90deg, var(--gold), var(--blush)); }

        .stat-icon {
            width: 38px; height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
            margin-bottom: 14px;
        }

        .stat-card.c1 .stat-icon { background: rgba(196,160,160,0.18); }
        .stat-card.c2 .stat-icon { background: rgba(143,175,140,0.18); }
        .stat-card.c3 .stat-icon { background: rgba(201,169,110,0.15); }
        .stat-card.c4 .stat-icon { background: rgba(196,160,160,0.12); }
        .stat-card.c5 .stat-icon { background: rgba(92,122,90,0.15); }
        .stat-card.c6 .stat-icon { background: rgba(240,196,196,0.12); }

        .stat-value {
            font-size: 28px;
            font-weight: 600;
            color: var(--ink);
            line-height: 1;
            margin-bottom: 4px;
            font-variant-numeric: tabular-nums;
        }

        .stat-label {
            font-size: 11.5px;
            color: var(--ink-soft);
            font-weight: 400;
        }

        .stat-trend {
            position: absolute;
            top: 18px; right: 18px;
            font-size: 11px;
            font-weight: 500;
            padding: 3px 8px;
            border-radius: 20px;
            background: rgba(168,188,161,0.15);
            color: var(--sage-deep);
        }

        /* ── GRID ─────────────────────────────────────── */
        .content-grid {
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 24px;
        }

        /* ── ACTIVITY PANEL ────────────────────────── */
        .panel {
            background: var(--white);
            border-radius: 20px;
            border: 1px solid var(--border);
            overflow: hidden;
        }

        .panel-header {
            padding: 24px 28px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--border);
        }

        .panel-title {
            font-family: 'Nunito', sans-serif;
            font-size: 17px;
            font-weight: 700;
            color: var(--ink);
            letter-spacing: 0.01em;
        }

        .panel-link {
            font-size: 12px;
            color: var(--sage-deep);
            text-decoration: none;
            font-weight: 500;
            letter-spacing: 0.03em;
            transition: color 0.2s;
        }

        .panel-link:hover { color: var(--ink); }

        .activity-list {
            padding: 8px 0;
            max-height: 520px;
            overflow-y: auto;
        }

        .activity-list::-webkit-scrollbar { width: 4px; }
        .activity-list::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

        .activity-item {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            padding: 14px 28px;
            transition: background 0.15s;
            cursor: default;
        }

        .activity-item:hover { background: var(--cream); }

        .act-icon {
            width: 36px; height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            flex-shrink: 0;
            margin-top: 1px;
        }

        .act-login    { background: rgba(168,188,161,0.18); }
        .act-logout   { background: rgba(149,165,166,0.15); }
        .act-create   { background: rgba(139,168,212,0.18); }
        .act-update   { background: rgba(240,196,196,0.18); }
        .act-delete   { background: rgba(231,76,60,0.10); }
        .act-password { background: rgba(201,169,110,0.15); }
        .act-disable  { background: rgba(243,156,18,0.15); }
        .act-enable   { background: rgba(168,188,161,0.18); }

        .act-body { flex: 1; min-width: 0; }

        .act-top {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 3px;
        }

        .act-user { font-size: 13.5px; font-weight: 600; color: var(--ink); }

        .act-role {
            font-size: 9.5px;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 2px 8px;
            border-radius: 20px;
            font-weight: 600;
        }

        .role-admin { background: rgba(231,76,60,0.10); color: #c0392b; }
        .role-staff { background: rgba(52,152,219,0.10); color: #2874a6; }

        .act-detail {
            font-size: 12.5px;
            color: var(--ink-soft);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 320px;
        }

        .act-time {
            font-size: 11px;
            color: rgba(74,85,104,0.5);
            white-space: nowrap;
            flex-shrink: 0;
        }

        /* ── QUICK ACTIONS ─────────────────────────── */
        .actions-panel { display: flex; flex-direction: column; gap: 24px; }

        .qa-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            padding: 20px 20px;
        }

        .qa-card {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
            padding: 18px 16px;
            border-radius: 14px;
            background: var(--cream);
            border: 1px solid var(--border);
            text-decoration: none;
            transition: all 0.22s ease;
            position: relative;
            overflow: hidden;
        }

        .qa-card:hover {
            background: var(--white);
            transform: translateY(-2px);
            box-shadow: var(--shadow-sm);
        }

        .qa-card .qa-icon {
            width: 36px; height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .qa-card h4 { font-size: 12.5px; font-weight: 600; color: var(--ink); }
        .qa-card p  { font-size: 11px; color: var(--ink-soft); line-height: 1.4; }

        /* ── MINI SUMMARY STRIP ─────────────────────── */
        .summary-strip {
            display: flex;
            gap: 0;
            background: var(--ink);
            border-radius: 16px;
            overflow: hidden;
            margin-top: 2px;
        }

        .strip-item {
            flex: 1;
            padding: 20px 18px;
            border-right: 1px solid rgba(255,255,255,0.06);
            text-align: center;
        }

        .strip-item:last-child { border-right: none; }

        .strip-val {
            font-family: 'Nunito', sans-serif;
            font-size: 30px;
            font-weight: 800;
            color: white;
            line-height: 1;
            margin-bottom: 4px;
        }

        .strip-label {
            font-size: 10px;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.35);
        }

        /* ── DECORATIVE DIVIDER ─────────────────────── */
        .divider-ornament {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 32px 0 28px;
        }

        .divider-ornament span {
            flex: 1;
            height: 1px;
            background: var(--border);
        }

        .divider-ornament .ornament {
            font-family: 'Nunito', sans-serif;
            font-size: 18px;
            color: var(--border-warm);
            letter-spacing: 0.1em;
        }

        /* ── EMPTY STATE ──────────────────────────── */
        .empty-activity {
            text-align: center;
            padding: 60px 20px;
            color: var(--ink-soft);
        }

        .empty-activity .icon { font-size: 40px; opacity: 0.3; margin-bottom: 12px; }
        .empty-activity p { font-size: 14px; }

        /* ── SCROLLBAR ────────────────────────────── */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

        /* ── ANIMATION ────────────────────────────── */
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(16px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .hero-banner  { animation: fadeUp 0.45s ease both; }
        .stats-row    { animation: fadeUp 0.45s 0.1s ease both; }
        .content-grid { animation: fadeUp 0.45s 0.2s ease both; }

        /* ── RESPONSIVE ───────────────────────────── */
        @media (max-width: 1300px) {
            .stats-row { grid-template-columns: repeat(3, 1fr); }
        }

        @media (max-width: 1100px) {
            .content-grid { grid-template-columns: 1fr; }
            .actions-panel { flex-direction: row; flex-wrap: wrap; }
        }

        @media (max-width: 900px) {
            .sidebar { transform: translateX(-100%); }
            .main { margin-left: 0; }
            .page-body { padding: 24px 20px 40px; }
            .hero-banner { padding: 28px 28px; }
            .hero-title { font-size: 28px; }
        }
    </style>
</head>
<body>

<!-- ════════════════════════════ SIDEBAR ════════════════════════════ -->
<aside class="sidebar">
    <div class="sidebar-top">
        <div class="brand-mark">
            <span class="brand-name">Vera<span class="brand-accent">Belle</span></span>
            <span class="brand-sub">Admin Collection</span>
        </div>
    </div>

    <nav class="nav">
        <div class="nav-section-label">Overview</div>
