<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    
    <title>{% block title %}VeraBelle Collection{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        @font-face {
            font-family: 'Braven';
            src: url('https://fonts.cdnfonts.com/css/braven') format('woff2');
            font-weight: normal;
            font-style: normal;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            display: flex;
            background: #f8f9fa;
            color: #2c3e50;
            min-height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            width: 250px;
            background: linear-gradient(180deg, #2c3e50, #34495e);
            color: #fff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 30px 0;
            position: fixed;
            height: 100%;
            left: 0;
            top: 0;
        }

        .logo {
            text-align: center;
        }

        .logo h1 {
            color: #F4C2C2;
            font-size: 28px;
            font-weight: 700;
            font-family: 'Braven', 'Georgia', serif;
            letter-spacing: 2px;
        }

        .logo p {
            color: #A8BCA1;
            letter-spacing: 3px;
            font-size: 10px;
            font-weight: 500;
            margin-top: 5px;
        }

        .nav {
            margin-top: 30px;
        }

        .nav ul {
            list-style: none;
        }

        .nav ul li a {
            display: flex;
            align-items: center;
            padding: 14px 25px;
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .nav ul li a:hover,
        .nav ul li a.active {
            background: rgba(255, 255, 255, 0.15);
            border-left: 4px solid #F4C2C2;
            color: #fff;
        }

        .nav ul li a span {
            margin-right: 10px;
        }

        .logout {
            text-align: center;
            padding: 20px;
        }

        .logout a {
            color: #fff;
            text-decoration: none;
            font-size: 14px;
        }

        /* Main content area */
        .main-content {
            margin-left: 250px;
            width: calc(100% - 250px);
            padding: 20px 40px;
        }

        /* Header */
        header {
            background: #fff;
            border-radius: 10px;
            padding: 20px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            margin-bottom: 30px;
        }

        header h2 {
            font-size: 24px;
            color: #2c3e50;
        }

        .search-box {
            position: relative;
        }

        .search-box input {
            padding: 10px 15px 10px 35px;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

        .search-box span {
            position: absolute;
            left: 10px;
            top: 8px;
            opacity: 0.6;
        }

        .user {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, #F4C2C2, #A8BCA1);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: bold;
        }

        .user-info {
            text-align: right;
        }

        .user-info small {
            display: block;
            color: #999;
            font-size: 12px;
        }

        /* Page content area */
        .page-content {
            background: #fff;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .delete-modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(4px);
            z-index: 9999;
            align-items: center;
            justify-content: center;
            animation: fadeIn 0.3s ease;
        }

        .delete-modal-overlay.active {
            display: flex;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        .delete-modal {
            background: white;
            border-radius: 16px;
            padding: 30px;
            max-width: 450px;
            width: 90%;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            animation: slideUp 0.3s ease;
            position: relative;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .delete-modal-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
        }

        .delete-modal-icon {
            width: 50px;
            height: 50px;
            background: rgba(231, 76, 60, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .delete-modal-title {
            flex: 1;
        }

        .delete-modal-title h3 {
            font-size: 20px;
            color: #2c3e50;
            margin: 0 0 5px 0;
            font-weight: 600;
        }

        .delete-modal-title p {
            font-size: 13px;
            color: #7f8c8d;
            margin: 0;
        }

        .delete-modal-body {
            padding: 20px 0;
            border-top: 2px solid #f0f0f0;
            border-bottom: 2px solid #f0f0f0;
        }

        .delete-modal-body p {
            color: #4a5568;
            line-height: 1.6;
            margin: 0 0 15px 0;
        }

        .delete-modal-product {
            background: rgba(244, 194, 194, 0.1);
            padding: 12px 16px;
            border-radius: 8px;
            border-left: 4px solid #F4C2C2;
            font-weight: 600;
            color: #2c3e50;
        }

        .delete-modal-footer {
            display: flex;
            gap: 12px;
            margin-top: 25px;
        }

        .modal-btn {
            flex: 1;
            padding: 12px;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: 'Poppins', sans-serif;
        }

        .modal-btn-cancel {
            background: rgba(168, 188, 161, 0.15);
            color: #5a6d54;
            border: 1px solid rgba(168, 188, 161, 0.3);
        }

        .modal-btn-cancel:hover {
            background: #A8BCA1;
            color: white;
            border-color: #A8BCA1;
        }

        .modal-btn-delete {
            background: #c0392b;
            color: white;
        }

        .modal-btn-delete:hover {
            background: #a93226;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(192, 57, 43, 0.4);
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar">
        <div>
            <div class="logo">
                <h1>VeraBelle</h1>
                <p>Collection</p>
            </div>
            <nav class="nav">
                <ul>
                    {% if is_granted('ROLE_ADMIN') %}
                    <li><a href="{{ path('app_admin_dashboard') }}" class="{% if app.request.attributes.get('_route') == 'app_admin_dashboard' %}active{% endif %}">
                        <span></span> Admin Dashboard
                    </a></li>
                    {% else %}
                    <li><a href="{{ path('app_dashboard') }}" class="{% if app.request.attributes.get('_route') == 'app_dashboard' %}active{% endif %}">
                        <span></span> Dashboard
                    </a></li>
                    {% endif %}
                    
                    {% if is_granted('ROLE_ADMIN') %}
                    <li><a href="{{ path('app_admin_users_index') }}" class="{% if app.request.attributes.get('_route') starts with 'app_admin_users' %}active{% endif %}">
                        <span></span> User Management
                    </a></li>
                    <li><a href="{{ path('app_admin_activity_logs') }}" class="{% if app.request.attributes.get('_route') starts with 'app_admin_activity' %}active{% endif %}">
                        <span></span> Activity Logs
                    </a></li>
                    {% endif %}
                    
                    <li><a href="{{ path('app_product_index') }}" class="{% if app.request.attributes.get('_route') starts with 'app_product' %}active{% endif %}">
                        <span></span> Products
                    </a></li>
                    <li><a href="{{ path('app_category_index') }}" class="{% if app.request.attributes.get('_route') starts with 'app_category' %}active{% endif %}">
                        <span></span> Categories
                    </a></li>
                    <li><a href="{{ path('app_stock_index') }}" class="{% if app.request.attributes.get('_route') starts with 'app_stock' %}active{% endif %}">
                        <span></span> Stocks
                    </a></li>
                    <li><a href="{{ path('app_order_index') }}" class="{% if app.request.attributes.get('_route') starts with 'app_order' %}active{% endif %}">
                        <span></span> Orders
                    </a></li>
                    <li><a href="{{ path('app_customer_index') }}" class="{% if app.request.attributes.get('_route') starts with 'app_customer' %}active{% endif %}">
                        <span></span> Customers
                    </a></li>
                    <li><a href="{{ path('app_payment_index') }}" class="{% if app.request.attributes.get('_route') starts with 'app_payment' %}active{% endif %}">
                        <span></span> Payments
                    </a></li>
                    
                    <li><a href="{{ path('app_profile') }}" class="{% if app.request.attributes.get('_route') starts with 'app_profile' %}active{% endif %}">
                        <span></span> My Profile
                    </a></li>
            </nav>
        </div>

        <div class="logout">
            <a href="{{ path('app_logout') }}"> Logout</a>
        </div>
    </aside>

    <!-- Main content -->
    <div class="main-content">
        <header>
            <h2>{% block page_title %}Dashboard{% endblock %}</h2>
            <div class="user">
                <div class="user-info">
                    <strong>{{ app.user.email }}</strong>
                    <small>
                        {% for role in app.user.roles %}
                            {% if role != 'ROLE_USER' %}
                                {{ role|replace({'ROLE_': ''}) }}
                            {% endif %}
                        {% endfor %}
                    </small>
                </div>
                <div class="user-avatar">
                    {{ app.user.email|slice(0, 1)|upper }}
                </div>
            </div>
        </header>

        {% block body %}
        <div class="page-content">
            {% block content %}
            <!-- Page-specific content will appear here -->
            {% endblock %}
        </div>
        {% endblock %}
    </div>
    
    <div class="delete-modal-overlay" id="deleteModal">
        <div class="delete-modal">
            <div class="delete-modal-header">
                <div class="delete-modal-icon">⚠️</div>
                <div class="delete-modal-title">
                    <h3>Confirm Deletion</h3>
                    <p>This action cannot be undone</p>
                </div>
            </div>
            <div class="delete-modal-body">
                <p>Are you sure you want to delete this product from your VeraBelle Collection?</p>
                <div class="delete-modal-product" id="productNameDisplay"></div>
            </div>
            <div class="delete-modal-footer">
                <button type="button" class="modal-btn modal-btn-cancel" onclick="closeDeleteModal()">
                    Cancel
                </button>
                <button type="button" class="modal-btn modal-btn-delete" onclick="confirmDelete()">
                    Delete Product
                </button>
            </div>
        </div>
    </div>

    <script>
        let deleteFormToSubmit = null;

        function openDeleteModal(form, productName) {
            deleteFormToSubmit = form;
            document.getElementById('productNameDisplay').textContent = productName;
            document.getElementById('deleteModal').classList.add('active');
            return false;
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.remove('active');
            deleteFormToSubmit = null;
        }

        function confirmDelete() {
            if (deleteFormToSubmit) {
                deleteFormToSubmit.submit();
            }
            closeDeleteModal();
        }

        document.getElementById('deleteModal')?.addEventListener('click', function(e) {
            if (e.target === this) {
                closeDeleteModal();
            }
        });

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeDeleteModal();
            }
        });
    </script>
</body>
</html>