        </a>
        <a href="{{ path('app_category_index') }}" class="{% if app.request.attributes.get('_route') starts with 'app_category' %}active{% endif %}">
            <span class="nav-icon"><i data-lucide="tag"></i></span> Categories
        </a>
        <a href="{{ path('app_stock_index') }}" class="{% if app.request.attributes.get('_route') starts with 'app_stock' %}active{% endif %}">
