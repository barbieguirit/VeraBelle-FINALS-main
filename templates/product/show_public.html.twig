{% extends 'base_landing.html.twig' %}

{% block title %}{{ product.name }} — VeraBelle Collection{% endblock %}
{% block meta_desc %}{{ product.description|slice(0,150) }}{% endblock %}

{% block body %}
<style>
    :root {
        --ivory: #F9F4EE; --parchment: #EFE6D8; --mauve: #C4A0A0;
        --deep-mauve: #9E6F6F; --sage: #8FAF8C; --charcoal: #3A3232;
        --warm-gray: #7A6F6F; --blush: #E8CECE;
    }
    body { font-family: 'Nunito', sans-serif; background: var(--ivory); color: var(--charcoal); }

    .product-page {
        max-width: 1100px; margin: 0 auto; padding: 120px 40px 100px;
        display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: start;
    }

    /* Image */
    .product-img-wrap {
        border-radius: 20px; overflow: hidden;
        background: linear-gradient(135deg, var(--parchment), var(--blush));
        aspect-ratio: 3/4; position: sticky; top: 100px;
    }
    .product-img-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .product-img-placeholder {
        width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
        font-family: 'Playfair Display', serif; font-size: 80px; font-weight: 300;
        font-style: italic; color: rgba(158,111,111,0.4);
    }

    /* Info */
    .product-info { padding-top: 8px; }
    .product-breadcrumb {
        font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase;
        color: var(--warm-gray); margin-bottom: 16px;
    }
    .product-breadcrumb a { color: var(--warm-gray); text-decoration: none; }
    .product-breadcrumb a:hover { color: var(--deep-mauve); }
    .product-category-tag {
        display: inline-block; padding: 4px 14px; border-radius: 20px;
        font-size: 10px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase;
        background: rgba(196,160,160,0.15); color: var(--deep-mauve);
        border: 1px solid rgba(196,160,160,0.3); margin-bottom: 20px;
    }
    .product-title {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: clamp(28px, 4vw, 42px); font-weight: 400;
        color: var(--charcoal); line-height: 1.2; margin-bottom: 20px;
    }
    .product-price-display {
        font-family: 'Playfair Display', serif; font-size: 36px;
        font-weight: 600; color: var(--charcoal); margin-bottom: 24px;
    }
    .product-price-display span { font-size: 20px; font-weight: 300; color: var(--warm-gray); margin-right: 2px; }
    .product-stock-badge {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 6px 16px; border-radius: 20px; font-size: 12px; font-weight: 700;
        margin-bottom: 28px;
    }
    .product-stock-badge.in  { background: rgba(92,122,90,0.1); color: #3d6b3a; border: 1px solid rgba(92,122,90,0.25); }
    .product-stock-badge.out { background: rgba(122,111,111,0.1); color: var(--warm-gray); border: 1px solid rgba(122,111,111,0.2); }
    .product-divider { border: none; border-top: 1px solid rgba(196,160,160,0.2); margin: 28px 0; }
    .product-desc {
        font-size: 15px; color: var(--warm-gray); line-height: 1.8;
        font-weight: 300; margin-bottom: 36px;
    }

    .btn-add-cart {
        width: 100%; padding: 16px; border-radius: 12px;
        background: linear-gradient(135deg, var(--mauve), var(--deep-mauve));
        color: white; border: none; font-family: 'Nunito', sans-serif;
        font-size: 13px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
        cursor: pointer; transition: opacity 0.2s, transform 0.2s; margin-bottom: 12px;
    }
    .btn-add-cart:hover { opacity: 0.9; transform: translateY(-2px); }
    .btn-add-cart:disabled { opacity: 0.45; cursor: not-allowed; transform: none; }
    .btn-back-shop {
        display: block; text-align: center; padding: 14px;
        border-radius: 12px; border: 1.5px solid rgba(196,160,160,0.4);
        color: var(--warm-gray); font-size: 13px; font-weight: 600;
        text-decoration: none; transition: border-color 0.2s, color 0.2s;
    }
    .btn-back-shop:hover { border-color: var(--mauve); color: var(--deep-mauve); }

    @media (max-width: 800px) {
        .product-page { grid-template-columns: 1fr; padding: 100px 24px 80px; gap: 40px; }
        .product-img-wrap { position: static; aspect-ratio: 4/3; }
    }
</style>

<div class="product-page">
    <!-- Image -->
    <div class="product-img-wrap">
        {% if product.image %}
            <img src="/uploads/{{ product.image }}" alt="{{ product.name }}">
        {% else %}
            <div class="product-img-placeholder">{{ product.name|slice(0,2)|upper }}</div>
        {% endif %}
    </div>

    <!-- Info -->
    <div class="product-info">
        <div class="product-breadcrumb">
            <a href="{{ path('app_landing') }}">Home</a> &nbsp;/&nbsp;
            <a href="{{ path('app_shop') }}">Shop</a> &nbsp;/&nbsp;
            {{ product.name }}
        </div>

        {% if product.category %}
            <div class="product-category-tag">{{ product.category.name }}</div>
        {% endif %}

        <h1 class="product-title">{{ product.name }}</h1>

        <div class="product-price-display"><span>₱</span>{{ "%.0f"|format(product.price) }}</div>

        {% if product.stock > 0 %}
            <div class="product-stock-badge in">✓ In Stock ({{ product.stock }} available)</div>
        {% else %}
            <div class="product-stock-badge out">✕ Out of Stock</div>
        {% endif %}

        <hr class="product-divider">

        <p class="product-desc">
            {{ product.description ?? 'A beautiful piece from our curated VeraBelle Collection.' }}
        </p>

        {% if product.stock > 0 %}
            <button class="btn-add-cart" id="addCartBtn"
                    onclick="addToCart({{ product.id }}, '{{ product.name|escape('js') }}', {{ product.price }}, this)">
                Add to Cart
            </button>
            <a href="{{ path('app_checkout') }}" class="btn-add-cart"
               style="background: linear-gradient(135deg, #8FAF8C, #5C7A5A); display:block; text-align:center; text-decoration:none; margin-bottom:12px;"
               onclick="buyNow(event, {{ product.id }})">
                Buy Now
            </a>
        {% else %}
            <button class="btn-add-cart" disabled>Out of Stock</button>
        {% endif %}

        <a href="{{ path('app_shop') }}" class="btn-back-shop">← Back to Shop</a>
    </div>
</div>

<script>
function addToCart(productId, productName, productPrice, button) {
    button.disabled = true;
    button.textContent = 'Adding...';
    fetch(`/cart/add/${productId}`, { method: 'POST' })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                button.textContent = '✓ Added to Cart!';
                button.style.background = 'linear-gradient(135deg, #8FAF8C, #5C7A5A)';
                setTimeout(() => {
                    button.disabled = false;
                    button.textContent = 'Add to Cart';
                    button.style.background = '';
                }, 2500);
            } else {
                alert(data.message || 'Failed to add to cart.');
                button.disabled = false;
                button.textContent = 'Add to Cart';
            }
        })
        .catch(() => { button.disabled = false; button.textContent = 'Add to Cart'; });
}

function buyNow(event, productId) {
    event.preventDefault();
    fetch(`/cart/add/${productId}`, { method: 'POST' })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                window.location.href = '{{ path('app_checkout') }}';
            } else {
                alert(data.message || 'Failed to add to cart.');
            }
        })
        .catch(() => { window.location.href = '{{ path('app_checkout') }}'; });
}
</script>
{% endblock %}
