<script>
    let allProducts = [];

    function initProducts() {
        allProducts = Array.from(document.querySelectorAll('#productGrid .product-card'));
        updateCount();
        updatePriceFill();
    }

    function updatePriceFill() {
        const min = parseInt(document.getElementById('priceMin').value);
        const max = parseInt(document.getElementById('priceMax').value);
        const fill = document.getElementById('priceFill');
        fill.style.left  = (min / 5000 * 100) + '%';
        fill.style.width = ((max - min) / 5000 * 100) + '%';
        document.getElementById('priceMinDisplay').textContent = min.toLocaleString();
        document.getElementById('priceMaxDisplay').textContent = max.toLocaleString();
    }

    function filterProducts() {
        updatePriceFill();

        const min = parseInt(document.getElementById('priceMin').value);
        const max = parseInt(document.getElementById('priceMax').value);

        const catBoxes = Array.from(document.querySelectorAll('.filter-opt input[type="checkbox"]'));
        const tagBoxes = Array.from(document.querySelectorAll('.tag-pill-label input[type="checkbox"]'));

        const allCat  = catBoxes.find(c => c.value === 'all' && c.checked);
        const selCats = catBoxes.filter(c => c.checked && c.value !== 'all').map(c => c.value);
        const selTags = tagBoxes.filter(c => c.checked).map(c => c.value);

        let count = 0;
        allProducts.forEach(card => {
            const cat   = card.dataset.category || '';
            const price = parseInt(card.dataset.price) || 0;
            const tags  = (card.dataset.tags || '').split(' ');

            const okCat    = allCat || selCats.length === 0 || selCats.some(s => cat === s || cat.startsWith(s));
            const okTag    = selTags.length === 0 || selTags.some(t => tags.includes(t));
            const okPrice  = price >= min && price <= max;

            const show = okCat && okTag && okPrice;
            card.style.display = show ? 'flex' : 'none';
            if (show) count++;
        });

        document.getElementById('resultCount').textContent = count;

        // No results message
        const grid = document.getElementById('productGrid');
        let noRes = grid.querySelector('.no-results');
        if (count === 0) {
            if (!noRes) {
                noRes = document.createElement('div');
                noRes.className = 'no-results';
                noRes.innerHTML = '<h3>Nothing found</h3><p>Try adjusting your filters.</p>';
                grid.appendChild(noRes);
            }
            noRes.style.display = 'block';
        } else if (noRes) {
            noRes.style.display = 'none';
        }
    }

    function sortProducts() {
        const val  = document.getElementById('sortSelect').value;
        const grid = document.getElementById('productGrid');
        const cards = allProducts.slice();

        cards.sort((a, b) => {
            const pa = parseInt(a.dataset.price) || 0;
            const pb = parseInt(b.dataset.price) || 0;
            if (val === 'price-low')  return pa - pb;
            if (val === 'price-high') return pb - pa;
            return 0;
        });
        cards.forEach(c => grid.appendChild(c));
    }

    function updateCount() {
        document.getElementById('resultCount').textContent = allProducts.length;
    }

    function buyNow(productId, button) {
        button.disabled = true;
        button.textContent = '...';
        fetch(`/cart/add/${productId}`, { method: 'POST' })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    window.location.href = '{{ path('app_checkout') }}';
                } else {
                    alert(data.message || 'Failed to add to cart.');
                    button.disabled = false;
                    button.textContent = 'Buy';
                }
            })
            .catch(() => { window.location.href = '{{ path('app_checkout') }}'; });
    }

    function addToCart(productId, productName, productPrice, button) {
        // Prevent multiple clicks
        button.disabled = true;
        button.textContent = 'Adding...';

        fetch(`/cart/add/${productId}`, { method: 'POST' })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    // Show success feedback
                    button.textContent = '✓ Added!';
                    button.style.background = 'var(--deep-sage)';
                    
                    // Update cart count in navbar if exists
                    updateCartCount();
                    
                    // Reset button after 2s
                    setTimeout(() => {
                        button.disabled = false;
                        button.textContent = 'Buy';
                        button.style.background = 'linear-gradient(135deg, var(--mauve), var(--deep-mauve))';
                    }, 2000);
                } else {
                    alert('Failed to add to cart: ' + (data.message || 'Unknown error'));
                    button.disabled = false;
                    button.textContent = 'Buy';
                }
            })
            .catch(err => {
                alert('Error adding to cart: ' + err.message);
                button.disabled = false;
                button.textContent = 'Buy';
            });
    }

    function updateCartCount() {
        // Fetch current cart count and update navbar if exists
        fetch('/cart', { 
            method: 'GET',
            headers: { 'Accept': 'application/json' }
        })
        .then(r => r.json())
        .then(data => {
            const countEl = document.getElementById('cart-count');
            if (countEl && data.itemCount) {
                countEl.textContent = data.itemCount;
                countEl.style.display = 'inline-block';
            }
        })
        .catch(() => {}); // Silently fail
    }

    document.addEventListener('change', e => {
        if (e.target.value === 'all' && e.target.checked) {
            document.querySelectorAll('.filter-opt input:not([value="all"])').forEach(c => c.checked = false);
            filterProducts();
        }
    });

    document.addEventListener('DOMContentLoaded', () => {
        initProducts();
        updateCartCount();

        // Auto-apply search query from URL
        const searchQuery = {{ searchQuery|default('')|json_encode|raw }};
        if (searchQuery) {
            allProducts.forEach(card => {
                const name = card.dataset.name || '';
                const cat  = card.dataset.category || '';
                const show = name.includes(searchQuery.toLowerCase()) || cat.includes(searchQuery.toLowerCase());
                card.style.display = show ? 'flex' : 'none';
            });
            const visible = allProducts.filter(c => c.style.display !== 'none').length;
            document.getElementById('resultCount').textContent = visible;
        }
    });
</script>

