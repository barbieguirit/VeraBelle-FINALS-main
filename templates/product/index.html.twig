{% extends 'base_dashboard.html.twig' %}

{% block title %}Products — VeraBelle Collection{% endblock %}
{% block page_title %}Products{% endblock %}

{% block content %}
<style>
    :root {
        --blush:#F0C4C4; --sage:#A8BCA1; --sage-deep:#7A9972;
        --ink:#1A1F2E; --ink-soft:#4A5568; --cream:#FAF8F5;
        --cream-warm:#F4F0EA; --gold:#C9A96E; --white:#FFFFFF;
        --border:rgba(26,31,46,0.08); --shadow-sm:0 2px 12px rgba(26,31,46,0.06);
        --shadow-md:0 8px 32px rgba(26,31,46,0.10); --radius:16px; --radius-sm:10px;
    }
    * { font-family:'Figtree',sans-serif; box-sizing:border-box; }
    @keyframes fadeUp { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:translateY(0)} }

    /* Header */
    .page-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; flex-wrap:wrap; gap:12px; animation:fadeUp 0.4s ease both; }
    .page-eyebrow { font-size:10px; letter-spacing:0.2em; text-transform:uppercase; color:var(--gold); font-weight:600; margin-bottom:4px; }
    .page-title { font-family:'Nunito',sans-serif; font-size:26px; font-weight:800; color:var(--ink); line-height:1; }
    .page-sub { font-size:13px; color:var(--ink-soft); margin-top:2px; }

    .btn-add {
        display:inline-flex; align-items:center; gap:8px; padding:11px 22px;
        background:var(--ink); color:#fff; border-radius:40px; text-decoration:none;
        font-size:13.5px; font-weight:600; transition:all 0.22s;
        box-shadow:0 4px 16px rgba(26,31,46,0.18);
    }
    .btn-add:hover { background:var(--ink-soft); transform:translateY(-2px); box-shadow:0 8px 24px rgba(26,31,46,0.22); color:#fff; }
    .btn-add-icon {
        width:22px; height:22px; background:linear-gradient(135deg,var(--blush),var(--sage));
        border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0;
    }

    /* Stats */
    .stats-strip { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:24px; animation:fadeUp 0.4s 0.08s ease both; }
    .strip-card { background:var(--white); border-radius:var(--radius-sm); padding:18px 20px; border:1px solid var(--border); display:flex; align-items:center; gap:14px; transition:all 0.2s; }
    .strip-card:hover { box-shadow:var(--shadow-sm); transform:translateY(-2px); }
    .strip-icon { width:40px; height:40px; border-radius:12px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .si-blush { background:rgba(240,196,196,0.18); }
    .si-sage  { background:rgba(168,188,161,0.18); }
    .si-gold  { background:rgba(201,169,110,0.15); }
    .si-red   { background:rgba(231,76,60,0.10); }
    .strip-val { font-family:'Nunito',sans-serif; font-size:22px; font-weight:800; color:var(--ink); line-height:1; }
    .strip-lbl { font-size:11.5px; color:var(--ink-soft); margin-top:2px; }

    /* Grid section */
    .products-grid-section { background:var(--white); border-radius:var(--radius); border:1px solid var(--border); padding:24px; animation:fadeUp 0.4s 0.16s ease both; }
    .grid-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; padding-bottom:16px; border-bottom:1px solid var(--border); }
    .grid-title { font-family:'Nunito',sans-serif; font-size:15px; font-weight:800; color:var(--ink); }
    .grid-count { background:var(--cream); border-radius:12px; padding:4px 12px; font-size:12px; font-weight:700; color:var(--ink-soft); }

    /* Product cards */
    .products-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(290px,1fr)); gap:18px; }
    .product-card { background:var(--white); border:1px solid var(--border); border-radius:var(--radius-sm); overflow:hidden; transition:all 0.22s; display:flex; flex-direction:column; }
    .product-card:hover { box-shadow:var(--shadow-md); transform:translateY(-4px); border-color:rgba(240,196,196,0.3); }
    .card-top-bar { height:4px; background:linear-gradient(90deg,var(--blush),var(--sage)); }

    .card-image { width:100%; height:160px; background:linear-gradient(135deg,rgba(240,196,196,0.12),rgba(168,188,161,0.12)); display:flex; align-items:center; justify-content:center; overflow:hidden; position:relative; }
    .card-image img { width:100%; height:100%; object-fit:cover; display:block; }
    .card-image-placeholder { display:flex; align-items:center; justify-content:center; width:100%; height:100%; }

    .card-body { padding:16px; display:flex; flex-direction:column; gap:12px; flex:1; }

    .card-header-row { display:flex; align-items:flex-start; gap:12px; }
    .prod-avatar { width:44px; height:44px; min-width:44px; border-radius:10px; background:linear-gradient(135deg,rgba(240,196,196,0.2),rgba(168,188,161,0.2)); display:flex; align-items:center; justify-content:center; border:1px solid var(--border); overflow:hidden; flex-shrink:0; }
    .prod-avatar img { width:100%; height:100%; object-fit:cover; }
    .prod-name { font-weight:700; color:var(--ink); font-size:14px; line-height:1.3; }
    .prod-desc { font-size:12px; color:var(--ink-soft); margin-top:2px; line-height:1.4; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }

    .card-meta { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
    .cat-badge { display:inline-flex; align-items:center; gap:4px; padding:4px 10px; background:rgba(168,188,161,0.14); color:var(--sage-deep); border-radius:16px; font-size:11px; font-weight:600; border:1px solid rgba(168,188,161,0.25); }
    .price-tag { font-family:'Nunito',sans-serif; font-size:15px; font-weight:800; color:var(--ink); margin-left:auto; }

    .card-details { padding-top:10px; border-top:1px solid var(--border); }
    .detail-row { display:flex; justify-content:space-between; align-items:center; font-size:12.5px; }
    .detail-label { color:var(--ink-soft); font-weight:500; }
    .stock-badge { display:inline-flex; align-items:center; gap:5px; padding:4px 10px; border-radius:16px; font-size:11px; font-weight:700; }
    .stock-badge::before { content:''; width:5px; height:5px; border-radius:50%; background:currentColor; opacity:0.7; }
    .stock-high   { background:rgba(168,188,161,0.14); color:var(--sage-deep); border:1px solid rgba(168,188,161,0.25); }
    .stock-medium { background:rgba(201,169,110,0.12); color:#a07830; border:1px solid rgba(201,169,110,0.25); }
    .stock-low    { background:rgba(231,76,60,0.08); color:#c0392b; border:1px solid rgba(231,76,60,0.18); }

    .card-actions { display:flex; gap:6px; padding-top:12px; border-top:1px solid var(--border); }
    .btn-action { flex:1; padding:8px 10px; border-radius:8px; font-size:12px; font-weight:600; cursor:pointer; transition:all 0.18s; text-decoration:none; display:inline-flex; align-items:center; justify-content:center; gap:4px; border:1px solid transparent; font-family:'Figtree',sans-serif; }
    .btn-view   { background:var(--cream); color:var(--ink-soft); border-color:var(--border); }
    .btn-view:hover   { background:var(--cream-warm); color:var(--ink); }
    .btn-edit   { background:rgba(240,196,196,0.14); color:#b86060; border-color:rgba(240,196,196,0.3); }
    .btn-edit:hover   { background:var(--blush); color:#fff; border-color:var(--blush); }
    .btn-delete { background:rgba(231,76,60,0.07); color:#c0392b; border-color:rgba(231,76,60,0.18); }
    .btn-delete:hover { background:#e74c3c; color:#fff; border-color:#e74c3c; }
    .btn-disabled { background:rgba(200,200,200,0.12); color:#bbb; border-color:rgba(200,200,200,0.2); cursor:not-allowed; opacity:0.6; pointer-events:none; }

    /* Empty */
    .empty-state { grid-column:1/-1; display:flex; flex-direction:column; align-items:center; padding:80px 20px; text-align:center; gap:10px; }
    .empty-icon-wrap { width:64px; height:64px; background:var(--cream-warm); border-radius:20px; display:flex; align-items:center; justify-content:center; margin-bottom:4px; }
    .empty-state h3 { font-family:'Nunito',sans-serif; font-size:17px; font-weight:800; color:var(--ink); }
    .empty-state p { font-size:13px; color:var(--ink-soft); }

    @media (max-width:900px) { .stats-strip { grid-template-columns:repeat(2,1fr); } }
    @media (max-width:600px) { .stats-strip { grid-template-columns:1fr; } .page-header { flex-direction:column; align-items:flex-start; } .products-grid { grid-template-columns:1fr; } }
</style>

<!-- Header -->
<div class="page-header">
    <div>
        <div class="page-eyebrow">Inventory</div>
        <div class="page-title">Products</div>
        <div class="page-sub">Manage your VeraBelle collection items</div>
    </div>
    <a href="{{ path('app_product_new') }}" class="btn-add">
        <span class="btn-add-icon"><i data-lucide="plus" style="width:13px;height:13px;stroke:white;stroke-width:2.5;"></i></span>
        Add New Product
    </a>
</div>

<!-- Stats -->
<div class="stats-strip">
    <div class="strip-card">
        <div class="strip-icon si-blush"><i data-lucide="shirt" style="width:18px;height:18px;stroke:#e8a8a8;stroke-width:1.75;"></i></div>
        <div><div class="strip-val">{{ products|length }}</div><div class="strip-lbl">Total Products</div></div>
    </div>
    <div class="strip-card">
        <div class="strip-icon si-sage"><i data-lucide="check-circle" style="width:18px;height:18px;stroke:var(--sage-deep);stroke-width:1.75;"></i></div>
        <div><div class="strip-val">{{ products|filter(p => p.stock >= 50)|length }}</div><div class="strip-lbl">Well Stocked</div></div>
    </div>
    <div class="strip-card">
        <div class="strip-icon si-gold"><i data-lucide="alert-triangle" style="width:18px;height:18px;stroke:#a07830;stroke-width:1.75;"></i></div>
        <div><div class="strip-val">{{ products|filter(p => p.stock < 50 and p.stock >= 20)|length }}</div><div class="strip-lbl">Low Stock</div></div>
    </div>
    <div class="strip-card">
        <div class="strip-icon si-red"><i data-lucide="alert-circle" style="width:18px;height:18px;stroke:#c0392b;stroke-width:1.75;"></i></div>
        <div><div class="strip-val">{{ products|filter(p => p.stock < 20)|length }}</div><div class="strip-lbl">Critical Stock</div></div>
    </div>
</div>

<!-- Products Grid -->
<div class="products-grid-section">
    <div class="grid-header">
        <span class="grid-title">All Products</span>
        <span class="grid-count">{{ products|length }} items</span>
    </div>
    <div class="products-grid">
        {% for product in products %}
        {% set isAdmin = is_granted('ROLE_ADMIN') %}
        {% set isCreator = product.createdBy and app.user and product.createdBy.id == app.user.id %}
        {% set canEdit = isAdmin or isCreator %}

        <div class="product-card">
            <div class="card-top-bar"></div>
            <div class="card-image">
                {% if product.image %}
                    <img src="{{ asset('uploads/' ~ product.image) }}" alt="{{ product.name }}">
                {% else %}
                    <div class="card-image-placeholder">
                        <i data-lucide="shirt" style="width:48px;height:48px;stroke:rgba(168,188,161,0.4);stroke-width:1;"></i>
                    </div>
                {% endif %}
            </div>
            <div class="card-body">
                <div class="card-header-row">
                    <div class="prod-avatar">
                        {% if product.image %}
                            <img src="{{ asset('uploads/' ~ product.image) }}" alt="{{ product.name }}">
                        {% else %}
                            <i data-lucide="shirt" style="width:20px;height:20px;stroke:rgba(168,188,161,0.6);stroke-width:1.5;"></i>
                        {% endif %}
                    </div>
                    <div>
                        <div class="prod-name">{{ product.name }}</div>
                        <div class="prod-desc">{{ product.description }}</div>
                    </div>
                </div>

                <div class="card-meta">
                    <span class="cat-badge">
                        <i data-lucide="tag" style="width:10px;height:10px;stroke:currentColor;stroke-width:2;"></i>
                        {{ product.category }}
                    </span>
                    <span class="price-tag">₱{{ product.price|number_format(2) }}</span>
                </div>

                <div class="card-details">
                    <div class="detail-row">
                        <span class="detail-label">Stock</span>
                        <span class="stock-badge {% if product.stock < 20 %}stock-low{% elseif product.stock < 50 %}stock-medium{% else %}stock-high{% endif %}">
                            {{ product.stock }} units
                        </span>
                    </div>
                </div>

                <div class="card-actions">
                    <a href="{{ path('app_product_show', {'id': product.id}) }}" class="btn-action btn-view">
                        <i data-lucide="eye" style="width:12px;height:12px;stroke:currentColor;stroke-width:2;"></i> View
                    </a>
                    {% if canEdit %}
                        <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="btn-action btn-edit">
                            <i data-lucide="pencil" style="width:12px;height:12px;stroke:currentColor;stroke-width:2;"></i> Edit
                        </a>
                    {% else %}
                        <span class="btn-action btn-disabled">Edit</span>
                    {% endif %}
                    {% if canEdit %}
                        <form method="post" action="{{ path('app_product_delete', {'id': product.id}) }}" style="flex:1;" onsubmit="return confirm('Delete {{ product.name }}?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                            <button type="submit" class="btn-action btn-delete" style="width:100%;">
                                <i data-lucide="trash-2" style="width:12px;height:12px;stroke:currentColor;stroke-width:2;"></i> Delete
                            </button>
                        </form>
                    {% else %}
                        <span class="btn-action btn-disabled" style="flex:1;">Delete</span>
                    {% endif %}
                </div>
            </div>
        </div>
        {% else %}
        <div class="empty-state">
            <div class="empty-icon-wrap"><i data-lucide="shirt" style="width:28px;height:28px;stroke:var(--ink-soft);stroke-width:1.5;"></i></div>
            <h3>No Products Found</h3>
            <p>Start by creating your first product in the VeraBelle collection</p>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
