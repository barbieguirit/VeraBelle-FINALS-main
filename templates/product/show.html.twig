{% extends 'base_dashboard.html.twig' %}

{% block title %}{{ product.name }} — VeraBelle Collection{% endblock %}
{% block page_title %}Product Details{% endblock %}

{% block content %}
<style>
    :root {
        --mauve:#C4A0A0; --deep-mauve:#9E6F6F; --sage:#8FAF8C; --deep-sage:#5C7A5A;
        --charcoal:#3A3232; --warm-gray:#7A6F6F; --ivory:#F9F4EE; --parchment:#EFE6D8;
        --gold:#C9A96E; --white:#FFFFFF;
        --border:rgba(58,50,50,0.08); --shadow-sm:0 2px 12px rgba(58,50,50,0.06);
        --shadow-md:0 8px 32px rgba(58,50,50,0.10); --r:16px; --r-sm:10px;
    }
    * { font-family:'Figtree',sans-serif; box-sizing:border-box; }

    .pw { max-width:1400px; margin:0 auto; }

    /* Layout */
    .product-layout { display:grid; grid-template-columns:420px 1fr; gap:28px; align-items:start; }

    /* Image */
    .product-img-card { background:var(--white); border-radius:var(--r); border:1px solid var(--border); overflow:hidden; box-shadow:var(--shadow-sm); position:sticky; top:24px; }
    .product-img-wrap { aspect-ratio:3/4; background:linear-gradient(135deg,var(--parchment),var(--ivory)); display:flex; align-items:center; justify-content:center; overflow:hidden; }
    .product-img-wrap img { width:100%; height:100%; object-fit:cover; display:block; }
    .product-img-placeholder { display:flex; align-items:center; justify-content:center; width:100%; height:100%; }
    .product-img-footer { padding:16px 20px; border-top:1px solid var(--border); display:flex; gap:8px; }

    /* Info panels */
    .info-stack { display:flex; flex-direction:column; gap:20px; }

    /* Hero panel */
    .product-hero-panel {
        background:linear-gradient(135deg,#2A2020,var(--charcoal));
        border-radius:var(--r); padding:32px 36px;
        position:relative; overflow:hidden; border:1px solid rgba(196,160,160,0.1);
    }
    .product-hero-panel::before { content:''; position:absolute; top:-60px; right:40px; width:240px; height:240px; background:radial-gradient(circle,rgba(196,160,160,0.12) 0%,transparent 65%); pointer-events:none; }
    .ph-eyebrow { font-size:10px; font-weight:700; letter-spacing:4px; text-transform:uppercase; color:var(--gold); margin-bottom:10px; display:flex; align-items:center; gap:8px; position:relative; z-index:1; }
    .ph-eyebrow::before { content:''; display:block; width:20px; height:1px; background:var(--gold); }
    .ph-name { font-family:'Nunito',sans-serif; font-size:28px; font-weight:800; color:white; margin-bottom:8px; position:relative; z-index:1; line-height:1.2; }
    .ph-price { font-family:'Nunito',sans-serif; font-size:40px; font-weight:800; color:var(--mauve); position:relative; z-index:1; line-height:1; }
    .ph-price span { font-size:20px; font-weight:400; color:rgba(255,255,255,0.4); margin-right:4px; }
    .ph-badges { display:flex; gap:8px; margin-top:16px; flex-wrap:wrap; position:relative; z-index:1; }

    /* Stock badge */
    .stock-badge { display:inline-flex; align-items:center; gap:5px; padding:5px 12px; border-radius:20px; font-size:11px; font-weight:700; }
    .stock-badge::before { content:''; width:5px; height:5px; border-radius:50%; background:currentColor; opacity:0.7; }
    .s-high { background:rgba(92,122,90,0.15); color:var(--deep-sage); border:1px solid rgba(92,122,90,0.22); }
    .s-low  { background:rgba(201,169,110,0.15); color:#8a6d2f; border:1px solid rgba(201,169,110,0.25); }
    .s-out  { background:rgba(180,80,80,0.1); color:#b05050; border:1px solid rgba(180,80,80,0.2); }
    .cat-badge { background:rgba(196,160,160,0.15); color:var(--deep-mauve); border:1px solid rgba(196,160,160,0.25); display:inline-flex; align-items:center; gap:5px; padding:5px 12px; border-radius:20px; font-size:11px; font-weight:700; }

    /* Detail panel */
    .detail-panel { background:var(--white); border-radius:var(--r); border:1px solid var(--border); overflow:hidden; box-shadow:var(--shadow-sm); }
    .dp-head { padding:18px 24px 14px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:10px; }
    .dp-icon { width:34px; height:34px; border-radius:9px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .dp-title { font-family:'Nunito',sans-serif; font-size:15px; font-weight:800; color:var(--charcoal); }
    .dp-body { padding:20px 24px; display:flex; flex-direction:column; gap:13px; }
    .dp-row { display:flex; justify-content:space-between; align-items:center; font-size:13px; padding:10px 14px; background:var(--ivory); border-radius:8px; }
    .dp-lbl { color:var(--warm-gray); font-weight:500; }
    .dp-val { font-weight:700; color:var(--charcoal); }
    .dp-val.green { color:var(--deep-sage); }
    .dp-desc { font-size:13px; color:var(--warm-gray); line-height:1.8; font-weight:300; padding:16px; background:var(--ivory); border-radius:8px; }

    /* Actions */
    .actions-row { display:flex; gap:10px; flex-wrap:wrap; }
    .btn-edit { display:inline-flex; align-items:center; gap:7px; padding:11px 24px; background:linear-gradient(135deg,var(--mauve),var(--deep-mauve)); color:white; border-radius:8px; font-size:12px; font-weight:700; letter-spacing:0.5px; text-transform:uppercase; text-decoration:none; transition:all 0.2s; }
    .btn-edit:hover { opacity:0.9; transform:translateY(-1px); }
    .btn-back { display:inline-flex; align-items:center; gap:7px; padding:11px 20px; background:var(--ivory); color:var(--warm-gray); border:1px solid var(--border); border-radius:8px; font-size:12px; font-weight:600; text-decoration:none; transition:all 0.2s; }
    .btn-back:hover { background:var(--parchment); color:var(--charcoal); }
    .btn-delete { display:inline-flex; align-items:center; gap:7px; padding:11px 20px; background:rgba(180,80,80,0.08); color:#b05050; border:1px solid rgba(180,80,80,0.18); border-radius:8px; font-size:12px; font-weight:600; cursor:pointer; transition:all 0.2s; font-family:'Figtree',sans-serif; }
    .btn-delete:hover { background:#e74c3c; color:white; border-color:#e74c3c; }

    @media (max-width:1000px) { .product-layout { grid-template-columns:1fr; } .product-img-card { position:static; } }
</style>

<div class="pw">
    <div class="product-layout">

        <!-- Left: Image -->
        <div class="product-img-card">
            <div class="product-img-wrap">
                {% if product.image %}
                    <img src="{{ asset('uploads/' ~ product.image) }}" alt="{{ product.name }}">
                {% else %}
                    <div class="product-img-placeholder">
                        <i data-lucide="shirt" style="width:80px;height:80px;stroke:rgba(196,160,160,0.3);stroke-width:0.75;"></i>
                    </div>
                {% endif %}
            </div>
            <div class="product-img-footer">
                <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="btn-edit" style="flex:1;justify-content:center;">
                    <i data-lucide="pencil" style="width:13px;height:13px;stroke:white;stroke-width:2;"></i> Edit
                </a>
                <form method="post" action="{{ path('app_product_delete', {'id': product.id}) }}" onsubmit="return confirm('Delete {{ product.name }}?');" style="flex:1;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                    <button type="submit" class="btn-delete" style="width:100%;justify-content:center;">
                        <i data-lucide="trash-2" style="width:13px;height:13px;stroke:currentColor;stroke-width:2;"></i> Delete
                    </button>
                </form>
            </div>
        </div>

        <!-- Right: Info -->
        <div class="info-stack">

            <!-- Hero panel -->
            <div class="product-hero-panel">
                <div class="ph-eyebrow">Product Details</div>
                <div class="ph-name">{{ product.name }}</div>
                <div class="ph-price"><span>₱</span>{{ product.price|number_format(2) }}</div>
                <div class="ph-badges">
                    {% if product.category %}
                        <span class="cat-badge">
                            <i data-lucide="tag" style="width:10px;height:10px;stroke:currentColor;stroke-width:2;"></i>
                            {{ product.category.name }}
                        </span>
                    {% endif %}
                    {% if product.stock <= 0 %}
                        <span class="stock-badge s-out">Out of Stock</span>
                    {% elseif product.stock < 20 %}
                        <span class="stock-badge s-low">Low Stock</span>
                    {% else %}
                        <span class="stock-badge s-high">In Stock</span>
                    {% endif %}
                </div>
            </div>

            <!-- Stock & Dates -->
            <div class="detail-panel">
                <div class="dp-head">
                    <div class="dp-icon" style="background:rgba(143,175,140,0.15);">
                        <i data-lucide="package" style="width:15px;height:15px;stroke:var(--deep-sage);stroke-width:1.75;"></i>
                    </div>
                    <span class="dp-title">Inventory & Dates</span>
                </div>
                <div class="dp-body">
                    <div class="dp-row">
                        <span class="dp-lbl">Stock Quantity</span>
                        <span class="dp-val {{ product.stock > 20 ? 'green' : '' }}">{{ product.stock }} units</span>
                    </div>
                    <div class="dp-row">
                        <span class="dp-lbl">Price</span>
                        <span class="dp-val">₱{{ product.price|number_format(2) }}</span>
                    </div>
                    <div class="dp-row">
                        <span class="dp-lbl">Created</span>
                        <span class="dp-val">{{ product.createdAt|date('M d, Y') }}</span>
                    </div>
                    <div class="dp-row">
                        <span class="dp-lbl">Last Updated</span>
                        <span class="dp-val">{{ product.updatedAt|date('M d, Y') }}</span>
                    </div>
                    {% if product.createdBy %}
                    <div class="dp-row">
                        <span class="dp-lbl">Added By</span>
                        <span class="dp-val">{{ product.createdBy.email|split('@')[0] }}</span>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Description -->
            {% if product.description %}
            <div class="detail-panel">
                <div class="dp-head">
                    <div class="dp-icon" style="background:rgba(201,169,110,0.12);">
                        <i data-lucide="file-text" style="width:15px;height:15px;stroke:var(--gold);stroke-width:1.75;"></i>
                    </div>
                    <span class="dp-title">Description</span>
                </div>
                <div class="dp-body">
                    <div class="dp-desc">{{ product.description }}</div>
                </div>
            </div>
            {% endif %}

            <!-- Actions -->
            <div class="actions-row">
                </a>
                <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="btn-edit">
                    <i data-lucide="pencil" style="width:13px;height:13px;stroke:white;stroke-width:2;"></i>
                    Edit Product
                </a>
            </div>

        </div>
    </div>
</div>
{% endblock %}
