{% extends 'base_login.html.twig' %}

{% block title %}Register - VeraBelle Collection{% endblock %}

{% block body %}
<div class="form-container">

    <h2 class="form-heading">Create account</h2>
    <p class="form-subheading">Join VeraBelle — it's free & lovely. ✨</p>

    {% for flash_error in app.flashes('verify_email_error') %}
        <div class="error-message">
            <i class="fas fa-exclamation-circle"></i>
            {{ flash_error }}
        </div>
    {% endfor %}

    {% if app.user %}
        <div class="success-message">
            <i class="fas fa-check-circle"></i>
            You are already logged in as {{ app.user.email }}.
            <a href="{{ path('app_logout') }}" style="color:var(--deep-mauve);font-weight:600;margin-left:4px;">Logout</a>
        </div>
    {% else %}

        {{ form_start(registrationForm, {'attr': {'class': 'registration-form'}}) }}
            {{ form_errors(registrationForm) }}

            <div class="form-group">
                <label for="{{ registrationForm.email.vars.id }}">Email Address</label>
                <div class="input-wrap">
                    <i class="input-icon fa-regular fa-envelope"></i>
                    {{ form_widget(registrationForm.email, {
                        'attr': {
                            'class': 'form-control',
                            'placeholder': 'you@example.com',
                            'autocomplete': 'email'
                        }
                    }) }}
                </div>
                <p class="form-help">We'll send a verification link to this email</p>
                {{ form_errors(registrationForm.email) }}
            </div>

            <div class="form-group">
                <label for="{{ registrationForm.plainPassword.vars.id }}">Password</label>
                <div class="input-wrap">
                    <i class="input-icon fa-regular fa-lock"></i>
                    {{ form_widget(registrationForm.plainPassword, {
                        'attr': {
                            'class': 'form-control',
                            'placeholder': '••••••••',
                            'autocomplete': 'new-password',
                            'id': 'reg-password'
                        }
                    }) }}
                    <button class="pw-toggle" type="button" onclick="toggleRegPw()" title="Show/hide password">
                        <i class="fa-regular fa-eye" id="regPwIcon"></i>
                    </button>
                </div>
                <p class="form-help">At least 8 characters with letters and numbers</p>
                <div class="strength-indicator" id="strengthIndicator" style="display:none;">
                    <div class="strength-text">Strength: <span class="strength-value">Weak</span></div>
                    <div class="strength-bar-container">
                        <div class="strength-bar" id="strengthBar"></div>
                    </div>
                </div>
                {{ form_errors(registrationForm.plainPassword) }}
            </div>

            <div class="terms-container">
                <label class="terms-label" for="{{ registrationForm.agreeTerms.vars.id }}">
                    {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'checkbox-hidden'}}) }}
                    <span class="custom-checkbox" id="customCheck"></span>
                    <span class="checkbox-text">
                        I agree to the
                        <a href="#" class="terms-link">Terms & Conditions</a>
                        and
                        <a href="#" class="terms-link">Privacy Policy</a>
                    </span>
                </label>
                {{ form_errors(registrationForm.agreeTerms) }}
            </div>

            <button type="submit" class="login-btn">
                <span>Create Account</span>
            </button>
        {{ form_end(registrationForm) }}

    {% endif %}

    <div class="form-footer">
        <p>Already have an account? <a href="{{ path('app_login') }}">Sign in</a></p>
        <p class="copy">VeraBelle Collection &nbsp;✦&nbsp; {{ "now"|date("Y") }}</p>
    </div>

</div>

<style>
    .input-wrap .form-control {
        width: 100%;
        padding: 13px 40px 13px 42px;
        background: rgba(239,230,216,0.5);
        border: 1.5px solid rgba(196,160,160,0.3);
        border-radius: 12px;
        font-family: 'Nunito', sans-serif;
        font-size: 14px;
        color: var(--charcoal);
        outline: none;
        transition: border-color 0.25s, background 0.25s, box-shadow 0.25s;
    }
    .input-wrap .form-control::placeholder { color: rgba(122,111,111,0.45); }
    .input-wrap .form-control:focus {
        background: #fff;
        border-color: var(--mauve);
        box-shadow: 0 0 0 3px rgba(196,160,160,0.12);
    }
    @keyframes shake {
        0%,100% { transform: translateX(0); }
        20%,60%  { transform: translateX(-5px); }
        40%,80%  { transform: translateX(5px); }
    }
</style>

<script>
    function toggleRegPw() {
        const input = document.getElementById('reg-password')
                   || document.querySelector('.input-wrap input[type="password"], .input-wrap input[type="text"]');
        const icon  = document.getElementById('regPwIcon');
        if (!input) return;
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        const customBox = document.getElementById('customCheck');
        const hiddenCb  = document.querySelector('.checkbox-hidden');

        function syncBox() {
            if (!customBox || !hiddenCb) return;
            if (hiddenCb.checked) {
                customBox.style.background  = '#9E6F6F';
                customBox.style.borderColor = '#9E6F6F';
                customBox.textContent       = '\u2713';
            } else {
                customBox.style.background  = 'rgba(239,230,216,0.45)';
                customBox.style.borderColor = 'rgba(196,160,160,0.5)';
                customBox.textContent       = '';
            }
        }

        if (customBox && hiddenCb) {
            customBox.addEventListener('click', function (e) {
                e.preventDefault(); e.stopPropagation();
                hiddenCb.checked = !hiddenCb.checked;
                syncBox();
            });
            const cbText = document.querySelector('.checkbox-text');
            if (cbText) {
                cbText.addEventListener('click', function (e) {
                    if (e.target.tagName === 'A') return;
                    e.preventDefault();
                    hiddenCb.checked = !hiddenCb.checked;
                    syncBox();
                });
            }
            hiddenCb.addEventListener('change', syncBox);
            syncBox();
        }

        const pwInput   = document.querySelector('input[autocomplete="new-password"]');
        const indicator = document.getElementById('strengthIndicator');
        const bar       = document.getElementById('strengthBar');
        const val       = document.querySelector('.strength-value');
        if (pwInput && indicator) {
            pwInput.addEventListener('input', function () {
                const p = this.value;
                if (!p) { indicator.style.display = 'none'; return; }
                indicator.style.display = 'block';
                let s = 0;
                if (p.length >= 8)           s += 25;
                if (/[A-Z]/.test(p))         s += 25;
                if (/[0-9]/.test(p))         s += 25;
                if (/[^A-Za-z0-9]/.test(p))  s += 25;
                bar.style.width = s + '%';
                const map = { 25:['#C4A0A0','Weak'], 50:['#e0c080','Fair'], 75:['#8FAF8C','Good'], 100:['#5C7A5A','Strong'] };
                const [color, text] = map[s] || map[25];
                bar.style.backgroundColor = color;
                val.textContent = text;
                val.style.color = color;
            });
        }

        const form = document.querySelector('.registration-form');
        if (form) {
            form.addEventListener('submit', function (e) {
                if (hiddenCb && !hiddenCb.checked) {
                    e.preventDefault();
                    const tc = document.querySelector('.terms-container');
                    tc.style.animation = 'none';
                    tc.offsetHeight;
                    tc.style.animation = 'shake 0.4s';
                    tc.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            });
        }
    });
</script>
{% endblock %}