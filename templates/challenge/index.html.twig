{% extends 'base_landing.html.twig' %}

{% block title %}Fashion Creator Challenge — VeraBelle Collection{% endblock %}
{% block meta_desc %}Join our Fashion Creator Challenge. Submit your designs or outfits, vote on entries, and win amazing rewards!{% endblock %}

{% block body %}
<style>
    :root {
        --ivory: #F9F4EE; --parchment: #EFE6D8; --mauve: #C4A0A0;
        --deep-mauve: #9E6F6F; --sage: #8FAF8C; --deep-sage: #5C7A5A;
        --charcoal: #3A3232; --warm-gray: #7A6F6F; --blush: #E8CECE;
        --forest: #2f4256; --terra: #C4785A; --cream: #F5F0E8;
        --serif: 'Playfair Display', Georgia, serif;
        --sans: 'DM Sans', system-ui, sans-serif;
    }
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: var(--sans); background: var(--ivory); color: var(--charcoal); }

    /* ── HERO ── */
    .ch-hero {
        min-height: 88vh;
        background: linear-gradient(to bottom, rgba(30,40,55,0.5) 0%, rgba(30,40,55,0.72) 100%),
                    url('/uploads/challenge-hero.jpg') center/cover no-repeat;
        display: flex; align-items: center; justify-content: center;
        position: relative; overflow: hidden; margin-top: 60px;
    }
    .ch-hero-inner {
        text-align: center; color: var(--cream);
        max-width: 820px; padding: 0 40px; position: relative; z-index: 2;
    }
    .ch-eyebrow {
        font-size: 10px; font-weight: 700; letter-spacing: 5px;
        text-transform: uppercase; color: var(--mauve);
        display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 24px;
    }
    .ch-eyebrow::before, .ch-eyebrow::after { content:''; display:block; width:40px; height:1px; background:var(--mauve); }
    .ch-hero h1 {
        font-family: var(--serif); font-size: clamp(52px, 8vw, 96px);
        font-weight: 300; line-height: 1.05; margin-bottom: 20px; letter-spacing: -0.02em;
    }
    .ch-hero h1 em { color: var(--mauve); font-style: italic; }
    .ch-hero p {
        font-size: 16px; font-weight: 300; line-height: 1.9;
        color: rgba(245,240,232,0.78); margin-bottom: 40px; max-width: 560px; margin-left: auto; margin-right: auto;
    }
    .ch-cta { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
    .btn-ch-primary {
        background: var(--mauve); color: white; padding: 15px 36px;
        border-radius: 10px; font-size: 12px; font-weight: 700; letter-spacing: 1.5px;
        text-transform: uppercase; text-decoration: none; border: none; cursor: pointer;
        transition: all 0.3s;
    }
    .btn-ch-primary:hover { background: var(--deep-mauve); transform: translateY(-2px); }
    .btn-ch-outline {
        background: transparent; color: var(--cream); padding: 15px 36px;
        border-radius: 10px; font-size: 12px; font-weight: 700; letter-spacing: 1.5px;
        text-transform: uppercase; text-decoration: none; border: 1.5px solid rgba(245,240,232,0.5);
        cursor: pointer; transition: all 0.3s;
    }
    .btn-ch-outline:hover { background: rgba(245,240,232,0.1); border-color: var(--cream); }

    /* ── STATS BAR ── */
    .stats-bar {
        background: var(--charcoal); color: var(--cream);
        display: flex; justify-content: center; gap: 0;
    }
    .stat-item {
        padding: 28px 56px; text-align: center;
        border-right: 1px solid rgba(255,255,255,0.08);
    }
    .stat-item:last-child { border-right: none; }
    .stat-num { font-family: var(--serif); font-size: 36px; font-weight: 300; color: var(--mauve); }
    .stat-label { font-size: 10px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: rgba(245,240,232,0.5); margin-top: 4px; }

    /* ── SHARED ── */
    .section-wrap { max-width: 1200px; margin: 0 auto; padding: 0 40px; }
    .steps-wrap { max-width: 1200px; margin: 0 auto; padding: 0 40px; }
    .section-head { text-align: center; margin: 100px 0 60px; }
    .s-eyebrow { font-size: 10px; font-weight: 700; letter-spacing: 4px; text-transform: uppercase; color: var(--terra); margin-bottom: 14px; }
    .s-title { font-family: var(--serif); font-size: clamp(34px, 5vw, 52px); font-weight: 300; color: var(--charcoal); }
    .s-title em { color: var(--deep-mauve); font-style: italic; }
    .s-desc { font-size: 15px; color: var(--warm-gray); max-width: 560px; margin: 16px auto 0; line-height: 1.8; font-weight: 300; }

    /* ── HOW IT WORKS ── */
    .steps-grid {
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px;
        margin-bottom: 100px; background: rgba(196,160,160,0.15);
    }
    .step-card {
        background: var(--ivory); padding: 48px 36px; position: relative;
        transition: background 0.3s;
    }
    .step-card:hover { background: white; }
    .step-num {
        font-family: var(--serif); font-size: 72px; font-weight: 300;
        color: rgba(196,160,160,0.25); line-height: 1; margin-bottom: 20px;
    }
    .step-title { font-family: var(--serif); font-size: 20px; font-weight: 400; color: var(--charcoal); margin-bottom: 12px; }
    .step-desc { font-size: 13px; color: var(--warm-gray); line-height: 1.8; font-weight: 300; }

    /* ── CURRENT CHALLENGE ── */
    .current-ch {
        background: linear-gradient(to bottom, rgba(30,40,55,0.62) 0%, rgba(30,40,55,0.82) 100%),
                    url('/uploads/challenge-rewards.jpg') center/cover no-repeat;
        padding: 100px 40px; color: var(--cream); margin: 0;
    }
    .current-ch-inner { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
    .current-ch h2 { font-family: var(--serif); font-size: clamp(36px, 5vw, 56px); font-weight: 300; margin-bottom: 12px; }
    .ch-dates { font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: var(--mauve); margin-bottom: 24px; }
    .ch-desc { font-size: 15px; line-height: 1.9; color: rgba(245,240,232,0.82); font-weight: 300; margin-bottom: 36px; }
    .ch-rules { display: flex; flex-direction: column; gap: 16px; }
    .rule-card {
        background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12);
        border-radius: 12px; padding: 18px 22px;
    }
    .rule-card strong { display: block; font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--mauve); margin-bottom: 6px; }
    .rule-card p { font-size: 13px; color: rgba(245,240,232,0.78); line-height: 1.7; margin: 0; }

    /* ── REWARDS ── */
    .rewards-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 100px; }
    .reward-card {
        background: white; border-radius: 16px; padding: 40px 32px;
        border: 1px solid rgba(196,160,160,0.15);
        transition: transform 0.3s, box-shadow 0.3s;
    }
    .reward-card:hover { transform: translateY(-8px); box-shadow: 0 20px 48px rgba(58,50,50,0.1); }
    .reward-icon { font-size: 44px; margin-bottom: 20px; }
    .reward-cat { font-size: 10px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: var(--terra); margin-bottom: 8px; }
    .reward-title { font-family: var(--serif); font-size: 22px; font-weight: 400; color: var(--charcoal); margin-bottom: 16px; }
    .reward-list { list-style: none; padding: 0; margin: 0; }
    .reward-list li { font-size: 13px; color: var(--warm-gray); padding: 6px 0; border-bottom: 1px solid rgba(239,230,216,0.6); line-height: 1.6; }
    .reward-list li:last-child { border-bottom: none; }

    /* ── BADGES ── */
    .badges-wrap { background: var(--parchment); padding: 80px 40px; }
    .badges-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 20px; margin-top: 56px; }
    .badge-card { text-align: center; }
    .badge-icon {
        width: 80px; height: 80px; margin: 0 auto 14px;
        background: linear-gradient(135deg, var(--mauve), var(--deep-mauve));
        border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 36px;
    }
    .badge-name { font-family: var(--serif); font-size: 13px; color: var(--charcoal); margin-bottom: 4px; }
    .badge-desc { font-size: 11px; color: var(--warm-gray); }

    /* ── FEATURES ── */
    .features-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 100px; }
    .feature-card {
        padding: 36px 28px; border-radius: 16px;
        background: white; border: 1px solid rgba(196,160,160,0.12);
        border-top: 3px solid var(--mauve);
        transition: transform 0.3s;
    }
    .feature-card:hover { transform: translateY(-4px); }
    .feature-icon { font-size: 36px; margin-bottom: 16px; }
    .feature-title { font-family: var(--serif); font-size: 18px; font-weight: 400; color: var(--charcoal); margin-bottom: 10px; }
    .feature-desc { font-size: 13px; color: var(--warm-gray); line-height: 1.8; font-weight: 300; }

    /* ── GALLERY ── */
    .gallery-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 100px; }
    .gallery-item {
        aspect-ratio: 3/4; border-radius: 12px;
        background: linear-gradient(135deg, var(--mauve), var(--blush));
        display: flex; align-items: center; justify-content: center;
        font-size: 56px; color: rgba(255,255,255,0.3);
        transition: transform 0.3s; cursor: pointer; overflow: hidden;
    }
    .gallery-item:hover { transform: scale(1.03); }

    /* ── CTA ── */
    .ch-cta-section {
        background: linear-gradient(135deg, var(--charcoal), var(--forest));
        padding: 100px 40px; text-align: center; color: var(--cream);
    }
    .ch-cta-section h2 { font-family: var(--serif); font-size: clamp(36px, 5vw, 56px); font-weight: 300; margin-bottom: 20px; }
    .ch-cta-section h2 em { color: var(--mauve); font-style: italic; }
    .ch-cta-section p { font-size: 16px; color: rgba(245,240,232,0.75); max-width: 560px; margin: 0 auto 40px; line-height: 1.8; font-weight: 300; }

    @media (max-width: 900px) {
        .ch-hero {
            min-height: auto;
            margin-top: 56px;
            padding: 88px 0 72px;
        }
        .ch-hero-inner { padding: 0 24px; }
        .ch-eyebrow { letter-spacing: 3px; gap: 10px; margin-bottom: 18px; }
        .ch-eyebrow::before, .ch-eyebrow::after { width: 26px; }
        .ch-hero h1 { font-size: clamp(38px, 10vw, 58px); margin-bottom: 16px; }
        .ch-hero p { font-size: 14px; line-height: 1.75; margin-bottom: 28px; }

        .steps-grid, .rewards-grid, .features-grid { grid-template-columns: 1fr; }
        .current-ch-inner { grid-template-columns: 1fr; gap: 40px; }
        .badges-grid { grid-template-columns: repeat(3, 1fr); }
        .gallery-grid { grid-template-columns: repeat(2, 1fr); }
        .stats-bar { flex-wrap: wrap; }
        .stat-item {
            width: 50%;
            padding: 20px 14px;
            border-right: 1px solid rgba(255,255,255,0.08);
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }
        .stat-item:nth-child(2n) { border-right: none; }
        .stat-item:nth-last-child(-n+2) { border-bottom: none; }

        .section-head { margin: 72px 0 42px; }
        .section-wrap { padding: 0 24px; }
        .steps-wrap { padding: 0 24px; }
        .current-ch { padding: 72px 24px; }
        .ch-dates { letter-spacing: 2px; }
        .ch-desc { font-size: 14px; line-height: 1.75; }
        .badges-wrap { padding: 64px 24px; }
        .ch-cta-section { padding: 74px 24px; }
        .ch-cta-section p { font-size: 14px; line-height: 1.75; }
    }

    @media (max-width: 640px) {
        .ch-cta {
            flex-direction: column;
            align-items: stretch;
            width: 100%;
        }
        .btn-ch-primary, .btn-ch-outline {
            width: 100%;
            text-align: center;
            justify-content: center;
            padding: 14px 18px;
        }

        .stat-num { font-size: 30px; }
        .stat-label { letter-spacing: 2px; }

        .section-wrap { padding: 0 18px; }
        .steps-wrap { padding: 0 18px; }
        .section-head { margin: 58px 0 34px; }
        .s-desc { font-size: 14px; line-height: 1.7; }

        .step-card, .reward-card, .feature-card { padding: 28px 22px; }
        .step-num { font-size: 56px; margin-bottom: 14px; }

        .badges-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
        .badge-icon { width: 68px; height: 68px; font-size: 28px; }
        .gallery-grid { grid-template-columns: 1fr; }

        .current-ch { padding: 62px 18px; }
        .current-ch h2 { font-size: clamp(30px, 9vw, 40px); }
        .ch-dates { font-size: 10px; letter-spacing: 1.2px; }
        .rule-card { padding: 16px 16px; }
    }
</style>

<!-- Hero -->
<section class="ch-hero">
    <div class="ch-hero-inner">
        <div class="ch-eyebrow">VeraBelle Community</div>
        <h1>Fashion Creator <em>Challenge</em></h1>
        <p>Show your creativity. Submit your designs or outfit styles. Win exclusive rewards and recognition in our growing community.</p>
        <div class="ch-cta">
            {% if activeChallenge %}
                <a href="{{ path('app_challenge_submit', {id: activeChallenge.id}) }}" class="btn-ch-primary">Submit Entry</a>
                <a href="{{ path('app_challenge_view', {id: activeChallenge.id}) }}" class="btn-ch-outline">View Entries</a>
            {% else %}
                <button class="btn-ch-primary" onclick="alert('No active challenge at the moment. Check back soon!')">Submit Entry</button>
            {% endif %}
            <a href="{{ path('app_challenge_hall_of_fame') }}" class="btn-ch-outline">🏆 Hall of Fame</a>
        </div>
    </div>
</section>

<!-- Stats Bar -->
<div class="stats-bar">
    <div class="stat-item">
        <div class="stat-num">500+</div>
        <div class="stat-label">Creators</div>
    </div>
    <div class="stat-item">
        <div class="stat-num">12</div>
        <div class="stat-label">Challenges</div>
    </div>
    <div class="stat-item">
        <div class="stat-num">₱50K+</div>
        <div class="stat-label">Prizes Awarded</div>
    </div>
    <div class="stat-item">
        <div class="stat-num">2K+</div>
        <div class="stat-label">Votes Cast</div>
    </div>
</div>

<!-- How It Works -->
<div class="section-wrap">
    <div class="section-head">
        <div class="s-eyebrow">How It Works</div>
        <h2 class="s-title">Six Simple <em>Steps</em></h2>
        <p class="s-desc">From challenge announcement to winning — here's how the journey unfolds.</p>
    </div>
</div>
<div class="steps-wrap">
    <div class="steps-grid">
        <div class="step-card"><div class="step-num">01</div><div class="step-title">Challenge Announced</div><div class="step-desc">Admin posts themed challenges like "Streetwear September" or "Minimalist Vibes."</div></div>
        <div class="step-card"><div class="step-num">02</div><div class="step-title">Submit Your Work</div><div class="step-desc">Upload outfit photos featuring VeraBelle pieces or share your original design sketches.</div></div>
        <div class="step-card"><div class="step-num">03</div><div class="step-title">Community Voting</div><div class="step-desc">Our community votes on the best entries across all submissions during voting stage.</div></div>
        <div class="step-card"><div class="step-num">04</div><div class="step-title">Winners Selected</div><div class="step-desc">Highest vote getters are crowned winners in their respective categories.</div></div>
        <div class="step-card"><div class="step-num">05</div><div class="step-title">Celebrate & Reward</div><div class="step-desc">Winners receive vouchers, free products, and featured recognition across our channels.</div></div>
        <div class="step-card"><div class="step-num">06</div><div class="step-title">Share Your Story</div><div class="step-desc">Join our Hall of Fame gallery and grow your creator profile with badges and achievements.</div></div>
    </div>
</div>

<!-- Current Challenge -->
<section class="current-ch">
    <div class="current-ch-inner">
        {% if activeChallenge %}
        <div>
            <div class="ch-dates">
                {{ activeChallenge.startDate|date('M d') }} – {{ activeChallenge.endDate|date('M d, Y') }}
                &nbsp;·&nbsp;
                {% if activeChallenge.isActive() %}Submission & Voting Open{% else %}{{ activeChallenge.status|capitalize }}{% endif %}
            </div>
            <h2>Current Challenge:<br><em>{{ activeChallenge.title }}</em></h2>
            {% if activeChallenge.theme %}
                <p class="ch-dates" style="margin-bottom:16px;font-style:italic;">{{ activeChallenge.theme }}</p>
            {% endif %}
            <p class="ch-desc">{{ activeChallenge.description }}</p>
            <a href="{{ path('app_challenge_submit', {id: activeChallenge.id}) }}" class="btn-ch-primary">Submit Your Entry →</a>
        </div>
        <div class="ch-rules">
            {% if activeChallenge.categories is defined and 'outfit' in activeChallenge.categories %}
            <div class="rule-card"><strong>📸 Outfit Category</strong><p>Submit 3–5 high-quality photos featuring VeraBelle pieces.</p></div>
            {% endif %}
            {% if activeChallenge.categories is defined and 'design' in activeChallenge.categories %}
            <div class="rule-card"><strong>✏️ Design Category</strong><p>Share original sketches or digital designs.</p></div>
            {% endif %}
            {% if activeChallenge.votingStartDate and activeChallenge.votingEndDate %}
            <div class="rule-card"><strong>🗳️ Voting Period</strong><p>{{ activeChallenge.votingStartDate|date('M d') }}–{{ activeChallenge.votingEndDate|date('M d, Y') }}. Community votes determine top 3 winners.</p></div>
            {% endif %}
            {% if activeChallenge.prizes is defined and activeChallenge.prizes %}
                {% if activeChallenge.prizes.outfit is defined and activeChallenge.prizes.outfit %}
                <div class="rule-card"><strong>🏆 Outfit Prize</strong><p>{{ activeChallenge.prizes.outfit }}</p></div>
                {% endif %}
                {% if activeChallenge.prizes.design is defined and activeChallenge.prizes.design %}
                <div class="rule-card"><strong>🎨 Design Prize</strong><p>{{ activeChallenge.prizes.design }}</p></div>
                {% endif %}
            {% endif %}
        </div>
        {% else %}
        <div style="text-align:center; padding: 60px 0;">
            <h2>No Active Challenge<br><em>Right Now</em></h2>
            <p class="ch-desc">Check back soon for our next fashion challenge.</p>
        </div>
        {% endif %}
    </div>
</section>

<!-- Rewards -->
<div class="section-wrap">
    <div class="section-head">
        <div class="s-eyebrow">What You Can Win</div>
        <h2 class="s-title">Amazing <em>Rewards</em></h2>
        <p class="s-desc">Every participant earns something. Winners take home life-changing prizes.</p>
    </div>
    <div class="rewards-grid">
        <div class="reward-card">
            <div class="reward-icon">👕</div>
            <div class="reward-cat">Outfit Winner</div>
            <div class="reward-title">Grand Prize</div>
            <ul class="reward-list">
                <li>₱5,000 VeraBelle voucher</li>
                <li>Free shipping for 6 months</li>
                <li>Exclusive VeraBelle gift set</li>
                <li>Homepage feature spotlight</li>
            </ul>
        </div>
        <div class="reward-card">
            <div class="reward-icon">✏️</div>
            <div class="reward-cat">Design Winner</div>
            <div class="reward-title">Design Collaboration</div>
            <ul class="reward-list">
                <li>Your design becomes a real product</li>
                <li>Free copy of your product</li>
                <li>"Guest Designer" recognition</li>
                <li>₱2,000 store credit + commission</li>
            </ul>
        </div>
        <div class="reward-card">
            <div class="reward-icon">⭐</div>
            <div class="reward-cat">All Participants</div>
            <div class="reward-title">Badges & Recognition</div>
            <ul class="reward-list">
                <li>Exclusive challenge badges</li>
                <li>Creator profile showcase</li>
                <li>Hall of Fame listing</li>
                <li>Community spotlight feature</li>
            </ul>
        </div>
    </div>
</div>

<!-- Badges -->
<div class="badges-wrap">
    <div class="section-wrap">
        <div class="section-head" style="margin-top:0;">
            <div class="s-eyebrow">Achievements</div>
            <h2 class="s-title">Earn <em>Badges</em></h2>
            <p class="s-desc">Unlock achievements as you participate and grow your creator reputation.</p>
        </div>
        <div class="badges-grid">
            <div class="badge-card"><div class="badge-icon">🥇</div><div class="badge-name">Challenge Winner</div><div class="badge-desc">Win any challenge</div></div>
            <div class="badge-card"><div class="badge-icon">🎨</div><div class="badge-name">Designer of Month</div><div class="badge-desc">Monthly top designer</div></div>
            <div class="badge-card"><div class="badge-icon">⭐</div><div class="badge-name">Rising Creator</div><div class="badge-desc">5+ entries submitted</div></div>
            <div class="badge-card"><div class="badge-icon">👑</div><div class="badge-name">Fashion Icon</div><div class="badge-desc">10+ challenge wins</div></div>
            <div class="badge-card"><div class="badge-icon">🌟</div><div class="badge-name">Community Fave</div><div class="badge-desc">1,000+ votes received</div></div>
            <div class="badge-card"><div class="badge-icon">💎</div><div class="badge-name">Collaborator</div><div class="badge-desc">Design turned product</div></div>
        </div>
    </div>
</div>

<!-- Features -->
<div class="section-wrap">
    <div class="section-head">
        <div class="s-eyebrow">Why Join</div>
        <h2 class="s-title">Unique <em>Features</em></h2>
    </div>
    <div class="features-grid">
        <div class="feature-card"><div class="feature-icon">📸</div><div class="feature-title">Creator Profiles</div><div class="feature-desc">Showcase your past entries, earned badges, and creative achievements in one beautiful profile.</div></div>
        <div class="feature-card"><div class="feature-icon">🏛️</div><div class="feature-title">Hall of Fame</div><div class="feature-desc">Get permanently featured in our Hall of Fame gallery. Your work lives forever on VeraBelle.</div></div>
        <div class="feature-card"><div class="feature-icon">📚</div><div class="feature-title">Challenge Archive</div><div class="feature-desc">Browse past challenges for inspiration. See winning entries and get ideas for your next submission.</div></div>
        <div class="feature-card"><div class="feature-icon">🌐</div><div class="feature-title">Social Sharing</div><div class="feature-desc">Share your entries on Instagram, TikTok, and Twitter. The VeraBelle community votes for you!</div></div>
        <div class="feature-card"><div class="feature-icon">🎯</div><div class="feature-title">Exclusive Preview</div><div class="feature-desc">Challenge winners get early access to new collections before public release.</div></div>
