{% extends 'base_dashboard.html.twig' %}

{% block title %}My Profile — VeraBelle Collection{% endblock %}
{% block page_title %}My Profile{% endblock %}

{% block content %}
<style>
    :root {
        --blush:#F0C4C4; --sage:#A8BCA1; --sage-deep:#7A9972;
        --ink:#1A1F2E; --ink-soft:#4A5568; --cream:#FAF8F5;
        --cream-warm:#F4F0EA; --gold:#C9A96E; --white:#FFFFFF;
        --border:rgba(26,31,46,0.08); --radius:16px; --radius-sm:10px;
        --shadow-md:0 8px 32px rgba(26,31,46,0.10);
    }
    * { font-family:'Figtree',sans-serif; box-sizing:border-box; }
    @keyframes fadeUp { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:translateY(0)} }

    /* ── HERO BANNER ── */
    .profile-hero {
        background: var(--ink); border-radius: var(--radius);
        padding: 40px 48px; margin-bottom: 24px;
        display: flex; align-items: center; gap: 32px;
        position: relative; overflow: hidden;
        animation: fadeUp 0.4s ease both;
    }
    .profile-hero::before { content:''; position:absolute; top:-60px; right:80px; width:260px; height:260px; background:radial-gradient(circle,rgba(240,196,196,0.13) 0%,transparent 65%); pointer-events:none; }
    .profile-hero::after  { content:''; position:absolute; bottom:-80px; right:-30px; width:280px; height:280px; background:radial-gradient(circle,rgba(168,188,161,0.10) 0%,transparent 65%); pointer-events:none; }

    .hero-avatar {
        width: 96px; height: 96px; border-radius: 50%; flex-shrink: 0;
        background: linear-gradient(135deg, var(--blush), var(--sage));
        display: flex; align-items: center; justify-content: center;
        font-family: 'Nunito', sans-serif; font-size: 38px; font-weight: 800; color: #fff;
        border: 3px solid rgba(255,255,255,0.15); position: relative; z-index: 1;
    }
    .hero-info { flex: 1; position: relative; z-index: 1; }
    .hero-eyebrow { font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold); font-weight: 600; margin-bottom: 6px; }
    .hero-name { font-family: 'Nunito', sans-serif; font-size: 28px; font-weight: 800; color: #fff; margin-bottom: 4px; }
    .hero-email { font-size: 13px; color: rgba(255,255,255,0.45); margin-bottom: 16px; }
    .hero-badges { display: flex; gap: 8px; flex-wrap: wrap; }
    .hero-badge { display: inline-flex; align-items: center; gap: 5px; padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: 700; }
    .badge-role     { background: rgba(240,196,196,0.15); color: var(--blush); border: 1px solid rgba(240,196,196,0.25); }
    .badge-verified { background: rgba(168,188,161,0.15); color: var(--sage); border: 1px solid rgba(168,188,161,0.25); }
    .badge-joined   { background: rgba(201,169,110,0.15); color: var(--gold); border: 1px solid rgba(201,169,110,0.25); }

    .hero-actions { display: flex; flex-direction: column; gap: 8px; position: relative; z-index: 1; flex-shrink: 0; }
    .btn-hero-dash { display: inline-flex; align-items: center; gap: 7px; padding: 10px 20px; background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.8); border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; text-decoration: none; font-size: 13px; font-weight: 600; transition: all 0.2s; white-space: nowrap; }
    .btn-hero-dash:hover { background: rgba(255,255,255,0.14); color: #fff; }
    .btn-hero-logout { display: inline-flex; align-items: center; gap: 7px; padding: 10px 20px; background: rgba(231,76,60,0.15); color: #ff8a80; border: 1px solid rgba(231,76,60,0.2); border-radius: 8px; text-decoration: none; font-size: 13px; font-weight: 600; transition: all 0.2s; white-space: nowrap; }
    .btn-hero-logout:hover { background: rgba(231,76,60,0.25); color: #fff; }

    /* ── GRID ── */
    .profile-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; animation: fadeUp 0.4s 0.1s ease both; }

    /* ── PANEL ── */
    .panel { background: var(--white); border-radius: var(--radius); border: 1px solid var(--border); overflow: hidden; }
    .panel.full { grid-column: 1 / -1; }
    .panel-header { padding: 20px 24px 16px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 10px; }
    .panel-icon { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .pi-blush { background: rgba(240,196,196,0.18); }
    .pi-sage  { background: rgba(168,188,161,0.18); }
    .pi-gold  { background: rgba(201,169,110,0.15); }
    .panel-title { font-family: 'Nunito', sans-serif; font-size: 15px; font-weight: 800; color: var(--ink); }
    .panel-body { padding: 24px; }

    /* ── INFO ROWS ── */
    .info-row { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; background: var(--cream); border-radius: 8px; margin-bottom: 10px; font-size: 13px; }
    .info-row:last-child { margin-bottom: 0; }
    .info-label { color: var(--ink-soft); font-weight: 500; }
    .info-value { font-weight: 700; color: var(--ink); }
    .info-value.green { color: var(--sage-deep); }
    .info-value.red   { color: #c0392b; }

    /* ── FORM ── */
    .form-group { margin-bottom: 18px; }
    .form-label { display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--ink-soft); margin-bottom: 7px; }
    .form-input { width: 100%; padding: 11px 14px; border: 2px solid #e2e8f0; border-radius: 8px; font-size: 14px; color: var(--ink); background: #f8f9fa; font-family: 'Figtree', sans-serif; transition: all 0.2s; }
    .form-input:focus { outline: none; border-color: var(--blush); background: #fff; box-shadow: 0 0 0 3px rgba(240,196,196,0.1); }
    .form-hint { font-size: 11px; color: var(--ink-soft); margin-top: 5px; font-style: italic; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

    .btn-submit { display: inline-flex; align-items: center; gap: 8px; padding: 11px 28px; background: linear-gradient(135deg, #F4C2C2, #A8BCA1); color: #fff; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.3s; font-family: 'Figtree', sans-serif; box-shadow: 0 4px 15px rgba(244,194,194,0.3); }
    .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(244,194,194,0.4); }

    /* ── FLASH ── */
    .flash { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-radius: var(--radius-sm); margin-bottom: 20px; font-size: 13px; font-weight: 500; animation: fadeUp 0.3s ease both; }
    .flash-success { background: rgba(122,153,114,0.10); border: 1px solid rgba(122,153,114,0.25); color: var(--sage-deep); }
    .flash-error   { background: rgba(231,76,60,0.08); border: 1px solid rgba(231,76,60,0.18); color: #c0392b; }

    @media (max-width: 900px) {
        .profile-hero { flex-direction: column; align-items: flex-start; padding: 28px 24px; }
        .hero-actions { flex-direction: row; }
        .profile-grid { grid-template-columns: 1fr; }
        .panel.full { grid-column: 1; }
        .form-row { grid-template-columns: 1fr; }
    }
</style>

{% for msg in app.flashes('success') %}
    <div class="flash flash-success"><i data-lucide="check-circle" style="width:16px;height:16px;stroke:currentColor;stroke-width:2;flex-shrink:0;"></i>{{ msg }}</div>
{% endfor %}
{% for msg in app.flashes('error') %}
    <div class="flash flash-error"><i data-lucide="alert-circle" style="width:16px;height:16px;stroke:currentColor;stroke-width:2;flex-shrink:0;"></i>{{ msg }}</div>
{% endfor %}

<!-- Hero Banner -->
<div class="profile-hero">
    <div class="hero-avatar">{{ app.user.email|slice(0,1)|upper }}</div>
    <div class="hero-info">
        <div class="hero-eyebrow">Account Profile</div>
        <div class="hero-name">{{ app.user.email|split('@')[0] }}</div>
        <div class="hero-email">{{ app.user.email }}</div>
        <div class="hero-badges">
            <span class="hero-badge badge-role">
                <i data-lucide="shield" style="width:10px;height:10px;stroke:currentColor;stroke-width:2;"></i>
                {% for role in app.user.roles %}{% if role != 'ROLE_USER' %}{{ role|replace({'ROLE_':''}) }}{% endif %}{% endfor %}
            </span>
            <span class="hero-badge badge-verified">
                <i data-lucide="check" style="width:10px;height:10px;stroke:currentColor;stroke-width:2.5;"></i>
                {{ app.user.isVerified ? 'Verified' : 'Unverified' }}
            </span>
            <span class="hero-badge badge-joined">
                <i data-lucide="calendar" style="width:10px;height:10px;stroke:currentColor;stroke-width:2;"></i>
                Joined {{ app.user.createdAt|date('M Y') }}
            </span>
        </div>
    </div>
    <div class="hero-actions">
        <a href="{{ path('app_dashboard') }}" class="btn-hero-dash">
            <i data-lucide="layout-dashboard" style="width:14px;height:14px;stroke:currentColor;stroke-width:1.75;"></i>
            Dashboard
        </a>
        <a href="{{ path('app_logout') }}" class="btn-hero-logout">
            <i data-lucide="log-out" style="width:14px;height:14px;stroke:currentColor;stroke-width:2;"></i>
            Sign Out
        </a>
    </div>
</div>

<!-- Grid -->
<div class="profile-grid">

    <!-- Account Info -->
    <div class="panel">
        <div class="panel-header">
            <div class="panel-icon pi-sage"><i data-lucide="user" style="width:16px;height:16px;stroke:var(--sage-deep);stroke-width:1.75;"></i></div>
            <span class="panel-title">Account Information</span>
        </div>
        <div class="panel-body">
            <div class="info-row">
                <span class="info-label">Email</span>
                <span class="info-value">{{ app.user.email }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Status</span>
                <span class="info-value green">{{ app.user.status|capitalize }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Verified</span>
                <span class="info-value {{ app.user.isVerified ? 'green' : 'red' }}">
                    {{ app.user.isVerified ? '✓ Yes' : '✗ No' }}
                </span>
            </div>
            <div class="info-row">
                <span class="info-label">Member Since</span>
                <span class="info-value">{{ app.user.createdAt|date('M d, Y') }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Role</span>
                <span class="info-value">
                    {% for role in app.user.roles %}{% if role != 'ROLE_USER' %}{{ role|replace({'ROLE_':''}) }}{% endif %}{% endfor %}
                </span>
            </div>
        </div>
    </div>

    <!-- Change Password -->
    <div class="panel">
        <div class="panel-header">
            <div class="panel-icon pi-blush"><i data-lucide="lock" style="width:16px;height:16px;stroke:#b86060;stroke-width:1.75;"></i></div>
            <span class="panel-title">Change Password</span>
        </div>
        <div class="panel-body">
            <form method="POST" action="{{ path('app_profile_change_password') }}">
                <div class="form-group">
                    <label class="form-label">Current Password</label>
                    <input type="password" name="current_password" class="form-input" placeholder="Enter current password" required>
                </div>
                <div class="form-group">
                    <label class="form-label">New Password</label>
                    <input type="password" name="new_password" class="form-input" placeholder="Min. 8 characters" required>
                    <div class="form-hint">At least 8 characters long</div>
                </div>
                <div class="form-group">
                    <label class="form-label">Confirm New Password</label>
                    <input type="password" name="confirm_password" class="form-input" placeholder="Repeat new password" required>
                </div>
                <button type="submit" class="btn-submit">
                    <i data-lucide="save" style="width:14px;height:14px;stroke:white;stroke-width:2;"></i>
                    Update Password
                </button>
            </form>
        </div>
    </div>

</div>
{% endblock %}
