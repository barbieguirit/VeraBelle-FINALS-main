{% extends 'base_dashboard.html.twig' %}

{% block title %}User Management - VeraBelle Collection{% endblock %}
{% block page_title %}User Management{% endblock %}

{% block content %}
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Figtree:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
    :root {
        --blush:      #F0C4C4;
        --sage:       #A8BCA1;
        --sage-deep:  #7A9972;
        --ink:        #1A1F2E;
        --ink-soft:   #4A5568;
        --cream:      #FAF8F5;
        --cream-warm: #F4F0EA;
        --gold:       #C9A96E;
        --white:      #FFFFFF;
        --border:     rgba(26,31,46,0.08);
        --shadow-sm:  0 2px 12px rgba(26,31,46,0.06);
        --shadow-md:  0 8px 32px rgba(26,31,46,0.10);
        --radius:     16px;
        --radius-sm:  10px;
    }

    * { font-family: 'Figtree', sans-serif; box-sizing: border-box; }

    /* ── PAGE HEADER ─────────────────────────────── */
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 28px;
        gap: 16px;
        flex-wrap: wrap;
        animation: fadeUp 0.4s ease both;
    }

    .page-header-left { display: flex; flex-direction: column; gap: 4px; }

    .page-eyebrow {
        font-size: 10px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--gold);
        font-weight: 600;
    }

    .page-title {
        font-family: 'Nunito', sans-serif;
        font-size: 26px;
        font-weight: 800;
        color: var(--ink);
        line-height: 1;
    }

    .page-subtitle {
        font-size: 13px;
        color: var(--ink-soft);
        font-weight: 400;
        margin-top: 2px;
    }

    .btn-add {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 22px;
        background: var(--ink);
        color: #fff;
        border-radius: 40px;
        text-decoration: none;
        font-size: 13.5px;
        font-weight: 600;
        transition: all 0.22s ease;
        box-shadow: 0 4px 16px rgba(26,31,46,0.18);
        white-space: nowrap;
    }

    .btn-add:hover {
        background: var(--ink-soft);
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(26,31,46,0.22);
        color: #fff;
    }

    .btn-add .plus-icon {
        width: 22px; height: 22px;
        background: linear-gradient(135deg, var(--blush), var(--sage));
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 14px; font-weight: 700;
        flex-shrink: 0;
    }

    /* ── ALERTS ──────────────────────────────────── */
    .alert {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 18px;
        border-radius: var(--radius-sm);
        margin-bottom: 20px;
        font-size: 13.5px;
        font-weight: 500;
        animation: fadeUp 0.3s ease both;
    }

    .alert-success {
        background: rgba(122,153,114,0.10);
        border: 1px solid rgba(122,153,114,0.25);
        color: var(--sage-deep);
    }

    .alert-danger {
        background: rgba(231,76,60,0.08);
        border: 1px solid rgba(231,76,60,0.2);
        color: #c0392b;
    }

    /* ── FILTER BAR ──────────────────────────────── */
    .filter-bar {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 18px 22px;
        margin-bottom: 24px;
        display: flex;
        align-items: flex-end;
        gap: 14px;
        flex-wrap: wrap;
        animation: fadeUp 0.4s 0.1s ease both;
    }

    .filter-group { display: flex; flex-direction: column; gap: 6px; flex: 1; min-width: 160px; }

    .filter-group label {
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-soft);
    }

    .filter-group input,
    .filter-group select {
        padding: 9px 13px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--cream);
        font-size: 13px;
        color: var(--ink);
        outline: none;
        transition: all 0.2s;
        font-family: 'Figtree', sans-serif;
        appearance: none;
    }

    .filter-group input:focus,
    .filter-group select:focus {
        border-color: var(--blush);
        background: var(--white);
        box-shadow: 0 0 0 3px rgba(240,196,196,0.15);
    }

    .filter-actions { display: flex; gap: 8px; flex-shrink: 0; }

    .btn-filter {
        padding: 9px 20px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        border: none;
        font-family: 'Figtree', sans-serif;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
    }

    .btn-filter.apply {
        background: var(--ink);
        color: #fff;
    }

    .btn-filter.apply:hover { background: var(--ink-soft); }

    .btn-filter.clear {
        background: var(--cream);
        color: var(--ink-soft);
        border: 1px solid var(--border);
    }

    .btn-filter.clear:hover { background: var(--cream-warm); color: var(--ink); }

    /* ── USERS CARDS GRID ─────────────────────────── */
    .users-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 16px;
        animation: fadeUp 0.4s 0.18s ease both;
    }

    .user-card {
        background: var(--white);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        overflow: hidden;
        transition: all 0.22s ease;
        display: flex;
        flex-direction: column;
    }

    .user-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-md);
        border-color: transparent;
    }

    .user-card.role-admin { border-top: 3px solid var(--blush); }
    .user-card.role-staff { border-top: 3px solid var(--sage); }

    /* Card header */
    .card-header {
        padding: 16px 20px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        border-bottom: 1px solid var(--border);
    }

    .user-avatar {
        width: 40px; height: 40px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--blush), var(--sage));
        display: flex; align-items: center; justify-content: center;
        font-family: 'Nunito', sans-serif;
        font-size: 16px; font-weight: 800;
        color: #fff;
        flex-shrink: 0;
    }

    .user-card.role-staff .user-avatar {
        background: linear-gradient(135deg, var(--sage), #6fa870);
    }

    .card-user-info { flex: 1; min-width: 0; }

    .card-username {
        font-family: 'Nunito', sans-serif;
        font-size: 14px;
        font-weight: 800;
        color: var(--ink);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 2px;
    }

    .card-email {
        font-size: 11px;
        color: var(--ink-soft);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .card-badges {
        display: flex;
        gap: 6px;
        align-items: center;
        flex-shrink: 0;
        flex-direction: column;
        align-items: flex-end;
    }

    .role-badge {
        font-size: 9.5px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 3px 9px;
        border-radius: 999px;
    }

    .badge-admin {
        background: rgba(231,76,60,0.09);
        color: #c0392b;
        border: 1px solid rgba(231,76,60,0.2);
    }

    .badge-staff {
        background: rgba(52,152,219,0.10);
        color: #2874a6;
        border: 1px solid rgba(52,152,219,0.2);
    }

    .status-badge {
        font-size: 9.5px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 3px 9px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .status-badge::before {
        content: '';
        width: 5px; height: 5px;
        border-radius: 50%;
        background: currentColor;
    }

    .status-active {
        background: rgba(122,153,114,0.12);
        color: var(--sage-deep);
        border: 1px solid rgba(122,153,114,0.22);
    }

    .status-disabled {
        background: rgba(149,165,166,0.12);
        color: #7f8c8d;
        border: 1px solid rgba(149,165,166,0.22);
    }

    /* Card body */
    .card-body {
        padding: 14px 20px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        flex: 1;
    }

    .card-meta-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
    }

    .meta-label {
        color: var(--ink-soft);
        font-weight: 500;
        min-width: 60px;
    }

    .meta-value {
        color: var(--ink);
        font-weight: 600;
        font-family: 'Nunito', sans-serif;
        font-size: 12.5px;
    }

    /* Card footer / actions */
    .card-footer {
        padding: 12px 20px;
        background: var(--cream);
        border-top: 1px solid var(--border);
        display: flex;
        gap: 8px;
    }

    .btn-action {
        flex: 1;
        padding: 7px 10px;
        border-radius: 8px;
        font-size: 11.5px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.18s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        border: 1px solid transparent;
        font-family: 'Figtree', sans-serif;
        white-space: nowrap;
    }

    .btn-edit {
        background: rgba(240,196,196,0.14);
        color: #b86060;
        border-color: rgba(240,196,196,0.3);
    }

    .btn-edit:hover { background: var(--blush); color: #fff; border-color: var(--blush); }

    .btn-disable {
        background: rgba(243,156,18,0.12);
        color: #d68910;
        border-color: rgba(243,156,18,0.25);
    }

    .btn-disable:hover { background: #f39c12; color: #fff; border-color: #f39c12; }

    .btn-enable {
        background: rgba(122,153,114,0.12);
        color: var(--sage-deep);
        border-color: rgba(122,153,114,0.25);
    }

    .btn-enable:hover { background: var(--sage-deep); color: #fff; border-color: var(--sage-deep); }

    .btn-delete {
        background: rgba(231,76,60,0.07);
        color: #c0392b;
        border-color: rgba(231,76,60,0.18);
    }

    .btn-delete:hover { background: #e74c3c; color: #fff; border-color: #e74c3c; }

    /* ── EMPTY STATE ─────────────────────────────── */
    .empty-state {
        grid-column: 1 / -1;
        text-align: center;
        padding: 70px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

    .empty-icon {
        width: 64px; height: 64px;
        background: var(--cream-warm);
        border-radius: 20px;
        display: flex; align-items: center; justify-content: center;
        font-size: 28px;
        margin-bottom: 4px;
    }

    .empty-state h3 {
        font-family: 'Nunito', sans-serif;
        font-size: 17px; font-weight: 800;
        color: var(--ink);
    }

    .empty-state p { font-size: 13px; color: var(--ink-soft); }

    /* ── ANIMATIONS ──────────────────────────────── */
    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(14px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .user-card { animation: fadeUp 0.35s ease both; }
    {% for i in 1..50 %}
    .user-card:nth-child({{ i }}) { animation-delay: {{ (i * 0.04)|round(2) }}s; }
    {% endfor %}

    /* ── RESPONSIVE ──────────────────────────────── */
    @media (max-width: 900px) {
        .users-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 600px) {
        .page-header { flex-direction: column; align-items: flex-start; }
        .users-grid { grid-template-columns: 1fr; }
        .filter-bar { flex-direction: column; }
        .filter-group { min-width: 100%; }
    }
</style>

<div class="container-fluid" style="padding: 40px 30px;">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            ✅ <strong>Success:</strong> {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger">
            ❌ <strong>Error:</strong> {{ message }}
        </div>
    {% endfor %}

    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-left">
            <div class="page-eyebrow">Users</div>
            <h1 class="page-title">User Management</h1>
            <div class="page-subtitle">Manage customer and staff accounts</div>
        </div>
        <a href="{{ path('app_admin_users_new') }}" class="btn-add">
            <div class="plus-icon">+</div>
            Add User
        </a>
    </div>

    <!-- Filters Section -->
    <form method="GET" class="filter-bar">
        <div class="filter-group" style="min-width: 180px;">
            <label>Search Name</label>
            <input type="text" name="search" placeholder="John Doe..." value="{{ search ?? '' }}">
        </div>

        <div class="filter-group" style="min-width: 150px;">
            <label>Status</label>
            <select name="status">
                <option value="">All</option>
                <option value="active" {% if status == 'active' %}selected{% endif %}>Active</option>
                <option value="disabled" {% if status == 'disabled' %}selected{% endif %}>Disabled</option>
            </select>
        </div>

        <div class="filter-group" style="min-width: 150px;">
            <label>Role</label>
            <select name="role">
                <option value="">All</option>
                <option value="ROLE_ADMIN" {% if role == 'ROLE_ADMIN' %}selected{% endif %}>Admin</option>
                <option value="ROLE_STAFF" {% if role == 'ROLE_STAFF' %}selected{% endif %}>Staff</option>
            </select>
        </div>

        <div class="filter-actions">
            <button type="submit" class="btn-filter apply">Apply</button>
            <a href="{{ path('app_admin_users_index') }}" class="btn-filter clear">Clear</a>
        </div>
    </form>

    <!-- Users Cards Grid -->
    <div class="users-grid">
        {% if users|length > 0 %}
            {% for user in users %}
                <div class="user-card {% if 'ROLE_ADMIN' in user.roles %}role-admin{% elseif 'ROLE_STAFF' in user.roles %}role-staff{% endif %}">
                    <!-- Card Header -->
                    <div class="card-header">
                        <div class="user-avatar">{{ user.email|slice(0, 1)|upper }}</div>
                        <div class="card-user-info">
                            <div class="card-username">{{ user.email }}</div>
                            <div class="card-email">{{ user.email }}</div>
                        </div>
                        <div class="card-badges">
                            {% if 'ROLE_ADMIN' in user.roles %}
                                <span class="role-badge badge-admin">Admin</span>
                            {% elseif 'ROLE_STAFF' in user.roles %}
                                <span class="role-badge badge-staff">Staff</span>
                            {% endif %}
                            {% if user.status == 'active' %}
                                <span class="status-badge status-active">Active</span>
                            {% else %}
                                <span class="status-badge status-disabled">Disabled</span>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Card Body -->
                    <div class="card-body">
                        <div class="card-meta-row">
                            <span class="meta-label">ID:</span>
                            <span class="meta-value">#{{ user.id }}</span>
                        </div>
                        <div class="card-meta-row">
                            <span class="meta-label">Joined:</span>
                            <span class="meta-value">{{ user.createdAt|date('M d, Y') }}</span>
                        </div>
                        {% if user.isVerified %}
                            <div class="card-meta-row">
                                <span class="meta-label">Verified:</span>
                                <span class="meta-value" style="color: var(--sage-deep);">✓ Yes</span>
                            </div>
                        {% endif %}
                    </div>

                    <!-- Card Footer / Actions -->
                    <div class="card-footer">
                        <a href="{{ path('app_admin_users_edit', { id: user.id }) }}" class="btn-action btn-edit">Edit</a>
                        <form method="POST" action="{{ path('app_admin_users_toggle_status', { id: user.id }) }}" style="flex: 1;">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle_status_' ~ user.id) }}">
                            <button type="submit" class="btn-action {% if user.status == 'active' %}btn-disable{% else %}btn-enable{% endif %}" style="width: 100%;" onclick="return confirm('{% if user.status == 'active' %}Disable{% else %}Enable{% endif %} this user?');">{% if user.status == 'active' %}Disable{% else %}Enable{% endif %}</button>
                        </form>
                        <form method="POST" action="{{ path('app_admin_users_delete', { id: user.id }) }}" style="flex: 0 0 auto;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
                            <button type="submit" class="btn-action btn-delete" onclick="return confirm('Delete user? This cannot be undone!');">Delete</button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <div class="empty-state">
                <div class="empty-icon">👤</div>
                <h3>No Users Found</h3>
                <p>No users match your search criteria. Try adjusting your filters or create a new user.</p>
            </div>
        {% endif %}
    </div>
</div>

{% endblock %}