{% extends 'base_dashboard.html.twig' %}

{% block title %}Admin Dashboard — VeraBelle Collection{% endblock %}
{% block page_title %}Admin Dashboard{% endblock %}

{% block content %}
<style>
    :root {
        --mauve:#C4A0A0; --deep-mauve:#9E6F6F; --sage:#8FAF8C; --deep-sage:#5C7A5A;
        --charcoal:#3A3232; --warm-gray:#7A6F6F; --ivory:#F9F4EE; --parchment:#EFE6D8;
        --blush:#E8CECE; --gold:#C9A96E; --white:#FFFFFF;
        --border:rgba(58,50,50,0.08); --shadow-sm:0 2px 12px rgba(58,50,50,0.06);
        --shadow-md:0 8px 32px rgba(58,50,50,0.10); --r:16px; --r-sm:10px;
    }
    * { font-family:'Figtree',sans-serif; box-sizing:border-box; }
    @keyframes up { from{opacity:0;transform:translateY(16px)} to{opacity:1;transform:translateY(0)} }

    /* Hero */
    .hero {
        background: linear-gradient(135deg, #2A2020 0%, var(--charcoal) 100%);
        border-radius: var(--r); padding: 40px 48px; margin-bottom: 24px;
        display: flex; align-items: center; justify-content: space-between;
        position: relative; overflow: hidden; animation: up 0.4s ease both;
        border: 1px solid rgba(196,160,160,0.1);
    }
    .hero::before { content:''; position:absolute; top:-80px; right:80px; width:320px; height:320px; background:radial-gradient(circle,rgba(196,160,160,0.12) 0%,transparent 65%); pointer-events:none; }
    .hero::after  { content:''; position:absolute; bottom:-80px; right:-40px; width:280px; height:280px; background:radial-gradient(circle,rgba(143,175,140,0.08) 0%,transparent 65%); pointer-events:none; }
    .hero-left { position:relative; z-index:1; }
    .hero-tag { display:inline-flex; align-items:center; gap:8px; font-size:10px; font-weight:700; letter-spacing:4px; text-transform:uppercase; color:var(--gold); margin-bottom:12px; }
    .hero-tag::before { content:''; display:block; width:24px; height:1px; background:var(--gold); }
    .hero-name { font-family:'Nunito',sans-serif; font-size:34px; font-weight:800; color:#fff; line-height:1.1; margin-bottom:8px; }
    .hero-name em { font-style:italic; color:var(--mauve); }
    .hero-sub { font-size:13px; color:rgba(255,255,255,0.38); font-weight:300; }
    .hero-right { position:relative; z-index:1; text-align:right; }
    .hero-day { font-family:'Nunito',sans-serif; font-size:80px; font-weight:800; color:rgba(255,255,255,0.06); line-height:1; }
    .hero-date { font-size:11px; letter-spacing:2px; text-transform:uppercase; color:rgba(255,255,255,0.25); margin-top:-8px; }

    /* Metrics */
    .metrics { display:grid; grid-template-columns:repeat(6,1fr); gap:14px; margin-bottom:24px; animation:up 0.4s 0.08s ease both; }
    .mc { background:var(--white); border-radius:var(--r-sm); padding:20px 18px; border:1px solid var(--border); position:relative; overflow:hidden; transition:all 0.22s; text-decoration:none; display:block; }
    .mc:hover { transform:translateY(-4px); box-shadow:var(--shadow-md); border-color:transparent; }
    .mc::after { content:''; position:absolute; bottom:0; left:0; right:0; height:3px; opacity:0; transition:opacity 0.22s; border-radius:0 0 var(--r-sm) var(--r-sm); }
    .mc:hover::after { opacity:1; }
    .mc.m1::after { background:linear-gradient(90deg,var(--mauve),var(--deep-mauve)); }
    .mc.m2::after { background:linear-gradient(90deg,var(--sage),var(--deep-sage)); }
    .mc.m3::after { background:linear-gradient(90deg,var(--gold),#b8924a); }
    .mc.m4::after { background:linear-gradient(90deg,var(--mauve),var(--sage)); }
    .mc.m5::after { background:linear-gradient(90deg,var(--deep-sage),#3a5238); }
    .mc.m6::after { background:linear-gradient(90deg,var(--gold),var(--mauve)); }
    .mc-icon { width:38px; height:38px; border-radius:10px; display:flex; align-items:center; justify-content:center; margin-bottom:14px; }
    .mc.m1 .mc-icon { background:rgba(196,160,160,0.15); }
    .mc.m2 .mc-icon { background:rgba(143,175,140,0.15); }
    .mc.m3 .mc-icon { background:rgba(201,169,110,0.12); }
    .mc.m4 .mc-icon { background:rgba(196,160,160,0.1); }
    .mc.m5 .mc-icon { background:rgba(92,122,90,0.12); }
    .mc.m6 .mc-icon { background:rgba(201,169,110,0.1); }
    .mc-val { font-family:'Nunito',sans-serif; font-size:26px; font-weight:800; color:var(--charcoal); line-height:1; margin-bottom:4px; }
    .mc-lbl { font-size:11px; color:var(--warm-gray); font-weight:500; text-transform:uppercase; letter-spacing:0.05em; }

    /* Grid */
    .dash-grid { display:grid; grid-template-columns:1fr 360px; gap:20px; animation:up 0.4s 0.15s ease both; }

    /* Panel */
    .panel { background:var(--white); border-radius:var(--r); border:1px solid var(--border); overflow:hidden; }
    .ph { padding:20px 24px 16px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--border); }
    .pt { font-family:'Nunito',sans-serif; font-size:15px; font-weight:800; color:var(--charcoal); }
    .pl { font-size:12px; color:var(--deep-sage); text-decoration:none; font-weight:600; transition:color 0.2s; }
    .pl:hover { color:var(--charcoal); }

    /* Activity */
    .act-list { padding:4px 0; max-height:480px; overflow-y:auto; }
    .act-list::-webkit-scrollbar { width:3px; }
    .act-list::-webkit-scrollbar-thumb { background:var(--border); border-radius:2px; }
    .ai { display:flex; align-items:flex-start; gap:12px; padding:13px 24px; transition:background 0.15s; }
    .ai:hover { background:var(--ivory); }
    .ai-ic { width:34px; height:34px; border-radius:9px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .ic-login  { background:rgba(143,175,140,0.15); }
    .ic-logout { background:rgba(122,111,111,0.1); }
    .ic-create { background:rgba(196,160,160,0.15); }
    .ic-update { background:rgba(201,169,110,0.12); }
    .ic-delete { background:rgba(180,80,80,0.1); }
    .ic-other  { background:rgba(196,160,160,0.1); }
    .ai-body { flex:1; min-width:0; }
    .ai-user { font-size:13px; font-weight:700; color:var(--charcoal); margin-bottom:2px; }
    .ai-role { font-size:9px; font-weight:700; letter-spacing:1px; text-transform:uppercase; padding:2px 7px; border-radius:20px; margin-left:6px; }
    .r-admin { background:rgba(196,160,160,0.15); color:var(--deep-mauve); }
    .r-staff { background:rgba(143,175,140,0.15); color:var(--deep-sage); }
    .ai-detail { font-size:12px; color:var(--warm-gray); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .ai-time { font-size:11px; color:rgba(122,111,111,0.5); margin-top:2px; }

    /* Quick actions */
    .qa-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; padding:16px; }
    .qa { display:flex; flex-direction:column; gap:8px; padding:16px 14px; border-radius:12px; background:var(--ivory); border:1px solid var(--border); text-decoration:none; transition:all 0.2s; }
    .qa:hover { background:var(--white); transform:translateY(-2px); box-shadow:var(--shadow-sm); }
    .qa-ic { width:34px; height:34px; border-radius:9px; display:flex; align-items:center; justify-content:center; }
    .qa-t { font-size:12.5px; font-weight:700; color:var(--charcoal); }
    .qa-d { font-size:11px; color:var(--warm-gray); line-height:1.4; }

    /* Store stats */
    .stat-row { display:flex; justify-content:space-between; align-items:center; padding:12px 16px; background:var(--ivory); border-radius:8px; margin-bottom:8px; font-size:13px; }
    .stat-row:last-child { margin-bottom:0; }
    .stat-lbl { color:var(--warm-gray); font-weight:500; }
    .stat-val { font-family:'Nunito',sans-serif; font-weight:800; color:var(--charcoal); }
    .stat-val.green { color:var(--deep-sage); }

    .empty { text-align:center; padding:40px 20px; color:var(--warm-gray); }
    .empty p { font-size:13px; margin-top:8px; }

    @media (max-width:1300px) { .metrics { grid-template-columns:repeat(3,1fr); } }
    @media (max-width:1100px) { .dash-grid { grid-template-columns:1fr; } }
    @media (max-width:768px)  { .metrics { grid-template-columns:repeat(2,1fr); } .hero { padding:28px 24px; flex-direction:column; gap:16px; align-items:flex-start; } }
</style>

<!-- Hero -->
<div class="hero">
    <div class="hero-left">
        <div class="hero-tag">Admin Overview</div>
        <div class="hero-name">Welcome, <em>{{ app.user.email|split('@')[0] }}</em></div>
        <div class="hero-sub">Full admin access · All data visible</div>
    </div>
    <div class="hero-right">
        <div class="hero-day">{{ "now"|date("d") }}</div>
        <div class="hero-date">{{ "now"|date("l, F Y") }}</div>
    </div>
</div>

<!-- Metrics -->
<div class="metrics">
    <a href="{{ path('app_admin_users_index') }}" class="mc m1">
        <div class="mc-icon"><i data-lucide="users" style="width:18px;height:18px;stroke:var(--deep-mauve);stroke-width:1.75;"></i></div>
        <div class="mc-val">{{ totalUsers }}</div><div class="mc-lbl">Total Users</div>
    </a>
    <a href="{{ path('app_admin_users_index') }}" class="mc m2">
        <div class="mc-icon"><i data-lucide="user-check" style="width:18px;height:18px;stroke:var(--deep-sage);stroke-width:1.75;"></i></div>
        <div class="mc-val">{{ totalStaff }}</div><div class="mc-lbl">Staff</div>
    </a>
    <a href="{{ path('app_admin_users_index') }}" class="mc m3">
        <div class="mc-icon"><i data-lucide="shield" style="width:18px;height:18px;stroke:#b8924a;stroke-width:1.75;"></i></div>
        <div class="mc-val">{{ totalAdmins }}</div><div class="mc-lbl">Admins</div>
    </a>
    <a href="{{ path('app_product_index') }}" class="mc m4">
        <div class="mc-icon"><i data-lucide="shirt" style="width:18px;height:18px;stroke:var(--deep-mauve);stroke-width:1.75;"></i></div>
        <div class="mc-val">{{ totalProducts }}</div><div class="mc-lbl">Products</div>
    </a>
    <a href="{{ path('app_order_index') }}" class="mc m5">
        <div class="mc-icon"><i data-lucide="shopping-cart" style="width:18px;height:18px;stroke:var(--deep-sage);stroke-width:1.75;"></i></div>
        <div class="mc-val">{{ totalOrders }}</div><div class="mc-lbl">Orders</div>
    </a>
    <a href="{{ path('app_customer_index') }}" class="mc m6">
        <div class="mc-icon"><i data-lucide="user" style="width:18px;height:18px;stroke:#b8924a;stroke-width:1.75;"></i></div>
        <div class="mc-val">{{ totalCustomers }}</div><div class="mc-lbl">Customers</div>
    </a>
</div>

<!-- Grid -->
<div class="dash-grid">
    <!-- Activity Log -->
    <div class="panel">
        <div class="ph">
            <span class="pt">Recent Activity</span>
            <a href="{{ path('app_admin_activity_logs') }}" class="pl">View all →</a>
        </div>
        <div class="act-list">
            {% if recentLogs is not empty %}
                {% for log in recentLogs %}
                <div class="ai">
                    <div class="ai-ic {% if log.action == 'LOGIN' %}ic-login{% elseif log.action == 'LOGOUT' %}ic-logout{% elseif log.action == 'CREATE' %}ic-create{% elseif log.action == 'UPDATE' %}ic-update{% elseif log.action == 'DELETE' %}ic-delete{% else %}ic-other{% endif %}">
                        {% if log.action == 'LOGIN' %}<i data-lucide="log-in" style="width:14px;height:14px;stroke:var(--deep-sage);stroke-width:2;"></i>
                        {% elseif log.action == 'LOGOUT' %}<i data-lucide="log-out" style="width:14px;height:14px;stroke:var(--warm-gray);stroke-width:2;"></i>
                        {% elseif log.action == 'CREATE' %}<i data-lucide="plus-circle" style="width:14px;height:14px;stroke:var(--deep-mauve);stroke-width:2;"></i>
                        {% elseif log.action == 'UPDATE' %}<i data-lucide="pencil" style="width:14px;height:14px;stroke:#b8924a;stroke-width:2;"></i>
                        {% elseif log.action == 'DELETE' %}<i data-lucide="trash-2" style="width:14px;height:14px;stroke:#b05050;stroke-width:2;"></i>
                        {% else %}<i data-lucide="file-text" style="width:14px;height:14px;stroke:var(--warm-gray);stroke-width:2;"></i>
                        {% endif %}
                    </div>
                    <div class="ai-body">
                        <div class="ai-user">
                            {{ log.username }}
                            <span class="ai-role {{ log.role|lower == 'role_admin' ? 'r-admin' : 'r-staff' }}">{{ log.role|replace({'ROLE_':''}) }}</span>
                        </div>
                        <div class="ai-detail">{{ log.action }} · {{ log.targetData|default('') }}</div>
                        <div class="ai-time">{{ log.createdAt|date('M d, Y · H:i') }}</div>
                    </div>
                </div>
                {% endfor %}
            {% else %}
            <div class="empty">
                <i data-lucide="clipboard" style="width:32px;height:32px;stroke:var(--border);stroke-width:1.5;"></i>
                <p>No recent activity.</p>
            </div>
            {% endif %}
        </div>
    </div>

    <!-- Right -->
    <div style="display:flex;flex-direction:column;gap:20px;">
        <!-- Quick Actions -->
        <div class="panel">
            <div class="ph"><span class="pt">Quick Actions</span></div>
            <div class="qa-grid">
                <a href="{{ path('app_admin_users_new') }}" class="qa">
                    <div class="qa-ic" style="background:rgba(196,160,160,0.15);"><i data-lucide="user-plus" style="width:16px;height:16px;stroke:var(--deep-mauve);stroke-width:1.75;"></i></div>
                    <div class="qa-t">Add User</div>
                    <div class="qa-d">Create admin or staff</div>
                </a>
                <a href="{{ path('app_admin_users_index') }}" class="qa">
                    <div class="qa-ic" style="background:rgba(143,175,140,0.15);"><i data-lucide="users" style="width:16px;height:16px;stroke:var(--deep-sage);stroke-width:1.75;"></i></div>
                    <div class="qa-t">Manage Users</div>
                    <div class="qa-d">View all accounts</div>
                </a>
                <a href="{{ path('app_challenge_admin_create') }}" class="qa">
                    <div class="qa-ic" style="background:rgba(201,169,110,0.12);"><i data-lucide="trophy" style="width:16px;height:16px;stroke:#b8924a;stroke-width:1.75;"></i></div>
                    <div class="qa-t">New Challenge</div>
                    <div class="qa-d">Launch a challenge</div>
                </a>
                <a href="{{ path('app_admin_activity_logs') }}" class="qa">
                    <div class="qa-ic" style="background:rgba(196,160,160,0.1);"><i data-lucide="activity" style="width:16px;height:16px;stroke:var(--deep-mauve);stroke-width:1.75;"></i></div>
                    <div class="qa-t">Activity Logs</div>
                    <div class="qa-d">System audit trail</div>
                </a>
            </div>
        </div>

        <!-- Store Stats -->
        <div class="panel">
            <div class="ph">
                <span class="pt">Store Overview</span>
                <a href="{{ path('app_order_index') }}" class="pl">Orders →</a>
            </div>
            <div style="padding:16px 24px;">
                <div class="stat-row">
                    <span class="stat-lbl">Total Products</span>
                    <span class="stat-val">{{ totalProducts }}</span>
                </div>
                <div class="stat-row">
                    <span class="stat-lbl">Total Orders</span>
                    <span class="stat-val">{{ totalOrders }}</span>
                </div>
                <div class="stat-row">
                    <span class="stat-lbl">Total Customers</span>
                    <span class="stat-val">{{ totalCustomers }}</span>
                </div>
                <div class="stat-row" style="margin-top:8px;border-top:1px solid var(--border);padding-top:12px;">
                    <span class="stat-lbl" style="font-weight:700;color:var(--charcoal);">Total Users</span>
                    <span class="stat-val green" style="font-size:18px;">{{ totalUsers }}</span>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
