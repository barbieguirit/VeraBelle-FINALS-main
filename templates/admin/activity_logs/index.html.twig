{% extends 'base_dashboard.html.twig' %}

{% block title %}Activity Logs — VeraBelle Collection{% endblock %}
{% block page_title %}Activity Logs{% endblock %}

{% block content %}
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css">
<style>
    :root {
        --blush:#F0C4C4; --sage:#A8BCA1; --sage-deep:#7A9972;
        --ink:#1A1F2E; --ink-soft:#4A5568; --cream:#FAF8F5;
        --cream-warm:#F4F0EA; --gold:#C9A96E; --white:#FFFFFF;
        --border:rgba(26,31,46,0.08); --shadow-sm:0 2px 12px rgba(26,31,46,0.06);
        --shadow-md:0 8px 32px rgba(26,31,46,0.10); --radius:16px; --radius-sm:10px;
    }
    * { font-family:'Figtree',sans-serif; box-sizing:border-box; }
    @keyframes fadeUp { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:translateY(0)} }

    /* Header */
    .page-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; flex-wrap:wrap; gap:12px; animation:fadeUp 0.4s ease both; }
    .page-eyebrow { font-size:10px; letter-spacing:0.2em; text-transform:uppercase; color:var(--gold); font-weight:600; margin-bottom:4px; }
    .page-title { font-family:'Nunito',sans-serif; font-size:26px; font-weight:800; color:var(--ink); line-height:1; }
    .page-sub { font-size:13px; color:var(--ink-soft); margin-top:2px; }
    .count-badge { background:var(--ink); color:#fff; padding:8px 18px; border-radius:20px; font-size:13px; font-weight:700; font-family:'Nunito',sans-serif; }

    /* Filter bar */
    .filter-bar {
        background:var(--white); border:1px solid var(--border); border-radius:var(--radius-sm);
        padding:18px 22px; margin-bottom:20px; display:flex; align-items:flex-end; gap:12px; flex-wrap:wrap;
        animation:fadeUp 0.4s 0.05s ease both;
    }
    .fg { display:flex; flex-direction:column; gap:5px; flex:1; min-width:140px; }
    .fg label { font-size:10px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft); }
    .fg input, .fg select {
        padding:9px 12px; border-radius:8px; border:1px solid var(--border);
        background:var(--cream); font-size:13px; color:var(--ink); outline:none;
        transition:all 0.2s; font-family:'Figtree',sans-serif;
    }
    .fg input:focus, .fg select:focus { border-color:var(--blush); background:var(--white); box-shadow:0 0 0 3px rgba(240,196,196,0.15); }
    .btn-apply { padding:9px 20px; background:var(--ink); color:#fff; border:none; border-radius:8px; font-size:13px; font-weight:600; cursor:pointer; transition:all 0.2s; font-family:'Figtree',sans-serif; }
    .btn-apply:hover { background:var(--ink-soft); }
    .btn-clear { padding:9px 16px; background:var(--cream); color:var(--ink-soft); border:1px solid var(--border); border-radius:8px; font-size:13px; font-weight:600; text-decoration:none; transition:all 0.2s; }
    .btn-clear:hover { background:var(--cream-warm); color:var(--ink); }

    /* Table panel */
    .logs-panel { background:var(--white); border-radius:var(--radius); border:1px solid var(--border); overflow:hidden; animation:fadeUp 0.4s 0.1s ease both; }
    .logs-panel-header { padding:18px 24px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--border); }
    .logs-panel-title { font-family:'Nunito',sans-serif; font-size:15px; font-weight:800; color:var(--ink); }

    /* Table */
    .logs-table { width:100%; border-collapse:collapse; }
    .logs-table th {
        padding:12px 20px; text-align:left; font-size:10px; font-weight:700;
        letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft);
        background:var(--cream); border-bottom:1px solid var(--border);
    }
    .logs-table td { padding:14px 20px; border-bottom:1px solid var(--border); vertical-align:middle; }
    .logs-table tr:last-child td { border-bottom:none; }
    .logs-table tr:hover td { background:var(--cream); }

    /* User cell */
    .user-cell { display:flex; align-items:center; gap:10px; }
    .user-av {
        width:32px; height:32px; border-radius:9px; flex-shrink:0;
        background:linear-gradient(135deg,var(--blush),var(--sage));
        display:flex; align-items:center; justify-content:center;
        font-family:'Nunito',sans-serif; font-size:13px; font-weight:800; color:#fff;
    }
    .user-name { font-size:13px; font-weight:600; color:var(--ink); }
    .user-role { font-size:10px; color:var(--ink-soft); margin-top:1px; }

    /* Action badge */
    .action-badge { font-size:10px; font-weight:700; padding:4px 10px; border-radius:20px; text-transform:uppercase; letter-spacing:0.06em; white-space:nowrap; display:inline-flex; align-items:center; gap:5px; }
    .ab-login    { background:rgba(122,153,114,0.12); color:var(--sage-deep); border:1px solid rgba(122,153,114,0.22); }
    .ab-logout   { background:rgba(149,165,166,0.12); color:#7f8c8d; border:1px solid rgba(149,165,166,0.22); }
    .ab-create   { background:rgba(139,168,212,0.12); color:#4a7ab5; border:1px solid rgba(139,168,212,0.22); }
    .ab-update   { background:rgba(240,196,196,0.15); color:#b86060; border:1px solid rgba(240,196,196,0.3); }
    .ab-delete   { background:rgba(231,76,60,0.09); color:#c0392b; border:1px solid rgba(231,76,60,0.2); }
    .ab-password_reset { background:rgba(201,169,110,0.15); color:#8a6d2f; border:1px solid rgba(201,169,110,0.25); }
    .ab-disable  { background:rgba(243,156,18,0.12); color:#d68910; border:1px solid rgba(243,156,18,0.25); }
    .ab-enable   { background:rgba(122,153,114,0.12); color:var(--sage-deep); border:1px solid rgba(122,153,114,0.22); }

    .details-text { font-size:12px; color:var(--ink-soft); max-width:280px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .time-text { font-size:12px; color:var(--ink-soft); white-space:nowrap; }
    .time-date { font-weight:600; color:var(--ink); }

    /* Empty */
    .empty-row td { text-align:center; padding:60px 20px; }
    .empty-icon { margin-bottom:12px; }
    .empty-title { font-family:'Nunito',sans-serif; font-size:16px; font-weight:800; color:var(--ink); margin-bottom:4px; }
    .empty-sub { font-size:13px; color:var(--ink-soft); }

    @media (max-width:900px) {
        .logs-table thead { display:none; }
        .logs-table td { display:block; padding:8px 16px; }
        .logs-table tr { display:block; border-bottom:1px solid var(--border); padding:12px 0; }
    }

    /* DataTables overrides */
    .dataTables_wrapper { padding: 0; }
    .dataTables_wrapper .dataTables_filter { display: none; } /* we use our own filter */
    .dataTables_wrapper .dataTables_length { padding: 14px 20px 0; }
    .dataTables_wrapper .dataTables_length label { font-size: 12px; color: var(--ink-soft); font-family: 'Figtree', sans-serif; }
    .dataTables_wrapper .dataTables_length select { padding: 5px 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--cream); font-size: 12px; color: var(--ink); outline: none; margin: 0 6px; }
    .dataTables_wrapper .dataTables_info { padding: 12px 20px; font-size: 12px; color: var(--ink-soft); }
    .dataTables_wrapper .dataTables_paginate { padding: 12px 20px; display: flex; justify-content: flex-end; gap: 4px; }
    .dataTables_wrapper .dataTables_paginate .paginate_button {
        padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 600;
        color: var(--ink-soft) !important; cursor: pointer; border: 1px solid var(--border) !important;
        background: var(--cream) !important; transition: all 0.2s;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button:hover { background: var(--cream-warm) !important; color: var(--ink) !important; }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current { background: var(--ink) !important; color: #fff !important; border-color: var(--ink) !important; }
    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled { opacity: 0.4; cursor: not-allowed; }
    table.dataTable thead th { border-bottom: 1px solid var(--border) !important; }
    table.dataTable.no-footer { border-bottom: none !important; }
    .dataTables_scrollBody { border: none !important; }
</style>

<div class="page-header">
    <div>
        <div class="page-eyebrow">Administration</div>
        <div class="page-title">Activity Logs</div>
        <div class="page-sub">Track all system activities and user actions</div>
    </div>
    <span class="count-badge">{{ logs|length }} Records</span>
</div>

<!-- Filters -->
<div class="filter-bar">
    <form method="get" style="display:contents;">
        <div class="fg">
            <label>Search User</label>
            <input type="text" name="username" placeholder="Username..." value="{{ filters.username }}">
        </div>
        <div class="fg">
            <label>Action</label>
            <select name="action">
                <option value="">All Actions</option>
                <option value="LOGIN"          {% if filters.action == 'LOGIN' %}selected{% endif %}>Login</option>
                <option value="LOGOUT"         {% if filters.action == 'LOGOUT' %}selected{% endif %}>Logout</option>
                <option value="CREATE"         {% if filters.action == 'CREATE' %}selected{% endif %}>Create</option>
                <option value="UPDATE"         {% if filters.action == 'UPDATE' %}selected{% endif %}>Update</option>
                <option value="DELETE"         {% if filters.action == 'DELETE' %}selected{% endif %}>Delete</option>
                <option value="PASSWORD_RESET" {% if filters.action == 'PASSWORD_RESET' %}selected{% endif %}>Password Reset</option>
                <option value="DISABLE"        {% if filters.action == 'DISABLE' %}selected{% endif %}>Disable</option>
                <option value="ENABLE"         {% if filters.action == 'ENABLE' %}selected{% endif %}>Enable</option>
            </select>
        </div>
        <div class="fg">
            <label>From</label>
            <input type="date" name="start_date" value="{{ filters.start_date }}">
        </div>
        <div class="fg">
            <label>To</label>
            <input type="date" name="end_date" value="{{ filters.end_date }}">
        </div>
        <div style="display:flex;gap:8px;align-items:flex-end;">
            <button type="submit" class="btn-apply">Apply</button>
            <a href="{{ path('app_admin_activity_logs') }}" class="btn-clear">Clear</a>
        </div>
    </form>
</div>

<!-- Logs Table -->
<div class="logs-panel">
    <div class="logs-panel-header">
        <span class="logs-panel-title">All Activity</span>
        <span style="font-size:12px;color:var(--ink-soft);">Read-only audit trail</span>
    </div>
    <table class="logs-table" id="logsDataTable">
        <thead>
            <tr>
                <th>User</th>
                <th>Action</th>
                <th>Details</th>
                <th>Date & Time</th>
            </tr>
        </thead>
        <tbody>
            {% for log in logs %}
            <tr>
                <td>
                    <div class="user-cell">
                        <div class="user-av">{{ log.username|slice(0,1)|upper }}</div>
                        <div>
                            <div class="user-name">{{ log.username }}</div>
                            <div class="user-role">{{ log.role|replace({'ROLE_':''}) }}</div>
                        </div>
                    </div>
                </td>
                <td>
                    <span class="action-badge ab-{{ log.action|lower }}">
                        {% if log.action == 'LOGIN' %}<i data-lucide="log-in" style="width:11px;height:11px;stroke:currentColor;stroke-width:2.5;"></i>
                        {% elseif log.action == 'LOGOUT' %}<i data-lucide="log-out" style="width:11px;height:11px;stroke:currentColor;stroke-width:2.5;"></i>
                        {% elseif log.action == 'CREATE' %}<i data-lucide="plus" style="width:11px;height:11px;stroke:currentColor;stroke-width:2.5;"></i>
                        {% elseif log.action == 'UPDATE' %}<i data-lucide="pencil" style="width:11px;height:11px;stroke:currentColor;stroke-width:2.5;"></i>
                        {% elseif log.action == 'DELETE' %}<i data-lucide="trash-2" style="width:11px;height:11px;stroke:currentColor;stroke-width:2.5;"></i>
                        {% else %}<i data-lucide="key" style="width:11px;height:11px;stroke:currentColor;stroke-width:2.5;"></i>
                        {% endif %}
                        {{ log.action|replace({'_':' '}) }}
                    </span>
                </td>
                <td>
                    <div class="details-text" title="{{ log.targetData|default('') }}">
                        {{ log.targetData|default('—') }}
                    </div>
                </td>
                <td>
                    <div class="time-text">
                        <div class="time-date">{{ log.createdAt|date('M d, Y') }}</div>
                        {{ log.createdAt|date('H:i:s') }}
                    </div>
                </td>
            </tr>
            {% else %}
            <tr class="empty-row">
                <td colspan="4">
                    <div class="empty-icon"><i data-lucide="clipboard" style="width:40px;height:40px;stroke:#ccc;stroke-width:1.5;"></i></div>
                    <div class="empty-title">No Activity Logs Found</div>
                    <div class="empty-sub">Try adjusting your filters or clear them to see all logs.</div>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}

{% block extra_scripts %}
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script>
$(document).ready(function() {
    $('#logsDataTable').DataTable({
        order: [[3, 'desc']],
        pageLength: 25,
        lengthMenu: [10, 25, 50, 100],
        columnDefs: [{ orderable: false, targets: [1, 2] }],
        language: {
            searchPlaceholder: 'Search logs...',
            lengthMenu: 'Show _MENU_ entries',
            info: 'Showing _START_ to _END_ of _TOTAL_ records',
            paginate: { previous: '←', next: '→' }
        }
    });
});
</script>
{% endblock %}
