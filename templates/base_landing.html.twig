<script>
// ── Search Functions
function openSearch() {
    document.getElementById('searchModal').classList.add('open');
    document.getElementById('searchInput').focus();
}

function closeSearch() {
    document.getElementById('searchModal').classList.remove('open');
    document.getElementById('searchResults').innerHTML = '';
}

function handleSearch(event) {
    if (event.key === 'Enter') {
        const query = document.getElementById('searchInput').value.trim();
        if (query) {
            window.location.href = '{{ path('app_shop') }}?q=' + encodeURIComponent(query);
        }
    }
}

// Close search modal on background click
document.addEventListener('DOMContentLoaded', () => {
    const searchModal = document.getElementById('searchModal');
    if (searchModal) {
        searchModal.addEventListener('click', (e) => {
            if (e.target === searchModal) closeSearch();
        });
    }
    updateNavCartCount();
});

// ── Cart
function addToCart(productId, productName, productPrice, button) {
    if (button) { button.disabled = true; button.textContent = 'Adding...'; }
    fetch(`/cart/add/${productId}`, { method: 'POST' })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                updateNavCartCount(data.cartCount);
                if (button) {
                    const orig = button.textContent;
                    button.textContent = '✓ Added!';
                    setTimeout(() => { button.disabled = false; button.textContent = orig === 'Adding...' ? 'Add to Cart' : orig; }, 2000);
                }
            } else {
                if (button) { button.disabled = false; button.textContent = 'Add to Cart'; }
                alert(data.message || 'Could not add to cart.');
            }
        })
        .catch(() => { if (button) { button.disabled = false; button.textContent = 'Add to Cart'; } });
}

function updateNavCartCount(count) {
    const badge = document.getElementById('nav-cart-count');
    if (!badge) return;
    if (count !== undefined) {
        if (count > 0) { badge.textContent = count; badge.style.display = 'inline-flex'; }
        else { badge.style.display = 'none'; }
        return;
    }
    fetch('/cart', { headers: { 'Accept': 'application/json' } })
        .then(r => r.json())
        .then(data => {
            if (data.itemCount > 0) { badge.textContent = data.itemCount; badge.style.display = 'inline-flex'; }
            else { badge.style.display = 'none'; }
        }).catch(() => {});
}

// ── Navbar Scroll
window.addEventListener('scroll', () => {
    document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 60);
});

// ── Mobile Nav
function openMobileNav()  { document.getElementById('mobileNav').classList.add('open'); }
function closeMobileNav() { document.getElementById('mobileNav').classList.remove('open'); }

// ── Scroll Reveal
const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); });
}, { threshold: 0.08 });
document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach(el => io.observe(el));
</script>
{% block extra_scripts %}{% endblock %}
</body>
