{% extends 'base_dashboard.html.twig' %}

{% block title %}{{ customer.fullName }} — VeraBelle Collection{% endblock %}
{% block page_title %}Customer Details{% endblock %}

{% block content %}
<style>
    :root {
        --mauve:#C4A0A0; --deep-mauve:#9E6F6F; --sage:#8FAF8C; --deep-sage:#5C7A5A;
        --charcoal:#3A3232; --warm-gray:#7A6F6F; --ivory:#F9F4EE; --parchment:#EFE6D8;
        --gold:#C9A96E; --white:#FFFFFF;
        --border:rgba(58,50,50,0.08); --shadow-sm:0 2px 12px rgba(58,50,50,0.06);
        --shadow-md:0 8px 32px rgba(58,50,50,0.10); --r:16px; --r-sm:10px;
    }
    * { font-family:'Figtree',sans-serif; box-sizing:border-box; }
    .cw { max-width:1400px; margin:0 auto; }

    /* Hero */
    .cust-hero {
        background:linear-gradient(135deg,#2A2020,var(--charcoal));
        border-radius:var(--r); padding:36px 44px; margin-bottom:24px;
        display:flex; align-items:center; gap:28px;
        position:relative; overflow:hidden; border:1px solid rgba(196,160,160,0.1);
    }
    .cust-hero::before { content:''; position:absolute; top:-60px; right:60px; width:260px; height:260px; background:radial-gradient(circle,rgba(196,160,160,0.12) 0%,transparent 65%); pointer-events:none; }
    .ch-avatar { width:72px; height:72px; border-radius:50%; background:linear-gradient(135deg,var(--mauve),var(--sage)); display:flex; align-items:center; justify-content:center; font-family:'Nunito',sans-serif; font-size:28px; font-weight:800; color:white; flex-shrink:0; border:3px solid rgba(255,255,255,0.1); position:relative; z-index:1; }
    .ch-info { flex:1; position:relative; z-index:1; }
    .ch-eyebrow { font-size:10px; font-weight:700; letter-spacing:4px; text-transform:uppercase; color:var(--gold); margin-bottom:8px; display:flex; align-items:center; gap:8px; }
    .ch-eyebrow::before { content:''; display:block; width:20px; height:1px; background:var(--gold); }
    .ch-name { font-family:'Nunito',sans-serif; font-size:28px; font-weight:800; color:white; margin-bottom:4px; }
    .ch-email { font-size:13px; color:rgba(255,255,255,0.4); }
    .ch-badges { display:flex; gap:8px; margin-top:12px; flex-wrap:wrap; }
    .sbadge { display:inline-flex; align-items:center; gap:5px; padding:5px 12px; border-radius:20px; font-size:11px; font-weight:700; text-transform:capitalize; }
    .sbadge::before { content:''; width:5px; height:5px; border-radius:50%; background:currentColor; opacity:0.7; }
    .s-active   { background:rgba(92,122,90,0.15); color:var(--deep-sage); border:1px solid rgba(92,122,90,0.22); }
    .s-inactive { background:rgba(122,111,111,0.12); color:var(--warm-gray); border:1px solid rgba(122,111,111,0.2); }
    .s-suspended { background:rgba(180,80,80,0.1); color:#b05050; border:1px solid rgba(180,80,80,0.2); }

    /* Stats strip */
    .stats-strip { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-bottom:24px; }
    .sc { background:var(--white); border-radius:var(--r-sm); padding:20px; border:1px solid var(--border); display:flex; align-items:center; gap:14px; transition:all 0.2s; box-shadow:var(--shadow-sm); }
    .sc:hover { transform:translateY(-2px); box-shadow:var(--shadow-md); }
    .sc-icon { width:40px; height:40px; border-radius:12px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .sc-val { font-family:'Nunito',sans-serif; font-size:22px; font-weight:800; color:var(--charcoal); line-height:1; }
    .sc-lbl { font-size:11.5px; color:var(--warm-gray); margin-top:2px; }

    /* Info panels */
    .detail-grid { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:20px; }
    .ip { background:var(--white); border-radius:var(--r); border:1px solid var(--border); overflow:hidden; box-shadow:var(--shadow-sm); }
    .ip-head { padding:18px 24px 14px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:10px; }
    .ip-icon { width:34px; height:34px; border-radius:9px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .ip-title { font-family:'Nunito',sans-serif; font-size:15px; font-weight:800; color:var(--charcoal); }
    .ip-body { padding:20px 24px; display:flex; flex-direction:column; gap:10px; }
    .ip-row { display:flex; justify-content:space-between; align-items:flex-start; padding:10px 14px; background:var(--ivory); border-radius:8px; font-size:13px; gap:16px; }
    .ip-lbl { color:var(--warm-gray); font-weight:500; flex-shrink:0; }
    .ip-val { font-weight:600; color:var(--charcoal); text-align:right; }
    .ip-val.green { color:var(--deep-sage); }
    .ip-val.addr { font-size:12px; line-height:1.7; text-align:right; }
    .ip-notes { font-size:13px; color:var(--warm-gray); line-height:1.8; padding:14px; background:var(--ivory); border-radius:8px; font-weight:300; }

    /* Actions */
    .actions-row { display:flex; gap:10px; flex-wrap:wrap; }
    .btn-edit { display:inline-flex; align-items:center; gap:7px; padding:11px 24px; background:linear-gradient(135deg,var(--mauve),var(--deep-mauve)); color:white; border-radius:8px; font-size:12px; font-weight:700; letter-spacing:0.5px; text-transform:uppercase; text-decoration:none; transition:all 0.2s; }
    .btn-edit:hover { opacity:0.9; transform:translateY(-1px); }
    .btn-back { display:inline-flex; align-items:center; gap:7px; padding:11px 20px; background:var(--ivory); color:var(--warm-gray); border:1px solid var(--border); border-radius:8px; font-size:12px; font-weight:600; text-decoration:none; transition:all 0.2s; }
    .btn-back:hover { background:var(--parchment); color:var(--charcoal); }
    .btn-delete { display:inline-flex; align-items:center; gap:7px; padding:11px 20px; background:rgba(180,80,80,0.08); color:#b05050; border:1px solid rgba(180,80,80,0.18); border-radius:8px; font-size:12px; font-weight:600; cursor:pointer; transition:all 0.2s; font-family:'Figtree',sans-serif; }
    .btn-delete:hover { background:#e74c3c; color:white; border-color:#e74c3c; }

    @media (max-width:900px) { .detail-grid { grid-template-columns:1fr; } .stats-strip { grid-template-columns:1fr; } .cust-hero { flex-direction:column; align-items:flex-start; padding:28px 24px; } }
</style>

<div class="cw">
    <!-- Hero -->
    <div class="cust-hero">
        <div class="ch-avatar">{{ customer.fullName|slice(0,1)|upper }}</div>
        <div class="ch-info">
            <div class="ch-eyebrow">Customer Profile</div>
            <div class="ch-name">{{ customer.fullName }}</div>
            <div class="ch-email">{{ customer.email }}</div>
            <div class="ch-badges">
                <span class="sbadge s-{{ customer.status|lower }}">{{ customer.status }}</span>
                <span style="background:rgba(196,160,160,0.12);color:var(--deep-mauve);border:1px solid rgba(196,160,160,0.22);display:inline-flex;align-items:center;padding:5px 12px;border-radius:20px;font-size:11px;font-weight:700;">ID #{{ customer.id }}</span>
            </div>
        </div>
    </div>

    <!-- Stats -->
    <div class="stats-strip">
        <div class="sc">
            <div class="sc-icon" style="background:rgba(196,160,160,0.15);"><i data-lucide="shopping-cart" style="width:18px;height:18px;stroke:var(--deep-mauve);stroke-width:1.75;"></i></div>
            <div><div class="sc-val">{{ customer.totalOrders }}</div><div class="sc-lbl">Total Orders</div></div>
        </div>
        <div class="sc">
            <div class="sc-icon" style="background:rgba(143,175,140,0.15);"><i data-lucide="banknote" style="width:18px;height:18px;stroke:var(--deep-sage);stroke-width:1.75;"></i></div>
            <div><div class="sc-val">₱{{ customer.totalSpent|number_format(0) }}</div><div class="sc-lbl">Total Spent</div></div>
        </div>
        <div class="sc">
            <div class="sc-icon" style="background:rgba(201,169,110,0.12);"><i data-lucide="calendar" style="width:18px;height:18px;stroke:var(--gold);stroke-width:1.75;"></i></div>
            <div><div class="sc-val">{{ customer.registeredDate|date('M Y') }}</div><div class="sc-lbl">Member Since</div></div>
        </div>
    </div>

    <!-- Info Grid -->
    <div class="detail-grid">
        <!-- Contact -->
        <div class="ip">
            <div class="ip-head">
                <div class="ip-icon" style="background:rgba(196,160,160,0.15);"><i data-lucide="user" style="width:15px;height:15px;stroke:var(--deep-mauve);stroke-width:1.75;"></i></div>
                <span class="ip-title">Contact Information</span>
            </div>
            <div class="ip-body">
                <div class="ip-row"><span class="ip-lbl">Full Name</span><span class="ip-val">{{ customer.fullName }}</span></div>
                <div class="ip-row"><span class="ip-lbl">Email</span><span class="ip-val" style="font-size:12px;">{{ customer.email }}</span></div>
                {% if customer.phoneNumber %}
                <div class="ip-row"><span class="ip-lbl">Phone</span><span class="ip-val">{{ customer.phoneNumber }}</span></div>
                {% endif %}
                <div class="ip-row"><span class="ip-lbl">Registered</span><span class="ip-val">{{ customer.registeredDate|date('M d, Y') }}</span></div>
                <div class="ip-row">
                    <span class="ip-lbl">Status</span>
                    <span class="sbadge s-{{ customer.status|lower }}">{{ customer.status }}</span>
                </div>
            </div>
        </div>

        <!-- Address -->
        <div class="ip">
            <div class="ip-head">
                <div class="ip-icon" style="background:rgba(143,175,140,0.15);"><i data-lucide="map-pin" style="width:15px;height:15px;stroke:var(--deep-sage);stroke-width:1.75;"></i></div>
                <span class="ip-title">Address Information</span>
            </div>
            <div class="ip-body">
                {% if customer.shippingAddress %}
                <div class="ip-row" style="align-items:flex-start;">
                    <span class="ip-lbl">Shipping</span>
                    <span class="ip-val addr">{{ customer.shippingAddress }}</span>
                </div>
                {% endif %}
                {% if customer.billingAddress %}
                <div class="ip-row" style="align-items:flex-start;">
                    <span class="ip-lbl">Billing</span>
                    <span class="ip-val addr">{{ customer.billingAddress }}</span>
                </div>
                {% endif %}
                {% if not customer.shippingAddress and not customer.billingAddress %}
                <div style="text-align:center;padding:24px;color:var(--warm-gray);font-size:13px;">No address on file</div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Notes -->
    {% if customer.notes %}
    <div class="ip" style="margin-bottom:20px;">
        <div class="ip-head">
            <div class="ip-icon" style="background:rgba(201,169,110,0.12);"><i data-lucide="file-text" style="width:15px;height:15px;stroke:var(--gold);stroke-width:1.75;"></i></div>
            <span class="ip-title">Notes</span>
        </div>
        <div class="ip-body">
            <div class="ip-notes">{{ customer.notes }}</div>
        </div>
    </div>
    {% endif %}

    <!-- Actions -->
    <div class="actions-row">
        <a href="{{ path('app_customer_edit', {'id': customer.id}) }}" class="btn-edit">
            <i data-lucide="pencil" style="width:13px;height:13px;stroke:white;stroke-width:2;"></i> Edit Customer
        </a>
        <form method="post" action="{{ path('app_customer_delete', {'id': customer.id}) }}" onsubmit="return confirm('Delete {{ customer.fullName }}?');" style="display:inline;">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ customer.id) }}">
            <button type="submit" class="btn-delete">
                <i data-lucide="trash-2" style="width:13px;height:13px;stroke:currentColor;stroke-width:2;"></i> Delete
            </button>
        </form>
    </div>
</div>
{% endblock %}
