{% extends 'base_dashboard.html.twig' %}

{% block title %}Customers — VeraBelle Collection{% endblock %}
{% block page_title %}Customers{% endblock %}

{% block content %}
<style>
    :root {
        --blush:#F0C4C4; --sage:#A8BCA1; --sage-deep:#7A9972;
        --ink:#1A1F2E; --ink-soft:#4A5568; --cream:#FAF8F5;
        --cream-warm:#F4F0EA; --gold:#C9A96E; --white:#FFFFFF;
        --border:rgba(26,31,46,0.08); --shadow-sm:0 2px 12px rgba(26,31,46,0.06);
        --shadow-md:0 8px 32px rgba(26,31,46,0.10); --radius:16px; --radius-sm:10px;
    }
    * { font-family:'Figtree',sans-serif; box-sizing:border-box; }
    @keyframes fadeUp { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:translateY(0)} }

    .page-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; flex-wrap:wrap; gap:12px; animation:fadeUp 0.4s ease both; }
    .page-eyebrow { font-size:10px; letter-spacing:0.2em; text-transform:uppercase; color:var(--gold); font-weight:600; margin-bottom:4px; }
    .page-title { font-family:'Nunito',sans-serif; font-size:26px; font-weight:800; color:var(--ink); line-height:1; }
    .page-sub { font-size:13px; color:var(--ink-soft); margin-top:2px; }

    .btn-add { display:inline-flex; align-items:center; gap:8px; padding:11px 22px; background:var(--ink); color:#fff; border-radius:40px; text-decoration:none; font-size:13.5px; font-weight:600; transition:all 0.22s; box-shadow:0 4px 16px rgba(26,31,46,0.18); }
    .btn-add:hover { background:var(--ink-soft); transform:translateY(-2px); color:#fff; }
    .btn-add-icon { width:22px; height:22px; background:linear-gradient(135deg,var(--blush),var(--sage)); border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; }

    /* Stats */
    .stats-strip { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-bottom:24px; animation:fadeUp 0.4s 0.08s ease both; }
    .strip-card { background:var(--white); border-radius:var(--radius-sm); padding:20px; border:1px solid var(--border); display:flex; align-items:center; gap:14px; transition:all 0.2s; position:relative; overflow:hidden; }
    .strip-card::after { content:''; position:absolute; bottom:0; left:0; right:0; height:3px; opacity:0; transition:opacity 0.2s; }
    .strip-card:hover { box-shadow:var(--shadow-sm); transform:translateY(-2px); }
    .strip-card:hover::after { opacity:1; }
    .sc-total::after  { background:linear-gradient(90deg,var(--blush),#e8a8a8); }
    .sc-active::after { background:linear-gradient(90deg,var(--sage),var(--sage-deep)); }
    .sc-rev::after    { background:linear-gradient(90deg,var(--gold),#b8924a); }
    .strip-icon { width:44px; height:44px; border-radius:12px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .si-blush { background:rgba(240,196,196,0.18); }
    .si-sage  { background:rgba(168,188,161,0.18); }
    .si-gold  { background:rgba(201,169,110,0.15); }
    .strip-val { font-family:'Nunito',sans-serif; font-size:26px; font-weight:800; color:var(--ink); line-height:1; }
    .strip-lbl { font-size:11.5px; color:var(--ink-soft); margin-top:2px; }

    /* Grid section */
    .customers-section { background:var(--white); border-radius:var(--radius); border:1px solid var(--border); padding:24px; animation:fadeUp 0.4s 0.16s ease both; }
    .section-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; padding-bottom:16px; border-bottom:1px solid var(--border); }
    .section-title { font-family:'Nunito',sans-serif; font-size:15px; font-weight:800; color:var(--ink); }
    .section-count { background:var(--cream); border-radius:12px; padding:4px 12px; font-size:12px; font-weight:700; color:var(--ink-soft); }

    .customers-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(290px,1fr)); gap:18px; }

    /* Customer card */
    .customer-card { border:1px solid var(--border); border-radius:var(--radius-sm); background:var(--white); overflow:hidden; display:flex; flex-direction:column; transition:all 0.22s; }
    .customer-card:hover { transform:translateY(-4px); box-shadow:var(--shadow-md); border-color:rgba(240,196,196,0.3); }
    .card-top-bar { height:4px; background:linear-gradient(90deg,var(--blush),var(--sage)); }

    .card-header { padding:16px 18px 12px; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; gap:10px; }
    .customer-info { display:flex; align-items:center; gap:12px; min-width:0; }
    .customer-avatar { width:40px; height:40px; border-radius:12px; background:linear-gradient(135deg,var(--blush),var(--sage)); display:flex; align-items:center; justify-content:center; font-family:'Nunito',sans-serif; font-size:16px; font-weight:800; color:#fff; flex-shrink:0; }
    .customer-name { font-weight:700; color:var(--ink); font-size:14px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .customer-email { font-size:11px; color:var(--ink-soft); margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }

    .status-badge { display:inline-flex; align-items:center; padding:4px 10px; border-radius:20px; font-size:11px; font-weight:700; text-transform:capitalize; white-space:nowrap; flex-shrink:0; }
    .status-active   { background:rgba(122,153,114,0.12); color:var(--sage-deep); border:1px solid rgba(122,153,114,0.22); }
    .status-inactive { background:rgba(149,165,166,0.12); color:#7f8c8d; border:1px solid rgba(149,165,166,0.22); }
    .status-suspended { background:rgba(231,76,60,0.08); color:#c0392b; border:1px solid rgba(231,76,60,0.18); }

    .card-body { padding:14px 18px; display:flex; flex-direction:column; gap:9px; flex:1; }
    .meta-row { display:flex; justify-content:space-between; align-items:center; font-size:12.5px; }
    .meta-label { color:var(--ink-soft); font-weight:500; }
    .meta-value { font-weight:700; color:var(--ink); font-family:'Nunito',sans-serif; font-size:13px; }
    .amount-value { font-family:'Nunito',sans-serif; font-size:14px; font-weight:800; color:var(--sage-deep); }

    .card-actions { padding:12px 18px 16px; border-top:1px solid var(--border); display:flex; gap:6px; }
    .btn-action { flex:1; padding:8px 10px; border-radius:8px; font-size:12px; font-weight:600; cursor:pointer; transition:all 0.18s; text-decoration:none; display:inline-flex; align-items:center; justify-content:center; gap:4px; border:1px solid transparent; font-family:'Figtree',sans-serif; }
    .btn-view   { background:var(--cream); color:var(--ink-soft); border-color:var(--border); }
    .btn-view:hover   { background:var(--cream-warm); color:var(--ink); }
    .btn-edit   { background:rgba(240,196,196,0.14); color:#b86060; border-color:rgba(240,196,196,0.3); }
    .btn-edit:hover   { background:var(--blush); color:#fff; border-color:var(--blush); }
    .btn-delete { background:rgba(231,76,60,0.07); color:#c0392b; border-color:rgba(231,76,60,0.18); }
    .btn-delete:hover { background:#e74c3c; color:#fff; border-color:#e74c3c; }

    .empty-state { grid-column:1/-1; display:flex; flex-direction:column; align-items:center; padding:80px 20px; text-align:center; gap:10px; }
    .empty-icon-wrap { width:64px; height:64px; background:var(--cream-warm); border-radius:20px; display:flex; align-items:center; justify-content:center; margin-bottom:4px; }
    .empty-state h3 { font-family:'Nunito',sans-serif; font-size:17px; font-weight:800; color:var(--ink); }
    .empty-state p { font-size:13px; color:var(--ink-soft); }

    @media (max-width:900px) { .stats-strip { grid-template-columns:1fr; } }
    @media (max-width:600px) { .customers-grid { grid-template-columns:1fr; } .page-header { flex-direction:column; align-items:flex-start; } }
</style>

<div class="page-header">
    <div>
        <div class="page-eyebrow">Store</div>
        <div class="page-title">Customers</div>
        <div class="page-sub">Manage your customer database</div>
    </div>
    <a href="{{ path('app_customer_new') }}" class="btn-add">
        <span class="btn-add-icon"><i data-lucide="plus" style="width:13px;height:13px;stroke:white;stroke-width:2.5;"></i></span>
        Add Customer
    </a>
</div>

<!-- Stats -->
<div class="stats-strip">
    <div class="strip-card sc-total">
        <div class="strip-icon si-blush"><i data-lucide="users" style="width:20px;height:20px;stroke:#e8a8a8;stroke-width:1.75;"></i></div>
        <div><div class="strip-val">{{ stats.total }}</div><div class="strip-lbl">Total Customers</div></div>
    </div>
    <div class="strip-card sc-active">
        <div class="strip-icon si-sage"><i data-lucide="user-check" style="width:20px;height:20px;stroke:var(--sage-deep);stroke-width:1.75;"></i></div>
        <div><div class="strip-val">{{ stats.active }}</div><div class="strip-lbl">Active</div></div>
    </div>
    <div class="strip-card sc-rev">
        <div class="strip-icon si-gold"><i data-lucide="banknote" style="width:20px;height:20px;stroke:#a07830;stroke-width:1.75;"></i></div>
        <div><div class="strip-val">₱{{ stats.totalSpent|number_format(0) }}</div><div class="strip-lbl">Total Revenue</div></div>
    </div>
</div>

<!-- Customers Grid -->
<div class="customers-section">
    <div class="section-header">
        <span class="section-title">All Customers</span>
        <span class="section-count">{{ customers|length }} customers</span>
    </div>
    <div class="customers-grid">
        {% for customer in customers %}
        <div class="customer-card">
            <div class="card-top-bar"></div>
            <div class="card-header">
                <div class="customer-info">
                    <div class="customer-avatar">{{ customer.fullName|slice(0,1)|upper }}</div>
                    <div style="min-width:0;">
                        <div class="customer-name">{{ customer.fullName }}</div>
                        <div class="customer-email">{{ customer.email }}</div>
                    </div>
                </div>
                <span class="status-badge status-{{ customer.status|lower }}">{{ customer.status }}</span>
            </div>
            <div class="card-body">
                <div class="meta-row">
                    <span class="meta-label">ID</span>
                    <span class="meta-value">#{{ customer.id }}</span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Phone</span>
                    <span class="meta-value" style="font-size:12px;">{{ customer.phoneNumber ?? '—' }}</span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Registered</span>
                    <span class="meta-value" style="font-size:12px;">{{ customer.registeredDate|date('M d, Y') }}</span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Orders</span>
                    <span class="meta-value">{{ customer.totalOrders }}</span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Total Spent</span>
                    <span class="amount-value">₱{{ customer.totalSpent|number_format(2) }}</span>
                </div>
            </div>
            <div class="card-actions">
                <a href="{{ path('app_customer_show', {'id': customer.id}) }}" class="btn-action btn-view">
                    <i data-lucide="eye" style="width:12px;height:12px;stroke:currentColor;stroke-width:2;"></i> View
                </a>
                <a href="{{ path('app_customer_edit', {'id': customer.id}) }}" class="btn-action btn-edit">
                    <i data-lucide="pencil" style="width:12px;height:12px;stroke:currentColor;stroke-width:2;"></i> Edit
                </a>
                <form method="post" action="{{ path('app_customer_delete', {'id': customer.id}) }}" style="flex:1;" onsubmit="return confirm('Delete {{ customer.fullName }}?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ customer.id) }}">
                    <button type="submit" class="btn-action btn-delete" style="width:100%;">
                        <i data-lucide="trash-2" style="width:12px;height:12px;stroke:currentColor;stroke-width:2;"></i> Delete
                    </button>
                </form>
            </div>
        </div>
        {% else %}
        <div class="empty-state">
            <div class="empty-icon-wrap"><i data-lucide="users" style="width:28px;height:28px;stroke:var(--ink-soft);stroke-width:1.5;"></i></div>
            <h3>No Customers Found</h3>
            <p>New customers will appear here once added.</p>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
