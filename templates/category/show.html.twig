{% extends 'base_dashboard.html.twig' %}

{% block title %}View Category - VeraBelle Collection{% endblock %}
{% block page_title %}Category Details{% endblock %}

{% block content %}
<style>
    .details-card {
        max-width: 700px;
        margin: 50px auto;
        background: #fff;
        border-radius: 16px;
        padding: 40px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        font-family: 'Poppins', sans-serif;
    }

    .details-card h1 {
        text-align: center;
        color: #2c3e50;
        font-size: 26px;
        margin-bottom: 30px;
        font-weight: 600;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 30px;
    }

    th {
        text-align: left;
        background: #f7f7f7;
        padding: 12px 14px;
        color: #555;
        font-weight: 600;
        width: 25%;
        border-radius: 8px 0 0 8px;
    }

    td {
        padding: 12px 14px;
        background: #fafafa;
        border-radius: 0 8px 8px 0;
        color: #333;
    }

    .actions {
        display: flex;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    .btn {
        display: inline-block;
        padding: 12px 25px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        font-size: 14px;
        transition: all 0.3s ease;
        text-align: center;
    }

    .btn-back {
        background: #f4f4f4;
        color: #2c3e50;
    }

    .btn-back:hover {
        background: #e0e0e0;
    }

    .btn-edit {
        background: linear-gradient(135deg, #A8BCA1, #8FAF8F);
        color: #fff;
    }

    .btn-edit:hover {
        box-shadow: 0 6px 20px rgba(168, 188, 161, 0.4);
        transform: translateY(-2px);
    }

    .btn-delete button {
        background: linear-gradient(135deg, #F4C2C2, #E89B9B);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 12px 25px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-delete button:hover {
        box-shadow: 0 6px 20px rgba(244, 194, 194, 0.4);
        transform: translateY(-2px);
    }
</style>

<div class="details-card">
    <h1>Category Information</h1>

    <table>
        <tbody>
            <tr>
                <th>ID</th>
                <td>{{ category.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ category.name }}</td>
            </tr>
        </tbody>
    </table>

    <div class="actions">
        <a href="{{ path('app_category_index') }}" class="btn btn-back">← Back to List</a>
        <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn btn-edit">Edit</a>
        <div class="btn-delete">
            {{ include('category/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
