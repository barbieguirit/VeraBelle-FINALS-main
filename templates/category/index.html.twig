{% extends 'base_dashboard.html.twig' %}

{% block title %}Categories — VeraBelle Collection{% endblock %}
{% block page_title %}Categories{% endblock %}

{% block content %}
<style>
    :root {
        --blush:#F0C4C4; --sage:#A8BCA1; --sage-deep:#7A9972;
        --ink:#1A1F2E; --ink-soft:#4A5568; --cream:#FAF8F5;
        --cream-warm:#F4F0EA; --gold:#C9A96E; --white:#FFFFFF;
        --border:rgba(26,31,46,0.08); --shadow-sm:0 2px 12px rgba(26,31,46,0.06);
        --shadow-md:0 8px 32px rgba(26,31,46,0.10); --radius:16px; --radius-sm:10px;
    }
    * { font-family:'Figtree',sans-serif; box-sizing:border-box; }
    @keyframes fadeUp { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:translateY(0)} }

    .page-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; flex-wrap:wrap; gap:12px; animation:fadeUp 0.4s ease both; }
    .page-eyebrow { font-size:10px; letter-spacing:0.2em; text-transform:uppercase; color:var(--gold); font-weight:600; margin-bottom:4px; }
    .page-title { font-family:'Nunito',sans-serif; font-size:26px; font-weight:800; color:var(--ink); line-height:1; }
    .page-sub { font-size:13px; color:var(--ink-soft); margin-top:2px; }

    .btn-add {
        display:inline-flex; align-items:center; gap:8px; padding:11px 22px;
        background:var(--ink); color:#fff; border-radius:40px; text-decoration:none;
        font-size:13.5px; font-weight:600; transition:all 0.22s;
        box-shadow:0 4px 16px rgba(26,31,46,0.18);
    }
    .btn-add:hover { background:var(--ink-soft); transform:translateY(-2px); color:#fff; }
    .btn-add-icon { width:22px; height:22px; background:linear-gradient(135deg,var(--blush),var(--sage)); border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; }

    /* Panel */
    .panel { background:var(--white); border-radius:var(--radius); border:1px solid var(--border); overflow:hidden; animation:fadeUp 0.4s 0.08s ease both; }
    .panel-header { padding:20px 24px 16px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--border); }
    .panel-title { font-family:'Nunito',sans-serif; font-size:15px; font-weight:800; color:var(--ink); }
    .panel-count { background:var(--cream); border-radius:12px; padding:4px 12px; font-size:12px; font-weight:700; color:var(--ink-soft); }

    /* Table */
    .cat-table { width:100%; border-collapse:collapse; }
    .cat-table thead th {
        padding:12px 20px; text-align:left; font-size:10px; font-weight:700;
        letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft);
        background:var(--cream); border-bottom:1px solid var(--border);
    }
    .cat-table tbody td { padding:14px 20px; border-bottom:1px solid var(--border); vertical-align:middle; font-size:13.5px; color:var(--ink); }
    .cat-table tbody tr:last-child td { border-bottom:none; }
    .cat-table tbody tr:hover td { background:var(--cream); }

    .cat-name-cell { display:flex; align-items:center; gap:10px; }
    .cat-icon { width:32px; height:32px; border-radius:9px; background:linear-gradient(135deg,rgba(240,196,196,0.2),rgba(168,188,161,0.2)); display:flex; align-items:center; justify-content:center; border:1px solid var(--border); flex-shrink:0; }
    .cat-name { font-weight:600; color:var(--ink); }
    .cat-id { font-size:11px; color:var(--ink-soft); font-family:'Nunito',sans-serif; font-weight:700; }

    .actions { display:flex; gap:6px; align-items:center; }
    .btn-action { padding:7px 14px; border-radius:8px; text-decoration:none; font-size:12px; font-weight:600; transition:all 0.18s; display:inline-flex; align-items:center; gap:5px; border:1px solid transparent; cursor:pointer; font-family:'Figtree',sans-serif; }
    .btn-view   { background:var(--cream); color:var(--ink-soft); border-color:var(--border); }
    .btn-view:hover   { background:var(--cream-warm); color:var(--ink); }
    .btn-edit   { background:rgba(240,196,196,0.14); color:#b86060; border-color:rgba(240,196,196,0.3); }
    .btn-edit:hover   { background:var(--blush); color:#fff; border-color:var(--blush); }
    .btn-delete { background:rgba(231,76,60,0.07); color:#c0392b; border-color:rgba(231,76,60,0.18); }
    .btn-delete:hover { background:#e74c3c; color:#fff; border-color:#e74c3c; }
    .btn-disabled { background:rgba(200,200,200,0.12); color:#bbb; border-color:rgba(200,200,200,0.2); cursor:not-allowed; opacity:0.6; pointer-events:none; }

    /* DataTables overrides */
    .dataTables_wrapper { padding:0; }
    .dataTables_wrapper .dataTables_length { padding:14px 20px 0; }
    .dataTables_wrapper .dataTables_filter { padding:14px 20px 0; text-align:right; }
    .dataTables_wrapper .dataTables_length label,
    .dataTables_wrapper .dataTables_filter label { font-size:12px; color:var(--ink-soft); }
    .dataTables_wrapper .dataTables_length select,
    .dataTables_wrapper .dataTables_filter input {
        padding:6px 10px; border:1px solid var(--border); border-radius:7px;
        background:var(--cream); font-size:12px; color:var(--ink); outline:none;
        font-family:'Figtree',sans-serif; margin:0 4px;
    }
    .dataTables_wrapper .dataTables_filter input:focus { border-color:var(--blush); box-shadow:0 0 0 3px rgba(240,196,196,0.15); }
    .dataTables_wrapper .dataTables_info { padding:12px 20px; font-size:12px; color:var(--ink-soft); }
    .dataTables_wrapper .dataTables_paginate { padding:12px 20px; display:flex; justify-content:flex-end; gap:4px; }
    .dataTables_wrapper .dataTables_paginate .paginate_button { padding:6px 12px !important; border-radius:7px !important; font-size:12px; font-weight:600; color:var(--ink-soft) !important; cursor:pointer; border:1px solid var(--border) !important; background:var(--cream) !important; transition:all 0.2s; }
    .dataTables_wrapper .dataTables_paginate .paginate_button:hover { background:var(--cream-warm) !important; color:var(--ink) !important; }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current { background:var(--ink) !important; color:#fff !important; border-color:var(--ink) !important; }
    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled { opacity:0.4; cursor:not-allowed; }
    table.dataTable thead th { border-bottom:1px solid var(--border) !important; }
    table.dataTable.no-footer { border-bottom:none !important; }
    .top-bar { display:flex; justify-content:space-between; align-items:center; padding:14px 20px 0; }
</style>

<div class="page-header">
    <div>
        <div class="page-eyebrow">Inventory</div>
        <div class="page-title">Categories</div>
        <div class="page-sub">Manage your product categories</div>
    </div>
    <a href="{{ path('app_category_new') }}" class="btn-add">
        <span class="btn-add-icon"><i data-lucide="plus" style="width:13px;height:13px;stroke:white;stroke-width:2.5;"></i></span>
        Add Category
    </a>
</div>

<div class="panel">
    <div class="panel-header">
        <span class="panel-title">All Categories</span>
        <span class="panel-count">{{ categories|length }} items</span>
    </div>

    <table class="cat-table" id="categoriesTable">
        <thead>
            <tr>
                <th>ID</th>
                <th>Category Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for category in categories %}
            {% set isAdmin = is_granted('ROLE_ADMIN') %}
            {% set isCreator = category.createdBy is defined and category.createdBy and app.user and category.createdBy.id == app.user.id %}
            {% set canEdit = isAdmin or isCreator %}
            <tr>
                <td><span class="cat-id">#{{ category.id }}</span></td>
                <td>
                    <div class="cat-name-cell">
                        <div class="cat-icon"><i data-lucide="tag" style="width:14px;height:14px;stroke:var(--sage-deep);stroke-width:1.75;"></i></div>
                        <span class="cat-name">{{ category.name }}</span>
                    </div>
                </td>
                <td>
                    <div class="actions">
                        <a href="{{ path('app_category_show', {'id': category.id}) }}" class="btn-action btn-view">
                            <i data-lucide="eye" style="width:12px;height:12px;stroke:currentColor;stroke-width:2;"></i> View
                        </a>
                        {% if canEdit %}
                            <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn-action btn-edit">
                                <i data-lucide="pencil" style="width:12px;height:12px;stroke:currentColor;stroke-width:2;"></i> Edit
                            </a>
                            <form method="post" action="{{ path('app_category_delete', {'id': category.id}) }}" style="display:inline;" onsubmit="return confirm('Delete {{ category.name }}?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                                <button type="submit" class="btn-action btn-delete">
                                    <i data-lucide="trash-2" style="width:12px;height:12px;stroke:currentColor;stroke-width:2;"></i> Delete
                                </button>
                            </form>
                        {% else %}
                            <span class="btn-action btn-disabled">Edit</span>
                            <span class="btn-action btn-disabled">Delete</span>
                        {% endif %}
                    </div>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}

{% block extra_scripts %}
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css">
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script>
$(document).ready(function() {
    $('#categoriesTable').DataTable({
        pageLength: 10,
        lengthMenu: [10, 25, 50],
        order: [[0, 'asc']],
        columnDefs: [{ orderable: false, targets: 2 }],
        language: {
            searchPlaceholder: 'Search categories...',
            lengthMenu: 'Show _MENU_ entries',
            info: 'Showing _START_ to _END_ of _TOTAL_ categories',
            paginate: { previous: '←', next: '→' }
        },
        dom: '<"top-bar"lf>rt<"bottom"ip>'
    });
});
</script>
{% endblock %}
