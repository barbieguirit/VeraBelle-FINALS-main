{% extends 'base_landing.html.twig' %}

{% block title %}VeraBelle Collection — Fashion with Purpose{% endblock %}
{% block meta_desc %}VeraBelle Collection — curated Filipino clothing & fashion for modern women. Based in Dumaguete City.{% endblock %}

{% block body %}

<style>
:root {
    --ivory: #F9F4EE;
    --parchment: #EFE6D8;
    --mauve: #C4A0A0;
    --deep-mauve: #9E6F6F;
    --sage: #8FAF8C;
    --deep-sage: #5C7A5A;
    --charcoal: #3A3232;
    --warm-gray: #7A6F6F;
    --blush: #E8CECE;
}

body {
    font-family: 'Nunito', sans-serif;
    background-color: var(--ivory);
    color: var(--charcoal);
}

h1, h2, h3, h4, h5, h6 {
    font-family: 'Nunito', sans-serif;
    color: var(--charcoal);
    font-weight: 700;
}

em {
    color: var(--deep-mauve);
    font-style: normal;
    font-weight: 700;
}

.btn-fill {
    background: linear-gradient(135deg, var(--mauve), var(--deep-mauve));
    color: white;
    border: none;
    border-radius: 12px;
    padding: 13px 28px;
    font-family: 'Nunito', sans-serif;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 1px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
    cursor: pointer;
}

.btn-fill:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(158, 111, 111, 0.3);
}

.btn-outline {
    background: transparent;
    color: var(--deep-sage);
    border: 2px solid var(--sage);
    border-radius: 12px;
    padding: 11px 26px;
    font-family: 'Nunito', sans-serif;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 1px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
    cursor: pointer;
}

.btn-outline:hover {
    background: var(--sage);
    color: white;
    border-color: var(--sage);
}

.section-eyebrow {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--warm-gray);
    margin-bottom: 12px;
}

.section-title {
    font-size: 36px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--charcoal);
    margin-bottom: 24px;
}

@media (max-width: 768px) {
    .section-title {
        font-size: 28px;
    }
}

.hero-title {
    font-size: 48px;
    font-weight: 700;
    line-height: 1.1;
    color: var(--charcoal);
}

.hero-desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--warm-gray);
    font-weight: 300;
}

.hero-eyebrow {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--sage);
    margin-bottom: 16px;
}

.story-tagline {
    font-size: 18px;
    line-height: 1.5;
    color: var(--charcoal);
    font-weight: 600;
    margin-bottom: 16px;
}

.story-body {
    font-size: 14px;
    line-height: 1.7;
    color: var(--warm-gray);
    margin-bottom: 16px;
    font-weight: 300;
}

.team-name {
    font-size: 14px;
    font-weight: 700;
    color: var(--charcoal);
    margin-top: 12px;
}

.team-role {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--sage);
    margin-bottom: 8px;
}

.team-bio {
    font-size: 12px;
    line-height: 1.5;
    color: var(--warm-gray);
    font-weight: 300;
}

/* Team photos — ensure profile image fills the card nicely */
.team-photo-fill img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

/* Hide initial letters now that a real photo is used */
.team-photo-initials {
    display: none;
}

.contact-desc {
    font-size: 14px;
    line-height: 1.7;
    color: var(--warm-gray);
    margin-bottom: 24px;
    font-weight: 300;
}

.c-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(245, 240, 232, 0.75);
    margin-bottom: 4px;
}

.c-val {
    font-size: 14px;
    color: #F5F0E8;
    font-weight: 600;
}

.f-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--warm-gray);
    margin-bottom: 8px;
    display: block;
}

.f-input, .f-select, .f-textarea {
    font-family: 'Nunito', sans-serif;
    font-size: 14px;
    color: var(--charcoal);
    background: rgba(239, 230, 216, 0.5);
    border: 1.5px solid rgba(196, 160, 160, 0.3);
    border-radius: 8px;
    padding: 12px 14px;
    transition: all 0.3s ease;
}

.f-input:focus, .f-select:focus, .f-textarea:focus {
    outline: none;
    background: #fff;
    border-color: var(--mauve);
    box-shadow: 0 0 0 3px rgba(196, 160, 160, 0.12);
}

.f-submit {
    background: linear-gradient(135deg, var(--mauve), var(--deep-mauve));
    color: white;
    border: none;
    border-radius: 8px;
    padding: 12px 28px;
    font-family: 'Nunito', sans-serif;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    width: 100%;
}

.f-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(158, 111, 111, 0.3);
}

.flash-ok {
    background: rgba(143, 175, 140, 0.15);
    border-left: 3px solid var(--deep-sage);
    border-radius: 6px;
    padding: 12px 14px;
    margin-bottom: 16px;
    color: var(--deep-sage);
    font-size: 13px;
    font-weight: 500;
}

.flash-err {
    background: rgba(196, 160, 160, 0.15);
    border-left: 3px solid var(--deep-mauve);
    border-radius: 6px;
    padding: 12px 14px;
    margin-bottom: 16px;
    color: var(--deep-mauve);
    font-size: 13px;
    font-weight: 500;
}

.prod-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--charcoal);
}

.prod-cat {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--warm-gray);
    margin-bottom: 6px;
}

.prod-price {
    font-size: 13px;
    color: var(--charcoal);
    font-weight: 600;
}

.ticker-item {
    color: var(--warm-gray);
    font-size: 12px;
    font-weight: 600;
}

.challenges-section {
    position: relative;
    padding: 110px 40px;
    background: #ffffff;
}

.challenges-shell {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
}

.challenges-orb {
    display: none;
}

.challenges-orb-a {
    display: none;
}

.challenges-orb-b {
    display: none;
}

.challenges-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 56px;
}

.challenge-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--deep-sage);
    margin-bottom: 10px;
}

.challenge-kicker::before {
    content: '';
    width: 22px;
    height: 1px;
    background: rgba(92, 122, 90, 0.55);
}

.challenge-header-copy {
    max-width: 520px;
    color: var(--warm-gray);
    font-size: 15px;
    line-height: 1.7;
    font-weight: 300;
    margin: 0;
}

.challenges-chip {
    background: rgba(58, 50, 50, 0.06);
    border: 1px solid rgba(58, 50, 50, 0.12);
    border-radius: 999px;
    padding: 9px 16px;
    color: var(--charcoal);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    white-space: nowrap;
}

.challenges-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 22px;
    margin-bottom: 46px;
}

.challenge-card {
    background: rgba(255, 255, 255, 0.74);
    border: 1px solid rgba(196, 160, 160, 0.26);
    border-radius: 18px;
    padding: 22px;
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    display: flex;
    flex-direction: column;
    min-height: 250px;
    box-shadow: 0 14px 34px rgba(58, 50, 50, 0.07);
    transition: transform 0.32s ease, box-shadow 0.32s ease, border-color 0.32s ease;
}

.challenge-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 38px rgba(58, 50, 50, 0.14);
    border-color: rgba(158, 111, 111, 0.5);
}

.challenge-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
}

.challenge-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--deep-mauve);
}

.challenge-status::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--deep-mauve);
    box-shadow: 0 0 0 5px rgba(158, 111, 111, 0.14);
}

.challenge-date {
    background: rgba(239, 230, 216, 0.95);
    border: 1px solid rgba(196, 160, 160, 0.35);
    border-radius: 999px;
    padding: 6px 10px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--warm-gray);
}

.challenge-title {
    font-family: 'Playfair Display', serif;
    font-size: 25px;
    font-weight: 500;
    line-height: 1.22;
    color: var(--charcoal);
    margin: 0 0 12px;
}

.challenge-copy {
    color: var(--warm-gray);
    font-size: 13px;
    line-height: 1.8;
    margin: 0;
}

.challenge-card-footer {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid rgba(196, 160, 160, 0.22);
}

.challenge-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--deep-mauve);
    text-decoration: none;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    transition: gap 0.25s ease, color 0.25s ease;
}

.challenge-link:hover {
    gap: 12px;
    color: #7d5050;
}

.challenges-empty {
    text-align: center;
    padding: 66px 22px;
    border-radius: 20px;
    border: 1px solid rgba(196, 160, 160, 0.25);
    background: rgba(255, 255, 255, 0.7);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.45);
    margin-bottom: 46px;
}

.challenges-empty-title {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    font-weight: 500;
    margin: 0 0 10px;
}

.challenges-empty-copy {
    color: var(--warm-gray);
    font-size: 14px;
    margin: 0;
}

.challenges-cta {
    text-align: center;
}

@media (max-width: 860px) {
    .challenges-section {
        padding: 84px 24px;
    }

    .challenges-header {
        flex-direction: column;
        align-items: flex-start;
        margin-bottom: 38px;
    }

    .challenges-grid {
        gap: 18px;
    }

    .challenge-card {
        min-height: 228px;
    }
}
</style>
{# ══════════════════════════════
   SECTION 1 — HERO BANNER (full-screen)
══════════════════════════════ #}
<section id="home" style="position:relative; overflow:hidden; min-height:100vh;">

  {# Background Photo — swap URL for your own image anytime #}
  <img
    src="/uploads/hero2.jpg"
    alt="VeraBelle Collection editorial"
    style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center top; z-index:0;">

  {# Dark gradient overlay — left is darker so text pops #}
  <div style="position:absolute; inset:0; background:linear-gradient(105deg, rgba(20,15,15,0.75) 0%, rgba(20,15,15,0.45) 55%, rgba(20,15,15,0.1) 100%); z-index:1;"></div>

  {# Season badge top-right #}
  <div style="position:absolute; top:28px; right:28px; z-index:3; background:rgba(249,244,238,0.12); border:1px solid rgba(249,244,238,0.25); color:rgba(249,244,238,0.85); font-size:9px; font-weight:700; letter-spacing:2px; text-transform:uppercase; padding:7px 16px; border-radius:20px;">
    SS 2025 Collection
  </div>

  {# Main content — bottom-left #}
  <div style="position:relative; z-index:2; display:flex; flex-direction:column; justify-content:flex-end; min-height:100vh; padding:52px 60px;">

    <div style="display:inline-flex; align-items:center; gap:10px; font-size:9px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:rgba(249,244,238,0.65); margin-bottom:20px;">
      <span style="display:block; width:28px; height:1px; background:rgba(143,175,140,0.8);"></span>
      Spring / Summer 2025 &nbsp;·&nbsp; Dumaguete City
    </div>

    <h1 style="font-family:'Playfair Display',serif; font-size:72px; font-weight:700; line-height:1.0; color:#F9F4EE; margin-bottom:22px; max-width:560px;">
      Wear Your<br><em style="font-style:italic; color:#E8CECE;">Story.</em>
    </h1>

    <p style="font-size:15px; line-height:1.65; color:rgba(249,244,238,0.7); font-weight:300; max-width:400px; margin-bottom:36px;">
      VeraBelle Collection is a Dumaguete-born fashion label that dresses
      bold women in thoughtfully curated, locally inspired clothing.
    </p>

    <div style="display:flex; gap:14px; flex-wrap:wrap; margin-bottom:52px;">
      <a href="{{ path('app_shop') }}" style="background:rgba(196,160,160,0.92); color:#3A3232; border:none; border-radius:10px; padding:13px 26px; font-family:'Nunito',sans-serif; font-weight:700; font-size:12px; letter-spacing:1.5px; text-transform:uppercase; text-decoration:none;">Explore Collection</a>
      <a href="{{ path('app_about') }}" style="background:transparent; color:#F9F4EE; border:1.5px solid rgba(249,244,238,0.45); border-radius:10px; padding:12px 24px; font-family:'Nunito',sans-serif; font-weight:600; font-size:12px; letter-spacing:1.5px; text-transform:uppercase; text-decoration:none;">Our Story →</a>
    </div>

    <div style="display:flex; gap:32px; padding-top:28px; border-top:1px solid rgba(249,244,238,0.15);">
      <div>
        <div style="font-family:'Playfair Display',serif; font-size:26px; font-weight:700; color:#F9F4EE;">5+</div>
        <div style="font-size:9px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:rgba(249,244,238,0.5); margin-top:3px;">Years</div>
      </div>
      <div>
        <div style="font-family:'Playfair Display',serif; font-size:26px; font-weight:700; color:#F9F4EE;">200+</div>
        <div style="font-size:9px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:rgba(249,244,238,0.5); margin-top:3px;">Pieces</div>
      </div>
      <div>
        <div style="font-family:'Playfair Display',serif; font-size:26px; font-weight:700; color:#F9F4EE;">500+</div>
        <div style="font-size:9px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:rgba(249,244,238,0.5); margin-top:3px;">Clients</div>
      </div>
    </div>
  </div>

  {# Scroll cue bottom-right #}
  <div aria-hidden="true" style="position:absolute; bottom:32px; right:32px; z-index:3; display:flex; flex-direction:column; align-items:center; gap:8px; color:rgba(249,244,238,0.35); font-size:8px; font-weight:700; letter-spacing:2px; text-transform:uppercase;">
    <div style="width:1px; height:40px; background:rgba(249,244,238,0.25);"></div>
    Scroll
  </div>

</section>

{# ══════════════════════════════
   SECTION 2 — PRODUCTS / COLLECTION
══════════════════════════════ #}
<section id="products">
    <div class="products-header reveal">
        <div>
            <div class="section-eyebrow">Our Collection</div>
            <h2 class="section-title">
                Dressed to<br><em>Be Felt.</em>
            </h2>
        </div>
        <a href="{{ path('app_shop') }}" class="see-all-link">
            View All Pieces →
        </a>
    </div>

    {# Editorial grid — first card spans 2 rows #}
    <div class="products-editorial">

        {% if products is defined and products|length > 0 %}
            {% for product in products %}
            <div class="prod-card {{ loop.first ? 'large' : '' }} reveal" style="transition-delay:{{ loop.index0 * 0.05 }}s">
                <div class="prod-img">
                    {% if product.image %}
                        <img src="/uploads/{{ product.image }}" alt="{{ product.name }}"
                             style="width:100%;height:100%;object-fit:cover;transition:transform 0.5s cubic-bezier(0.22,1,0.36,1);">
                    {% else %}
                        <div class="prod-img-fill" style="background:linear-gradient(155deg, var(--mauve), var(--deep-mauve));">
                            <div class="prod-img-glyph">{{ product.name|slice(0,2)|upper }}</div>
                        </div>
                    {% endif %}
                    {% if loop.first %}<span class="prod-badge">New</span>{% endif %}
                    <div class="prod-hover-cta">
                        <a href="{{ path('app_product_show', {id: product.id}) }}" class="prod-hover-btn">View Piece</a>
                        {% if product.stock > 0 %}
                        <button class="prod-hover-btn" style="background:var(--deep-mauve);color:white;border:none;cursor:pointer;"
                                onclick="addToCart({{ product.id }}, '{{ product.name|escape('js') }}', {{ product.price }}, this)">Add to Cart</button>
                        {% endif %}
                    </div>
                </div>
                <div class="prod-info">
                    <div class="prod-cat">{{ product.category ? product.category.name : 'Collection' }}</div>
                    <div class="prod-name">{{ product.name }}</div>
                    <div class="prod-price"><strong>₱{{ "%.0f"|format(product.price) }}</strong></div>
                </div>
            </div>
            {% endfor %}
        {% else %}
            {# Fallback placeholders if no products in DB #}
            <div class="prod-card large reveal">
                <div class="prod-img">
                    <div class="prod-img-fill" style="background:linear-gradient(155deg, var(--deep-sage), var(--charcoal));">
                        <div class="prod-img-glyph">Vb</div>
                    </div>
                    <span class="prod-badge">New</span>
                    <div class="prod-hover-cta">
                        <a href="{{ path('app_shop') }}" class="prod-hover-btn">View Piece</a>
                    </div>
                </div>
                <div class="prod-info">
                    <div class="prod-cat">Featured · Dress</div>
                    <div class="prod-name">The Palengke Shift</div>
                    <div class="prod-price"><strong>₱2,450</strong></div>
                </div>
            </div>
        {% endif %}

    </div>
</section>

{# ══════════════════════════════
   SECTION 3 — OUR STORY
══════════════════════════════ #}
<section id="story">
    <div class="story-left" style="background:url('/uploads/section3.JPG') center/cover no-repeat;">
        <div class="story-gradient"></div>
        <div class="story-bg-word" aria-hidden="true">VeraBelle</div>

        <div class="story-year-tag" aria-hidden="true">2020</div>
        <p class="story-tagline">
            "Fashion is the armor<br>to survive everyday life."
        </p>
        <div class="story-divider"></div>
        <div class="story-mini-stats">
            <div>
                <div class="story-stat-n">5+</div>
                <div class="story-stat-l">Years</div>
            </div>
            <div>
                <div class="story-stat-n">200+</div>
                <div class="story-stat-l">Pieces</div>
            </div>
            <div>
                <div class="story-stat-n">500+</div>
                <div class="story-stat-l">Clients</div>
            </div>
        </div>
    </div>

    <div class="story-right">
        <div class="section-eyebrow reveal-right">Our Story</div>
        <h2 class="section-title reveal-right" style="transition-delay:0.1s">
            Born in<br><em>Dumaguete.</em>
        </h2>

        <p class="story-body reveal-right" style="transition-delay:0.2s">
            VeraBelle Collection started in 2020 as a personal project — a small rack of
            hand-sourced pieces curated for women who wanted to dress with intention.
            What began in a spare bedroom in Dumaguete City has grown into a label
            that local women trust to make them feel powerful, comfortable, and seen.
        </p>
        <p class="story-body reveal-right" style="transition-delay:0.3s">
            We don't chase trends. We build wardrobes. Each piece is chosen or created
            because we believe it earns its place in a real woman's life — office meeting,
            market run, sunset dinner, or everything in between.
        </p>

        <div class="story-cta reveal-right" style="transition-delay:0.4s">
            <a href="{{ path('app_about') }}" class="btn-fill">Read the Full Story</a>
        </div>
    </div>
</section>

{# ══════════════════════════════
   SECTION — FASHION CHALLENGES
══════════════════════════════ #}
<section id="challenges" style="padding:100px 40px; background:var(--ivory); position:relative; overflow:hidden;">
    <!-- Background decoration -->
    <div style="position:absolute;top:-100px;right:-100px;width:400px;height:400px;background:radial-gradient(circle,rgba(196,160,160,0.08) 0%,transparent 65%);pointer-events:none;"></div>
    <div style="position:absolute;bottom:-80px;left:-80px;width:350px;height:350px;background:radial-gradient(circle,rgba(143,175,140,0.07) 0%,transparent 65%);pointer-events:none;"></div>

    <div style="max-width:1200px;margin:0 auto;position:relative;z-index:1;">

        <!-- Header -->
        <div class="reveal" style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:56px;flex-wrap:wrap;gap:24px;">
            <div>
                <div class="section-eyebrow">Community</div>
                <h2 class="section-title">Fashion <em>Challenges.</em></h2>
                <p style="font-size:15px;color:var(--warm-gray);margin-top:12px;font-weight:300;max-width:420px;line-height:1.7;">
                    Show your style, win prizes, and be part of our growing fashion community.
                </p>
            </div>
            <a href="{{ path('app_challenge_index') }}" class="btn-fill" style="white-space:nowrap;">View All Challenges →</a>
        </div>

        <!-- Challenge Cards -->
        {% if challenges is defined and challenges|length > 0 %}
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:20px;margin-bottom:48px;">
            {% for challenge in challenges %}
            <article class="reveal" style="background:white;border:1px solid rgba(196,160,160,0.15);border-radius:16px;padding:28px;transition:all 0.3s;transition-delay:{{ loop.index0 * 0.07 }}s;box-shadow:0 2px 12px rgba(58,50,50,0.05);" onmouseover="this.style.transform='translateY(-4px)';this.style.boxShadow='0 12px 32px rgba(58,50,50,0.1)'" onmouseout="this.style.transform='translateY(0)';this.style.boxShadow='0 2px 12px rgba(58,50,50,0.05)'">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;">
                    <span style="display:inline-flex;align-items:center;gap:7px;font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--deep-mauve);">
                        <span style="width:7px;height:7px;border-radius:50%;background:var(--deep-mauve);box-shadow:0 0 0 4px rgba(158,111,111,0.15);display:inline-block;"></span>
                        Active
                    </span>
                    <span style="background:var(--parchment);border:1px solid rgba(196,160,160,0.25);border-radius:20px;padding:5px 12px;font-size:10px;font-weight:700;color:var(--warm-gray);">
                        Ends {{ challenge.endDate|date('M d, Y') }}
                    </span>
                </div>
                <h3 style="font-family:'Playfair Display',serif;font-size:22px;font-weight:400;color:var(--charcoal);margin:0 0 10px;line-height:1.3;">{{ challenge.title }}</h3>
                <p style="font-size:13px;color:var(--warm-gray);line-height:1.8;margin:0 0 20px;font-weight:300;">
                    {{ challenge.description|slice(0,110) }}{% if challenge.description|length > 110 %}…{% endif %}
                </p>
                <div style="padding-top:16px;border-top:1px solid rgba(196,160,160,0.15);display:flex;align-items:center;justify-content:space-between;">
                    <a href="{{ path('app_challenge_view', {id: challenge.id}) }}" style="display:inline-flex;align-items:center;gap:6px;color:var(--deep-mauve);text-decoration:none;font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;">
                        View Entries →
                    </a>
                    <a href="{{ path('app_challenge_submit', {id: challenge.id}) }}" style="display:inline-flex;align-items:center;gap:6px;padding:9px 18px;background:linear-gradient(135deg,var(--mauve),var(--deep-mauve));color:white;border-radius:8px;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;text-decoration:none;">
                        Submit →
                    </a>
                </div>
            </article>
            {% endfor %}
        </div>
        {% else %}
        <div class="reveal" style="text-align:center;padding:60px 20px;border:1px solid rgba(196,160,160,0.2);border-radius:16px;background:white;margin-bottom:48px;">
            <div style="font-size:48px;margin-bottom:14px;opacity:0.4;">✨</div>
            <h3 style="font-family:'Playfair Display',serif;font-size:24px;font-weight:300;color:var(--charcoal);margin-bottom:8px;">Challenges Coming Soon</h3>
            <p style="color:var(--warm-gray);font-size:14px;font-weight:300;">Stay tuned for exciting fashion challenges and prizes.</p>
        </div>
        {% endif %}

        <!-- Hall of Fame teaser -->
        <div class="reveal" style="display:flex;align-items:center;justify-content:space-between;padding:24px 28px;background:white;border:1px solid rgba(196,160,160,0.2);border-radius:14px;flex-wrap:wrap;gap:16px;box-shadow:0 2px 12px rgba(58,50,50,0.05);">
            <div style="display:flex;align-items:center;gap:14px;">
                <span style="font-size:28px;">🏆</span>
                <div>
                    <div style="font-size:13px;font-weight:700;color:var(--charcoal);">Hall of Fame</div>
                    <div style="font-size:12px;color:var(--warm-gray);margin-top:2px;">See our past winners and top entries</div>
                </div>
            </div>
            <a href="{{ path('app_challenge_hall_of_fame') }}" class="btn-fill">View Hall of Fame →</a>
        </div>
    </div>
</section>

{# ══════════════════════════════
   SECTION 4 — OUR TEAM
══════════════════════════════ #}
<section id="team">
    <div class="reveal" style="margin-bottom:0">
        <div class="section-eyebrow">The People Behind</div>
        <h2 class="section-title">Our <em>Team.</em></h2>
    </div>

    {% set team = [
        {
            name: 'Barbie Guirit',
            role: 'Founder & Creative Director',
            initials: 'VS',
            bg: 'linear-gradient(155deg, var(--deep-sage), var(--charcoal))',
            bio: 'The visionary behind every collection. Vera built VeraBelle from a love of fashion and a belief that every Filipino woman deserves to look extraordinary.'
        },
        {
            name: 'Barbie Guirit',
            role: 'Head of Styling & Curation',
            initials: 'MC',
            bg: 'linear-gradient(155deg, var(--mauve), var(--deep-mauve))',
            bio: 'Barbie has an eye that does not miss. She selects and styles every piece in the collection, ensuring each one earns its place.'
        },
        {
            name: 'Barbie Guirit',
            role: 'Operations & Logistics',
            initials: 'JL',
            bg: 'linear-gradient(155deg, var(--sage), var(--deep-sage))',
            bio: 'Barbie keeps the wheels turning — from supplier relationships to last-mile delivery. She is the reason your order arrives on time.'
        },
        {
            name: 'Barbie Guirit',
            role: 'Client Experience Lead',
            initials: 'AR',
            bg: 'linear-gradient(155deg, var(--parchment), var(--blush))',
            bio: 'Barbie is the first voice you hear when you reach out. She treats every client like a VIP because, to us, they are.'
        }
    ] %}

    <div class="team-grid">
        {% for i, member in team %}
        <div class="team-card reveal" style="transition-delay:{{ i * 0.1 }}s">
            <div class="team-photo">
                <div class="team-photo-fill" style="background: {{ member.bg }};">
                    <img src="/uploads/team.jpg" alt="{{ member.name }}" class="team-photo-img">
                </div>
                <div class="team-overlay">
                    <div class="team-social-row">
                        <a href="#" class="team-social">Fb</a>
                        <a href="#" class="team-social">Ig</a>
                        <a href="{{ path('app_landing') }}#contact" class="team-social">@</a>
                    </div>
                </div>
            </div>
            <div class="team-name">{{ member.name }}</div>
            <div class="team-role">{{ member.role }}</div>
            <p class="team-bio">{{ member.bio }}</p>
        </div>
        {% endfor %}
    </div>
</section>

{# ══════════════════════════════
   SECTION 5 — CONTACT US
══════════════════════════════ #}
<section id="contact">
    <div class="contact-bg-text" aria-hidden="true">Contact</div>

    <div class="contact-grid">
        {# Left: info #}
        <div class="contact-left">
            <div class="section-eyebrow reveal-left">Get In Touch</div>
            <h2 class="section-title reveal-left" style="transition-delay:0.1s">
                Let's Start a<br><em>Conversation.</em>
            </h2>
            <p class="contact-desc reveal-left" style="transition-delay:0.2s">
                Whether you're after a specific piece, a custom styling session,
                a collaboration proposal, or just want to say hello — we'd love to hear from you.
            </p>

            <div class="contact-info-list reveal-left" style="transition-delay:0.3s">
                <div class="contact-info-item">
                    <div class="c-icon">📍</div>
                    <div>
                        <div class="c-label">Studio Location</div>
                        <div class="c-val">Dumaguete City, Negros Oriental 6200</div>
                    </div>
                </div>
                <div class="contact-info-item">
                    <div class="c-icon">✉️</div>
                    <div>
                        <div class="c-label">Email Us</div>
                        <div class="c-val">hello@verabellecollection.com</div>
                    </div>
                </div>
                <div class="contact-info-item">
                    <div class="c-icon">📱</div>
                    <div>
                        <div class="c-label">WhatsApp / Call</div>
                        <div class="c-val">+63 912 345 6789</div>
                    </div>
                </div>
                <div class="contact-info-item">
                    <div class="c-icon">🕐</div>
                    <div>
                        <div class="c-label">Studio Hours</div>
                        <div class="c-val">Mon – Sat &nbsp;·&nbsp; 9 AM – 6 PM</div>
                    </div>
                </div>
            </div>
        </div>

        {# Right: form #}
        <div class="contact-form-box reveal-right">
            <p class="form-heading">Send a Message</p>

            {% for msg in app.flashes('contact_success') %}
                <div class="flash-ok">✓ &nbsp; {{ msg }}</div>
            {% endfor %}
            {% for msg in app.flashes('contact_error') %}
                <div class="flash-err">✗ &nbsp; {{ msg }}</div>
            {% endfor %}

            <form action="{{ path('app_contact') }}" method="POST" id="contactForm">
                <input type="hidden" name="_token" value="{{ csrf_token('contact') }}">
                <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off">

                <div class="f-row">
                    <div class="f-group">
                        <label class="f-label" for="cf_first">First Name *</label>
                        <input class="f-input" type="text" id="cf_first" name="firstName" placeholder="Maria" required>
                        <span class="f-underline"></span>
                    </div>
                    <div class="f-group">
                        <label class="f-label" for="cf_last">Last Name</label>
                        <input class="f-input" type="text" id="cf_last" name="lastName" placeholder="Cruz">
                        <span class="f-underline"></span>
                    </div>
                </div>

                <div class="f-group">
                    <label class="f-label" for="cf_email">Email Address *</label>
                    <input class="f-input" type="email" id="cf_email" name="email" placeholder="maria@example.com" required>
                    <span class="f-underline"></span>
                </div>

                <div class="f-group">
                    <label class="f-label" for="cf_phone">Phone / WhatsApp</label>
                    <input class="f-input" type="tel" id="cf_phone" name="phone" placeholder="+63 9XX XXX XXXX">
                    <span class="f-underline"></span>
                </div>

                <div class="f-group">
                    <label class="f-label" for="cf_subject">Subject *</label>
                    <select class="f-select" id="cf_subject" name="subject" required>
                        <option value="" disabled selected>Select a topic…</option>
                        <option>General Inquiry</option>
                        <option>Custom Styling Request</option>
                        <option>Wholesale / Bulk Order</option>
                        <option>Collaboration / Partnership</option>
                        <option>Shipping & Delivery</option>
                        <option>Returns & Exchanges</option>
                        <option>Press / Media</option>
                        <option>Other</option>
                    </select>
                    <span class="f-underline"></span>
                </div>

                <div class="f-group">
                    <label class="f-label" for="cf_msg">Message *</label>
                    <textarea class="f-textarea" id="cf_msg" name="message" placeholder="Tell us how we can help…" required></textarea>
                    <span class="f-underline"></span>
                </div>

                <button type="submit" class="f-submit" id="submitBtn">
                    Send Message
                </button>
            </form>
        </div>
    </div>
</section>

{% endblock %}

{% block extra_scripts %}
<script>
// Submit loading state
document.getElementById('contactForm')?.addEventListener('submit', function() {
    const btn = document.getElementById('submitBtn');
    if (btn) { btn.textContent = 'Sending…'; btn.disabled = true; }
});
</script>
{% endblock %}