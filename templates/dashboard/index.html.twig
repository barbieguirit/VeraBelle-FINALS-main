{% extends 'base_dashboard.html.twig' %}

{% block title %}Dashboard — VeraBelle Collection{% endblock %}
{% block page_title %}Dashboard{% endblock %}

{% block content %}
<style>
    :root {
        --mauve:#C4A0A0; --deep-mauve:#9E6F6F; --sage:#8FAF8C; --deep-sage:#5C7A5A;
        --charcoal:#3A3232; --warm-gray:#7A6F6F; --ivory:#F9F4EE; --parchment:#EFE6D8;
        --blush:#E8CECE; --gold:#C9A96E; --white:#FFFFFF;
        --border:rgba(58,50,50,0.08); --shadow-sm:0 2px 12px rgba(58,50,50,0.06);
        --shadow-md:0 8px 32px rgba(58,50,50,0.10); --r:16px; --r-sm:10px;
    }
    * { font-family:'Figtree',sans-serif; box-sizing:border-box; }
    @keyframes up { from{opacity:0;transform:translateY(16px)} to{opacity:1;transform:translateY(0)} }

    /* ── HERO ── */
    .hero {
        background: linear-gradient(135deg, #2A2020 0%, var(--charcoal) 100%);
        border-radius: var(--r); padding: 40px 48px; margin-bottom: 24px;
        display: flex; align-items: center; justify-content: space-between;
        position: relative; overflow: hidden; animation: up 0.4s ease both;
        border: 1px solid rgba(196,160,160,0.1);
    }
    .hero::before { content:''; position:absolute; top:-80px; right:80px; width:320px; height:320px; background:radial-gradient(circle,rgba(196,160,160,0.12) 0%,transparent 65%); pointer-events:none; }
    .hero::after  { content:''; position:absolute; bottom:-80px; right:-40px; width:280px; height:280px; background:radial-gradient(circle,rgba(143,175,140,0.08) 0%,transparent 65%); pointer-events:none; }
    .hero-left { position:relative; z-index:1; }
    .hero-tag { display:inline-flex; align-items:center; gap:8px; font-size:10px; font-weight:700; letter-spacing:4px; text-transform:uppercase; color:var(--gold); margin-bottom:12px; }
    .hero-tag::before { content:''; display:block; width:24px; height:1px; background:var(--gold); }
    .hero-name { font-family:'Nunito',sans-serif; font-size:34px; font-weight:800; color:#fff; line-height:1.1; margin-bottom:8px; }
    .hero-name em { font-style:italic; color:var(--mauve); }
    .hero-sub { font-size:13px; color:rgba(255,255,255,0.38); font-weight:300; }
    .hero-right { position:relative; z-index:1; text-align:right; }
    .hero-day { font-family:'Nunito',sans-serif; font-size:80px; font-weight:800; color:rgba(255,255,255,0.06); line-height:1; }
    .hero-date { font-size:11px; letter-spacing:2px; text-transform:uppercase; color:rgba(255,255,255,0.25); margin-top:-8px; }

    /* ── METRICS ── */
    .metrics { display:grid; grid-template-columns:repeat(6,1fr); gap:14px; margin-bottom:24px; animation:up 0.4s 0.08s ease both; }
    .mc {
        background:var(--white); border-radius:var(--r-sm); padding:20px 18px;
        border:1px solid var(--border); position:relative; overflow:hidden;
        transition:all 0.22s; text-decoration:none; display:block;
    }
    .mc:hover { transform:translateY(-4px); box-shadow:var(--shadow-md); border-color:transparent; }
    .mc::after { content:''; position:absolute; bottom:0; left:0; right:0; height:3px; opacity:0; transition:opacity 0.22s; border-radius:0 0 var(--r-sm) var(--r-sm); }
    .mc:hover::after { opacity:1; }
    .mc.m1::after { background:linear-gradient(90deg,var(--mauve),var(--deep-mauve)); }
    .mc.m2::after { background:linear-gradient(90deg,var(--sage),var(--deep-sage)); }
    .mc.m3::after { background:linear-gradient(90deg,var(--gold),#b8924a); }
    .mc.m4::after { background:linear-gradient(90deg,var(--mauve),var(--sage)); }
    .mc.m5::after { background:linear-gradient(90deg,var(--deep-sage),#3a5238); }
    .mc.m6::after { background:linear-gradient(90deg,var(--gold),var(--mauve)); }
    .mc-icon { width:38px; height:38px; border-radius:10px; display:flex; align-items:center; justify-content:center; margin-bottom:14px; }
    .mc.m1 .mc-icon { background:rgba(196,160,160,0.15); }
    .mc.m2 .mc-icon { background:rgba(143,175,140,0.15); }
    .mc.m3 .mc-icon { background:rgba(201,169,110,0.12); }
    .mc.m4 .mc-icon { background:rgba(196,160,160,0.1); }
    .mc.m5 .mc-icon { background:rgba(92,122,90,0.12); }
    .mc.m6 .mc-icon { background:rgba(201,169,110,0.1); }
    .mc-val { font-family:'Nunito',sans-serif; font-size:26px; font-weight:800; color:var(--charcoal); line-height:1; margin-bottom:4px; }
    .mc-lbl { font-size:11px; color:var(--warm-gray); font-weight:500; text-transform:uppercase; letter-spacing:0.05em; }

    /* ── GRID ── */
    .dash-grid { display:grid; grid-template-columns:1fr 360px; gap:20px; animation:up 0.4s 0.15s ease both; }

    /* ── PANEL ── */
    .panel { background:var(--white); border-radius:var(--r); border:1px solid var(--border); overflow:hidden; }
    .ph { padding:20px 24px 16px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--border); }
    .pt { font-family:'Nunito',sans-serif; font-size:15px; font-weight:800; color:var(--charcoal); }
    .pl { font-size:12px; color:var(--deep-sage); text-decoration:none; font-weight:600; transition:color 0.2s; }
    .pl:hover { color:var(--charcoal); }

    /* Orders */
    .order-list { padding:4px 0; }
    .oi { display:flex; align-items:center; gap:14px; padding:13px 24px; transition:background 0.15s; }
    .oi:hover { background:var(--ivory); }
    .oi-num { font-family:'Nunito',sans-serif; font-size:11px; font-weight:700; color:var(--warm-gray); min-width:32px; }
    .oi-info { flex:1; min-width:0; }
    .oi-name { font-size:13.5px; font-weight:600; color:var(--charcoal); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .oi-date { font-size:11px; color:var(--warm-gray); margin-top:2px; }
    .oi-right { display:flex; flex-direction:column; align-items:flex-end; gap:4px; flex-shrink:0; }
    .oi-amt { font-family:'Nunito',sans-serif; font-size:14px; font-weight:700; color:var(--deep-sage); }
    .oi-badge { font-size:10px; font-weight:700; padding:3px 9px; border-radius:20px; text-transform:capitalize; }
    .s-pending    { background:rgba(201,169,110,0.12); color:#8a6d2f; border:1px solid rgba(201,169,110,0.25); }
    .s-completed  { background:rgba(92,122,90,0.12); color:var(--deep-sage); border:1px solid rgba(92,122,90,0.22); }
    .s-processing { background:rgba(196,160,160,0.12); color:var(--deep-mauve); border:1px solid rgba(196,160,160,0.22); }
    .s-cancelled  { background:rgba(180,80,80,0.08); color:#b05050; border:1px solid rgba(180,80,80,0.18); }

    /* Quick actions */
    .qa-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; padding:16px; }
    .qa {
        display:flex; flex-direction:column; gap:8px; padding:16px 14px;
        border-radius:12px; background:var(--ivory); border:1px solid var(--border);
        text-decoration:none; transition:all 0.2s;
    }
    .qa:hover { background:var(--white); transform:translateY(-2px); box-shadow:var(--shadow-sm); }
    .qa-ic { width:34px; height:34px; border-radius:9px; display:flex; align-items:center; justify-content:center; }
    .qa-t { font-size:12.5px; font-weight:700; color:var(--charcoal); }
    .qa-d { font-size:11px; color:var(--warm-gray); line-height:1.4; }

    /* Products */
    .prod-list { padding:4px 0; }
    .pi { display:flex; align-items:center; justify-content:space-between; padding:12px 24px; transition:background 0.15s; gap:14px; }
    .pi:hover { background:var(--ivory); }
    .pi-left { display:flex; align-items:center; gap:12px; min-width:0; }
    .pi-av { width:36px; height:36px; border-radius:9px; background:linear-gradient(135deg,rgba(196,160,160,0.15),rgba(143,175,140,0.15)); display:flex; align-items:center; justify-content:center; flex-shrink:0; border:1px solid var(--border); overflow:hidden; }
    .pi-av img { width:100%; height:100%; object-fit:cover; }
    .pi-name { font-size:13.5px; font-weight:600; color:var(--charcoal); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .pi-right { display:flex; align-items:center; gap:10px; flex-shrink:0; }
    .pi-stock { font-size:11.5px; font-weight:600; padding:4px 10px; border-radius:20px; background:rgba(143,175,140,0.12); color:var(--deep-sage); border:1px solid rgba(143,175,140,0.22); white-space:nowrap; }
    .pi-price { font-family:'Nunito',sans-serif; font-size:14px; font-weight:700; color:var(--deep-sage); white-space:nowrap; }

    .empty { text-align:center; padding:40px 20px; color:var(--warm-gray); }
    .empty p { font-size:13px; margin-top:8px; }

    @media (max-width:1300px) { .metrics { grid-template-columns:repeat(3,1fr); } }
    @media (max-width:1100px) { .dash-grid { grid-template-columns:1fr; } }
    @media (max-width:768px)  { .metrics { grid-template-columns:repeat(2,1fr); } .hero { padding:28px 24px; flex-direction:column; gap:16px; align-items:flex-start; } }
</style>

<!-- Hero -->
<div class="hero">
    <div class="hero-left">
        <div class="hero-tag">Store Overview</div>
        <div class="hero-name">Welcome, <em>{{ app.user.email|split('@')[0] }}</em></div>
        <div class="hero-sub">{% if is_granted('ROLE_ADMIN') %}Full admin access · All data visible{% else %}Staff access · Limited permissions apply{% endif %}</div>
    </div>
    <div class="hero-right">
        <div class="hero-day">{{ "now"|date("d") }}</div>
        <div class="hero-date">{{ "now"|date("l, F Y") }}</div>
    </div>
</div>

<!-- Metrics -->
<div class="metrics">
    <a href="{{ path('app_product_index') }}" class="mc m1">
        <div class="mc-icon"><i data-lucide="shirt" style="width:18px;height:18px;stroke:var(--deep-mauve);stroke-width:1.75;"></i></div>
        <div class="mc-val">{{ totalProducts }}</div><div class="mc-lbl">Products</div>
    </a>
    <a href="{{ path('app_stock_index') }}" class="mc m2">
        <div class="mc-icon"><i data-lucide="package" style="width:18px;height:18px;stroke:var(--deep-sage);stroke-width:1.75;"></i></div>
        <div class="mc-val">{{ totalStocks }}</div><div class="mc-lbl">Stock Units</div>
    </a>
    <a href="{{ path('app_order_index') }}" class="mc m3">
        <div class="mc-icon"><i data-lucide="shopping-cart" style="width:18px;height:18px;stroke:#b8924a;stroke-width:1.75;"></i></div>
        <div class="mc-val">{{ totalOrders }}</div><div class="mc-lbl">Orders</div>
    </a>
    <a href="{{ path('app_customer_index') }}" class="mc m4">
        <div class="mc-icon"><i data-lucide="users" style="width:18px;height:18px;stroke:var(--deep-mauve);stroke-width:1.75;"></i></div>
        <div class="mc-val">{{ totalCustomers }}</div><div class="mc-lbl">Customers</div>
    </a>
    <a href="{{ path('app_payment_index') }}" class="mc m5">
        <div class="mc-icon"><i data-lucide="banknote" style="width:18px;height:18px;stroke:var(--deep-sage);stroke-width:1.75;"></i></div>
        <div class="mc-val">₱{{ totalRevenue|number_format(0) }}</div><div class="mc-lbl">Revenue</div>
    </a>
    <a href="{{ path('app_challenge_admin_list') }}" class="mc m6">
        <div class="mc-icon"><i data-lucide="trophy" style="width:18px;height:18px;stroke:#b8924a;stroke-width:1.75;"></i></div>
        <div class="mc-val">{{ activeChallenges }}</div><div class="mc-lbl">Challenges</div>
    </a>
</div>

<!-- Grid -->
<div class="dash-grid">
    <!-- Recent Orders -->
    <div class="panel">
        <div class="ph">
            <span class="pt">Recent Orders</span>
            <a href="{{ path('app_order_index') }}" class="pl">View all →</a>
        </div>
        <div class="order-list">
            {% if recentOrders is not empty %}
                {% for order in recentOrders %}
                <div class="oi">
                    <div class="oi-num">#{{ order.id }}</div>
                    <div class="oi-info">
                        <div class="oi-name">{{ order.customerName }}</div>
                        <div class="oi-date">{{ order.orderDate|date('M d, Y · H:i') }}</div>
                    </div>
                    <div class="oi-right">
                        <div class="oi-amt">₱{{ order.totalAmount|number_format(2) }}</div>
                        <span class="oi-badge s-{{ order.orderStatus|lower }}">{{ order.orderStatus }}</span>
                    </div>
                </div>
                {% endfor %}
            {% else %}
            <div class="empty">
                <i data-lucide="shopping-cart" style="width:32px;height:32px;stroke:var(--border);stroke-width:1.5;"></i>
                <p>No orders yet.</p>
            </div>
            {% endif %}
        </div>
    </div>

    <!-- Right -->
    <div style="display:flex;flex-direction:column;gap:20px;">
        <!-- Quick Actions -->
        <div class="panel">
            <div class="ph"><span class="pt">Quick Actions</span></div>
            <div class="qa-grid">
                <a href="{{ path('app_product_new') }}" class="qa">
                    <div class="qa-ic" style="background:rgba(196,160,160,0.15);"><i data-lucide="shirt" style="width:16px;height:16px;stroke:var(--deep-mauve);stroke-width:1.75;"></i></div>
                    <div class="qa-t">Add Product</div>
                    <div class="qa-d">New collection item</div>
                </a>
                <a href="{{ path('app_order_new') }}" class="qa">
                    <div class="qa-ic" style="background:rgba(201,169,110,0.12);"><i data-lucide="shopping-cart" style="width:16px;height:16px;stroke:#b8924a;stroke-width:1.75;"></i></div>
                    <div class="qa-t">New Order</div>
                    <div class="qa-d">Manual order entry</div>
                </a>
                <a href="{{ path('app_challenge_admin_create') }}" class="qa">
                    <div class="qa-ic" style="background:rgba(143,175,140,0.15);"><i data-lucide="trophy" style="width:16px;height:16px;stroke:var(--deep-sage);stroke-width:1.75;"></i></div>
                    <div class="qa-t">New Challenge</div>
                    <div class="qa-d">Launch a challenge</div>
                </a>
                <a href="{{ path('app_customer_new') }}" class="qa">
                    <div class="qa-ic" style="background:rgba(196,160,160,0.1);"><i data-lucide="user-plus" style="width:16px;height:16px;stroke:var(--deep-mauve);stroke-width:1.75;"></i></div>
                    <div class="qa-t">Add Customer</div>
                    <div class="qa-d">Register customer</div>
                </a>
            </div>
        </div>

        <!-- Top Products -->
        <div class="panel">
            <div class="ph">
                <span class="pt">Top Products</span>
                <a href="{{ path('app_product_index') }}" class="pl">View all →</a>
            </div>
            <div class="prod-list">
                {% if topProducts is not empty %}
                    {% for product in topProducts %}
                    <div class="pi">
                        <div class="pi-left">
                            <div class="pi-av">
                                {% if product.image %}
                                    <img src="{{ asset('uploads/' ~ product.image) }}" alt="{{ product.name }}">
                                {% else %}
                                    <i data-lucide="shirt" style="width:16px;height:16px;stroke:rgba(143,175,140,0.5);stroke-width:1.5;"></i>
                                {% endif %}
                            </div>
                            <span class="pi-name">{{ product.name }}</span>
                        </div>
                        <div class="pi-right">
                            <span class="pi-stock">{{ product.stock }} units</span>
                            <span class="pi-price">₱{{ product.price|number_format(2) }}</span>
                        </div>
                    </div>
                    {% endfor %}
                {% else %}
                <div class="empty">
                    <i data-lucide="shirt" style="width:32px;height:32px;stroke:var(--border);stroke-width:1.5;"></i>
                    <p>No products found.</p>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
