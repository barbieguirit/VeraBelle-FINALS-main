{% extends 'base_dashboard.html.twig' %}

{% block title %}Payments — VeraBelle Collection{% endblock %}
{% block page_title %}Payments{% endblock %}

{% block content %}
<style>
    :root {
        --blush:#F0C4C4; --sage:#A8BCA1; --sage-deep:#7A9972;
        --ink:#1A1F2E; --ink-soft:#4A5568; --cream:#FAF8F5;
        --cream-warm:#F4F0EA; --gold:#C9A96E; --white:#FFFFFF;
        --border:rgba(26,31,46,0.08); --shadow-sm:0 2px 12px rgba(26,31,46,0.06);
        --shadow-md:0 8px 32px rgba(26,31,46,0.10); --radius:16px; --radius-sm:10px;
    }
    * { font-family:'Figtree',sans-serif; box-sizing:border-box; }
    @keyframes fadeUp { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:translateY(0)} }

    .page-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; flex-wrap:wrap; gap:12px; animation:fadeUp 0.4s ease both; }
    .page-eyebrow { font-size:10px; letter-spacing:0.2em; text-transform:uppercase; color:var(--gold); font-weight:600; margin-bottom:4px; }
    .page-title { font-family:'Nunito',sans-serif; font-size:26px; font-weight:800; color:var(--ink); line-height:1; }
    .page-sub { font-size:13px; color:var(--ink-soft); margin-top:2px; }

    .btn-add { display:inline-flex; align-items:center; gap:8px; padding:11px 22px; background:var(--ink); color:#fff; border-radius:40px; text-decoration:none; font-size:13.5px; font-weight:600; transition:all 0.22s; box-shadow:0 4px 16px rgba(26,31,46,0.18); }
    .btn-add:hover { background:var(--ink-soft); transform:translateY(-2px); color:#fff; }
    .btn-add-icon { width:22px; height:22px; background:linear-gradient(135deg,var(--blush),var(--sage)); border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; }

    /* Stats */
    .stats-strip { display:grid; grid-template-columns:repeat(5,1fr); gap:14px; margin-bottom:24px; animation:fadeUp 0.4s 0.08s ease both; }
    .strip-card { background:var(--white); border-radius:var(--radius-sm); padding:18px; border:1px solid var(--border); display:flex; align-items:center; gap:12px; transition:all 0.2s; position:relative; overflow:hidden; }
    .strip-card::after { content:''; position:absolute; bottom:0; left:0; right:0; height:3px; opacity:0; transition:opacity 0.2s; }
    .strip-card:hover { box-shadow:var(--shadow-sm); transform:translateY(-2px); }
    .strip-card:hover::after { opacity:1; }
    .sc-total::after   { background:linear-gradient(90deg,var(--blush),#e8a8a8); }
    .sc-pending::after { background:linear-gradient(90deg,#f39c12,#e67e22); }
    .sc-failed::after  { background:linear-gradient(90deg,#e74c3c,#c0392b); }
    .sc-rev::after     { background:linear-gradient(90deg,var(--sage),var(--sage-deep)); }
    .sc-avg::after     { background:linear-gradient(90deg,#8BA8D4,#6b8fca); }
    .strip-icon { width:38px; height:38px; border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .si-blush { background:rgba(240,196,196,0.18); }
    .si-gold  { background:rgba(243,156,18,0.15); }
    .si-red   { background:rgba(231,76,60,0.10); }
    .si-sage  { background:rgba(168,188,161,0.18); }
    .si-blue  { background:rgba(139,168,212,0.18); }
    .strip-val { font-family:'Nunito',sans-serif; font-size:20px; font-weight:800; color:var(--ink); line-height:1; }
    .strip-lbl { font-size:11px; color:var(--ink-soft); margin-top:2px; }

    /* Flash */
    .flash-success { display:flex; align-items:center; gap:10px; padding:13px 18px; background:rgba(122,153,114,0.10); border:1px solid rgba(122,153,114,0.25); border-radius:var(--radius-sm); margin-bottom:20px; font-size:13px; font-weight:500; color:var(--sage-deep); }

    /* Grid section */
    .payments-section { background:var(--white); border-radius:var(--radius); border:1px solid var(--border); padding:24px; animation:fadeUp 0.4s 0.16s ease both; }
    .section-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; padding-bottom:16px; border-bottom:1px solid var(--border); }
    .section-title { font-family:'Nunito',sans-serif; font-size:15px; font-weight:800; color:var(--ink); }
    .section-count { background:var(--cream); border-radius:12px; padding:4px 12px; font-size:12px; font-weight:700; color:var(--ink-soft); }

    .payments-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(290px,1fr)); gap:18px; }

    /* Payment card */
    .payment-card { border:1px solid var(--border); border-radius:var(--radius-sm); background:var(--white); overflow:hidden; display:flex; flex-direction:column; transition:all 0.22s; }
    .payment-card:hover { transform:translateY(-4px); box-shadow:var(--shadow-md); border-color:rgba(240,196,196,0.3); }
    .card-top-bar { height:4px; background:linear-gradient(90deg,var(--blush),var(--sage)); }
    .card-top-bar.paid    { background:linear-gradient(90deg,var(--sage),var(--sage-deep)); }
    .card-top-bar.pending { background:linear-gradient(90deg,#f39c12,#e67e22); }
    .card-top-bar.failed  { background:linear-gradient(90deg,#e74c3c,#c0392b); }
    .card-top-bar.refunded { background:linear-gradient(90deg,#95a5a6,#7f8c8d); }

    .card-header { padding:16px 18px 12px; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:flex-start; gap:10px; }
    .ref-num { font-family:'Nunito',sans-serif; font-size:11px; font-weight:700; color:var(--ink-soft); margin-bottom:3px; letter-spacing:0.05em; }
    .order-ref { font-weight:700; color:var(--ink); font-size:14px; }

    .status-badge { display:inline-flex; align-items:center; padding:4px 10px; border-radius:20px; font-size:11px; font-weight:700; white-space:nowrap; }
    .status-paid     { background:rgba(122,153,114,0.12); color:var(--sage-deep); border:1px solid rgba(122,153,114,0.22); }
    .status-pending  { background:rgba(243,156,18,0.12); color:#d68910; border:1px solid rgba(243,156,18,0.25); }
    .status-failed   { background:rgba(231,76,60,0.08); color:#c0392b; border:1px solid rgba(231,76,60,0.18); }
    .status-refunded { background:rgba(149,165,166,0.12); color:#7f8c8d; border:1px solid rgba(149,165,166,0.22); }

    .card-body { padding:14px 18px; display:flex; flex-direction:column; gap:9px; flex:1; }
    .meta-row { display:flex; justify-content:space-between; align-items:center; font-size:12.5px; }
    .meta-label { color:var(--ink-soft); font-weight:500; }
    .meta-value { font-weight:600; color:var(--ink); font-size:13px; }
    .amount-value { font-family:'Nunito',sans-serif; font-size:16px; font-weight:800; color:var(--sage-deep); }
    .method-badge { display:inline-flex; align-items:center; gap:4px; padding:3px 9px; background:rgba(168,188,161,0.14); color:var(--sage-deep); border-radius:12px; font-size:11px; font-weight:700; border:1px solid rgba(168,188,161,0.25); }

    .card-actions { display:flex; gap:6px; padding:12px 18px 16px; border-top:1px solid var(--border); flex-wrap:wrap; }
    .btn-action { flex:1; min-width:60px; padding:8px 10px; border-radius:8px; font-size:12px; font-weight:600; cursor:pointer; transition:all 0.18s; text-decoration:none; display:inline-flex; align-items:center; justify-content:center; gap:4px; border:1px solid transparent; font-family:'Figtree',sans-serif; }
    .btn-view   { background:var(--cream); color:var(--ink-soft); border-color:var(--border); }
    .btn-view:hover   { background:var(--cream-warm); color:var(--ink); }
    .btn-verify { background:rgba(139,168,212,0.12); color:#4a7ab5; border-color:rgba(139,168,212,0.22); }
    .btn-verify:hover { background:#3498db; color:#fff; border-color:#3498db; }
    .btn-refund { background:rgba(231,76,60,0.07); color:#c0392b; border-color:rgba(231,76,60,0.18); }
    .btn-refund:hover { background:#e74c3c; color:#fff; border-color:#e74c3c; }

    .empty-state { grid-column:1/-1; display:flex; flex-direction:column; align-items:center; padding:80px 20px; text-align:center; gap:10px; }
    .empty-icon-wrap { width:64px; height:64px; background:var(--cream-warm); border-radius:20px; display:flex; align-items:center; justify-content:center; margin-bottom:4px; }
    .empty-state h3 { font-family:'Nunito',sans-serif; font-size:17px; font-weight:800; color:var(--ink); }
    .empty-state p { font-size:13px; color:var(--ink-soft); }

    @media (max-width:1200px) { .stats-strip { grid-template-columns:repeat(3,1fr); } }
    @media (max-width:768px)  { .stats-strip { grid-template-columns:repeat(2,1fr); } .payments-grid { grid-template-columns:1fr; } .page-header { flex-direction:column; align-items:flex-start; } }
</style>

<div class="page-header">
    <div>
        <div class="page-eyebrow">Finance</div>
        <div class="page-title">Payments</div>
        <div class="page-sub">Track and manage all payment transactions</div>
    </div>
    <a href="{{ path('app_payment_new') }}" class="btn-add">
        <span class="btn-add-icon"><i data-lucide="plus" style="width:13px;height:13px;stroke:white;stroke-width:2.5;"></i></span>
        Add Payment
    </a>
</div>

{% for message in app.flashes('success') %}
    <div class="flash-success">
        <i data-lucide="check-circle" style="width:16px;height:16px;stroke:var(--sage-deep);stroke-width:2;flex-shrink:0;"></i>
        {{ message }}
    </div>
{% endfor %}

<!-- Stats -->
<div class="stats-strip">
    <div class="strip-card sc-total">
        <div class="strip-icon si-blush"><i data-lucide="credit-card" style="width:18px;height:18px;stroke:#e8a8a8;stroke-width:1.75;"></i></div>
        <div><div class="strip-val">{{ stats.total }}</div><div class="strip-lbl">Total</div></div>
    </div>
    <div class="strip-card sc-pending">
        <div class="strip-icon si-gold"><i data-lucide="clock" style="width:18px;height:18px;stroke:#d68910;stroke-width:1.75;"></i></div>
        <div><div class="strip-val">{{ stats.pending }}</div><div class="strip-lbl">Pending</div></div>
    </div>
    <div class="strip-card sc-failed">
        <div class="strip-icon si-red"><i data-lucide="x-circle" style="width:18px;height:18px;stroke:#c0392b;stroke-width:1.75;"></i></div>
        <div><div class="strip-val">{{ stats.failed }}</div><div class="strip-lbl">Failed/Refunded</div></div>
    </div>
    <div class="strip-card sc-rev">
        <div class="strip-icon si-sage"><i data-lucide="banknote" style="width:18px;height:18px;stroke:var(--sage-deep);stroke-width:1.75;"></i></div>
        <div><div class="strip-val">₱{{ stats.revenue|number_format(0) }}</div><div class="strip-lbl">Revenue</div></div>
    </div>
    <div class="strip-card sc-avg">
        <div class="strip-icon si-blue"><i data-lucide="bar-chart-2" style="width:18px;height:18px;stroke:#6b8fca;stroke-width:1.75;"></i></div>
        <div><div class="strip-val">₱{{ stats.avg|number_format(0) }}</div><div class="strip-lbl">Avg Payment</div></div>
    </div>
</div>

<!-- Payments Grid -->
<div class="payments-section">
    <div class="section-header">
        <span class="section-title">All Payments</span>
        <span class="section-count">{{ payments|length }} records</span>
    </div>
    <div class="payments-grid">
        {% for payment in payments %}
        {% set statusClass = payment.status|lower %}
        <div class="payment-card">
            <div class="card-top-bar {{ statusClass }}"></div>
            <div class="card-header">
                <div>
                    <div class="ref-num">{{ payment.reference }}</div>
                    <div class="order-ref">Order #{{ payment.order.id }}</div>
                </div>
                <span class="status-badge status-{{ statusClass }}">{{ payment.status }}</span>
            </div>
            <div class="card-body">
                <div class="meta-row">
                    <span class="meta-label">Customer</span>
                    <span class="meta-value">{{ payment.customer.fullName }}</span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Method</span>
                    <span class="method-badge">
                        <i data-lucide="credit-card" style="width:10px;height:10px;stroke:currentColor;stroke-width:2;"></i>
                        {{ payment.method }}
                    </span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Date</span>
                    <span class="meta-value" style="font-size:12px;">{{ payment.date|date('M d, Y') }}</span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Amount</span>
                    <span class="amount-value">₱{{ payment.amount|number_format(2) }}</span>
                </div>
            </div>
            <div class="card-actions">
                <a href="{{ path('app_payment_show', {'id': payment.id}) }}" class="btn-action btn-view">
                    <i data-lucide="eye" style="width:12px;height:12px;stroke:currentColor;stroke-width:2;"></i> View
                </a>
                <a href="{{ path('app_payment_verify', {'id': payment.id}) }}" class="btn-action btn-verify">
                    <i data-lucide="check" style="width:12px;height:12px;stroke:currentColor;stroke-width:2;"></i> Verify
                </a>
                <a href="{{ path('app_payment_refund', {'id': payment.id}) }}" class="btn-action btn-refund">
                    <i data-lucide="rotate-ccw" style="width:12px;height:12px;stroke:currentColor;stroke-width:2;"></i> Refund
                </a>
            </div>
        </div>
        {% else %}
        <div class="empty-state">
            <div class="empty-icon-wrap"><i data-lucide="credit-card" style="width:28px;height:28px;stroke:var(--ink-soft);stroke-width:1.5;"></i></div>
            <h3>No Payments Found</h3>
            <p>Payment records will appear here once created.</p>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
