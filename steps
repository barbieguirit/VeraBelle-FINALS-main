 STEP 3 — Update security.yaml
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Under access_control: add these (at the TOP, before other rules):

    access_control:
        # Public landing pages
        - { path: ^/$,                     roles: PUBLIC_ACCESS }
        - { path: ^/about,                 roles: PUBLIC_ACCESS }
        - { path: ^/contact,               roles: PUBLIC_ACCESS }
        - { path: ^/login,                 roles: PUBLIC_ACCESS }
        - { path: ^/register,              roles: PUBLIC_ACCESS }

        # Email verification (must be public — user is not logged in yet)
        - { path: ^/verify-email,          roles: PUBLIC_ACCESS }

        # API public endpoints
        - { path: ^/api/login,             roles: PUBLIC_ACCESS }
        - { path: ^/api/register,          roles: PUBLIC_ACCESS }
        - { path: ^/api/verify-email,      roles: PUBLIC_ACCESS }

        # API protected (JWT required)
        - { path: ^/api/resend-verification,   roles: IS_AUTHENTICATED_FULLY }
        - { path: ^/api/verification-status,   roles: IS_AUTHENTICATED_FULLY }

        # Admin
        - { path: ^/admin,                 roles: ROLE_ADMIN }

        # Everything else requires login
        - { path: ^/,                      roles: ROLE_STAFF }

Under firewalls > main, add the success handler:
    firewalls:
        main:
            json_login:
                check_path: /api/login
                username_path: username
                password_path: password
                success_handler: App\Security\JWTAuthenticationSuccessHandler

